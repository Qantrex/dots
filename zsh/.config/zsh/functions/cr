# File: ~/.config/zsh/functions/cr
# Reopen the Claude sessions a shutdown, crash or closed terminal left open. Since 2026-11-19 every
# session is a thread of the main chat (`thread`, `agentic`), so this is a short way to call it:
#   cr           reopen all of them, each in its own tmux window of session "main"
#   cr <name>    reopen only those whose name contains <name>, e.g. `cr system-plan`
#   cr -l        list all threads with their state
#   cr --count   just the number left open (for the greeting)
# Sessions started outside the main chat (plain `claude`) are adopted as threads first.
cr() {
  emulate -L zsh
  case $1 in
    --count)
      thread list --json 2>/dev/null | jq '[.[] | select(.state == "left open")] | length' ;;
    -l)
      thread adopt >/dev/null 2>&1; thread list ;;
    "")
      thread adopt >/dev/null 2>&1; thread resume --open ;;
    *)
      thread adopt >/dev/null 2>&1
      local -a names=(${(f)"$(thread list --json | jq -r --arg f "$1" \
        '.[] | select(.state == "left open" and (.name | test($f; "i"))) | .name')"})
      (( ${#names} )) || { print "None left open matches \"$1\" (cr -l lists them)."; return 1 }
      local n; for n in $names; do thread resume $n; done ;;
  esac
}
