#!/usr/bin/env zsh

#
# Manage the dedicated NVIDIA GPU (RTX 3050, 4 GB) via envycontrol.
#
#   gpumode off     | integrated  AMD iGPU only. NVIDIA is blacklisted and
#                                 removed from the PCI bus. Best battery.
#   gpumode hybrid  | ai          AMD drives the display, NVIDIA is available
#                                 for CUDA (Ollama, image generation) and
#                                 powers itself down when idle (RTD3).
#   gpumode on      | nvidia      NVIDIA always on, modules in the initramfs.
#   gpumode status                configured vs. running state, dGPU power
#                                 state, initramfs size.
#
#   -f, --force    re-apply even if the mode is already configured
#   -r, --reboot   reboot when done without asking
#
# Initramfs contents per mode:
#
#   Only nvidia mode wants the NVIDIA modules in the initramfs (early KMS, no
#   console mode-flicker on boot). In the other two modes they are dead weight:
#   mkinitcpio pulls in ~109 MB of GSP firmware with them. Measured on this
#   machine that is the difference between a 142 MB and a 48 MB initramfs,
#   which systemd-boot reads and the kernel decompresses on every boot (0.220s
#   vs 0.041s of decompression alone). In hybrid mode the modules load later
#   from the root filesystem, which is fine because AMD drives the display.
#
#   The modules go into a mkinitcpio drop-in instead of MODULES= in
#   /etc/mkinitcpio.conf, so anything else listed there is left alone and
#   pacman's .pacnew merges never touch it. The drop-in must be in place
#   *before* envycontrol runs, because envycontrol rebuilds the initramfs
#   (mkinitcpio -P) as its last step.
#
#   envycontrol only logs a failed initramfs rebuild and still exits 0, so its
#   output is checked for the success message as well.
#

gpumode() {
  emulate -L zsh

  local mainconf=/etc/mkinitcpio.conf
  local dropin=/etc/mkinitcpio.conf.d/gpumode-nvidia.conf
  local -a nvidia_modules=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)

  local mode arg bad=0 force=0 reboot=0
  for arg in "$@"; do
    case $arg in
      off|integrated)  mode=integrated ;;
      hybrid|ai)       mode=hybrid ;;
      on|nvidia)       mode=nvidia ;;
      status)          mode=status ;;
      -f|--force)      force=1 ;;
      -r|--reboot)     reboot=1 ;;
      -h|--help|help)  mode=help ;;
      *)               print -u2 "gpumode: unknown argument '$arg'"; bad=1 ;;
    esac
  done

  if [[ -z $mode || $mode == help ]] || (( bad )); then
    print "GPU Management"
    print "Usage: gpumode [off|hybrid|on|status] [-f|--force] [-r|--reboot]"
    print -r -- "--------------------------------------------------------------"
    print "  off     - integrated AMD only, NVIDIA powered off (battery)"
    print "  hybrid  - AMD display + NVIDIA for CUDA/AI, sleeps when idle"
    print "  on      - NVIDIA always on, modules in initramfs"
    print "  status  - configured vs. running mode, dGPU power, initramfs"
    return $bad
  fi

  if (( ! $+commands[envycontrol] )); then
    print -u2 "gpumode: envycontrol is not installed."
    return 1
  fi

  local configured=$(envycontrol -q 2>/dev/null)

  # The dGPU's sysfs node: vendor NVIDIA, class display controller (0x03xxxx).
  # Absent when envycontrol's integrated-mode udev rule has removed it.
  local dev d
  for d in /sys/bus/pci/devices/*(N); do
    if [[ $(<$d/vendor) == 0x10de && $(<$d/class) == 0x03* ]]; then
      dev=$d
      break
    fi
  done

  # Does the running system match the configured mode? If not, a switch was
  # made without rebooting yet.
  local pending=0
  if [[ $configured == integrated ]]; then
    [[ -n $dev || -d /sys/module/nvidia ]] && pending=1
  else
    [[ -d /sys/module/nvidia ]] || pending=1
  fi

  if [[ $mode == status ]]; then
    print "Configured:  $configured"
    if (( pending )); then
      print "             -> reboot pending, the running system is not in this mode yet"
    fi
    # nvidia-smi is deliberately not called: it would wake a suspended dGPU.
    if [[ -n $dev ]]; then
      print "dGPU:        ${dev:t}, power $(<$dev/power/runtime_status)"
    else
      print "dGPU:        not on the PCI bus (powered off)"
    fi
    if [[ -d /sys/module/nvidia ]]; then
      print "Driver:      nvidia $(</sys/module/nvidia/version) loaded"
    else
      print "Driver:      not loaded"
    fi
    if [[ -e $dropin ]]; then
      print "Initramfs:   NVIDIA modules included (via ${dropin:t})"
    else
      print "Initramfs:   NVIDIA modules not included"
    fi
    # /boot is the ESP, mounted root-only, so sizes need sudo. Don't prompt.
    local sizes=$(sudo -n sh -c 'du -h /boot/initramfs-*.img' 2>/dev/null)
    if [[ -n $sizes ]]; then
      print -r -- "             ${sizes//$'\n'/$'\n'             }"
    else
      print "             (sizes need root: run 'sudo -v' first)"
    fi
    if grep -qE '^MODULES=.*\<nvidia' $mainconf 2>/dev/null; then
      print "Warning:     $mainconf still lists NVIDIA modules in MODULES=;"
      print "             the next switch moves them into ${dropin:t}."
    fi
    return 0
  fi

  if [[ $mode == $configured ]] && (( ! force )); then
    print "Already configured for $mode (use --force to re-apply)."
    (( pending )) && print "A reboot is still pending."
    return 0
  fi

  sudo -v || return 1
  print "Switching GPU mode: $configured -> $mode"

  # One-time migration: older versions of this function wrote the modules
  # straight into the main config's MODULES= line. Strip only those names.
  if grep -qE '^MODULES=.*\<nvidia' $mainconf; then
    sudo sed -i -E '/^MODULES=/{
      s/\<nvidia(_modeset|_uvm|_drm)?\>//g
      s/\( +/(/; s/ +\)/)/; s/  +/ /g
    }' $mainconf || return 1
    print "  moved NVIDIA modules out of $mainconf"
  fi

  if [[ $mode == nvidia ]]; then
    print -r -- "# Managed by gpumode (~/.config/zsh/functions/gpumode). Do not edit.
MODULES+=(${nvidia_modules[*]})" | sudo tee $dropin >/dev/null || return 1
    print "  NVIDIA modules added to the initramfs"
  elif [[ -e $dropin ]]; then
    sudo rm -f $dropin || return 1
    print "  NVIDIA modules removed from the initramfs"
  fi

  local -a cmd=(envycontrol -s $mode)
  [[ $mode == hybrid ]] && cmd+=(--rtd3)

  print "  running: ${cmd[*]} (rebuilds the initramfs, takes a moment)\n"
  local out rc
  out=$(setopt pipefail; sudo $cmd 2>&1 | tee /dev/stderr)
  rc=$?

  if (( rc )) || [[ $out == *ERROR* || $out != *"Successfully rebuilt the initramfs"* ]]; then
    print -u2 "\ngpumode: envycontrol or the initramfs rebuild FAILED. Do not reboot yet."
    print -u2 "  See why with:   sudo mkinitcpio -P"
    print -u2 "  Then re-apply:  gpumode $mode --force"
    return 1
  fi

  print "\nDone. A reboot is required for the change to take effect."
  [[ $mode == hybrid ]] && print "After rebooting, 'nvidia-smi' should list the RTX 3050."

  if (( reboot )); then
    systemctl reboot
  elif [[ -t 0 ]] && read -q "?Reboot now? [y/N] "; then
    print
    systemctl reboot
  else
    print
  fi
}
