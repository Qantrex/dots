# File: ~/.config/zsh/functions/claude
# Claude Code always starts in one place, whatever folder the shell is in, with
# all of ~ added as a working directory (through settings, see below). It can't start in ~ itself: Claude Code
# never saves trust for the home directory, so it would ask on every launch.
# The hub folder ~/.local/share/claude-hub is trusted once, and `claude --resume`
# lists every session in one place. Memory goes to one folder (autoMemoryDirectory
# in ~/.claude/settings.json). `claude-here` starts in the current folder instead.
# Scripts that call the binary (wh, llm-eval) are not affected.
claude() {
  local hub=~/.local/share/claude-hub
  mkdir -p "$hub"
  # Never empty: an empty start folder makes plugins treat every session as a new project.
  [[ -e $hub/README.md ]] || print "# Claude hub\n\nStart folder of plain \`claude\`; see ~/.config/zsh/functions/claude." > "$hub/README.md"
  # ~ through settings, not --add-dir: since Claude Code 2.1.327 --add-dir asks "Yes, add it" in every new
  # session; through settings it doesn't ask (same access, chosen 2026-11-19).
  ( cd "$hub" && command claude --settings "{\"permissions\":{\"additionalDirectories\":[\"$HOME\"]}}" "$@" )
}
