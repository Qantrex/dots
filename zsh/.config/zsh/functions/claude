# File: ~/.config/zsh/functions/claude
# Claude Code always starts in one place, whatever folder the shell is in, with
# all of ~ added as a working directory. It can't start in ~ itself: Claude Code
# never saves trust for the home directory, so it would ask on every launch.
# The hub folder ~/.local/share/claude-hub is trusted once, and `claude --resume`
# lists every session in one place. Memory goes to one folder (autoMemoryDirectory
# in ~/.claude/settings.json). `claude-here` starts in the current folder instead.
# Scripts that call the binary (wh, llm-eval) are not affected.
claude() {
  local hub=~/.local/share/claude-hub
  mkdir -p "$hub"
  ( cd "$hub" && command claude --add-dir ~ "$@" )
}
