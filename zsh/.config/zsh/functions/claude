# File: ~/.config/zsh/functions/claude
# Claude Code always starts in ~, whatever folder the shell is in: the global rules
# and the one memory folder load, and Claude reads an area's own CLAUDE.md when it
# works there. `claude --resume` then lists every session in one place.
# `claude-here` starts it in the current folder instead. Scripts that call the
# binary (wh, llm-eval) are not affected: this is an interactive-shell function.
claude() {
  ( cd ~ && command claude "$@" )
}
