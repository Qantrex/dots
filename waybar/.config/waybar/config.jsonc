{
  "layer": "top",
  "position": "top",
  "height": 40,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock",
    "mpris"
  ],
  "modules-right": [
    "memory",
    "network",
    "bluetooth",
    "pulseaudio",
    "battery",
    "custom/powerprofile",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },
  "clock": {
    "tooltip": true,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y\nTimezone: %Z}",
    "on-click": "gnome-calendar"
  },
  "mpris": {
    "player": "spotify",
    "format": "{player_icon} {status_icon} {title} - {artist}",
    "format-paused": "{player_icon} {status_icon} {title} - {artist}",
    "player-icons": {
      "spotify": ""
    },
    "status-icons": {
      "playing": "▶",
      "paused": "⏸"
    },
    "max-length": 50,
    "on-click": "playerctl -p spotify play-pause",
    "on-scroll-up": "playerctl -p spotify previous",
    "on-scroll-down": "playerctl -p spotify next",
    "escape": true
  },
  "memory": {
    "format": " {used:0.1f}G",
    "tooltip-format": "RAM Used: {used:0.1f}GB\nRAM Total: {total:0.1f}GB",
    "on-click": "foot -e btop"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-disconnected": " Disconnected",
    "tooltip-format-wifi": "{ifname} ({signalStrength}%) via {gwaddr} ",
    "on-click": "foot -e nmtui"
  },
  "bluetooth": {
    "format": " {status}",
    "format-on": " On",
    "format-off": " Off",
    "format-connected": " {device_alias}",
    "format-disabled": " Off",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth",
    "tooltip-format-connected": "{device_alias} ({device_address})\nBattery: {device_battery_percentage}%"
  },
  "battery": {
    "states": {
      "good": 90,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} ({wattage}W)",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "default": [
        " ",
        " ",
        " "
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "scroll-step": 5
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "custom/powerprofile": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/scripts/powerprofile.sh status",
    "interval": 30,
    "signal": 8,
    "tooltip": true,
    "on-click": "~/.config/scripts/powerprofile.sh toggle",
    "on-scroll-up": "~/.config/scripts/powerprofile.sh cycle",
    "on-scroll-down": "~/.config/scripts/powerprofile.sh cycle"
  }
}
