// This is your Waybar configuration file.
// It is written in JSON with support for comments, which is a feature of JSONC (JSON with comments).

{
  "layer": "top", // Display on top of other windows
  "position": "top",
  "height": 34,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "battery",
    "pulseaudio",
    "bluetooth",
    "custom/power-mode",
    "tray"
  ],

  // Left-click functions for the modules on the bar
  "hyprland/workspaces": {
    "format": "<span>{name}</span>",
    "on-click": "hyprctl dispatch workspace {name}"
  },

  "clock": {
    "format": "{:L%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    	"calendar": {
    		"mode"          : "year",
    		"mode-mon-col"  : 3,
    		"weeks-pos"     : "right",
    		"on-scroll"     : 1,
    		"on-click-right": "mode",
    		"format": {
    			"months":     "<span color='#ffead3'><b>{}</b></span>",
    			"days":       "<span color='#ecc6d9'><b>{}</b></span>",
    			"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
    			"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
    			"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
    					}
    				},
    "on-click": "foot -e timr"
  },
  
  "cpu": {
    "format": "CPU: {usage}%",
    "tooltip": false,
    "on-click": "foot -e btop",
  },
  
  "memory": {
    "format": "RAM: {}%",
    "tooltip": "",
    "on-click": "foot -e btop"
  },
  
  "temperature": {
    "format": "Temp: {temperatureC}°C",
    "tooltip": false,
    "on-click": "foot -e btop"
  },

  "battery": {
    "states": {
      "good": 90,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time}",
    "format-icons": [" ", " ", " ", " ", " "]
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  {volume}%",
    "format-icons": {
      "default": ["", " ", " "]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "bluetooth": {
    "format": " {status}",
    "on-click": "blueman-manager"
  },

  // This is the new, more robust custom module for power profiles.
  // It uses a shell script to handle the state.
  "custom/power-mode": {
    "exec": "powerprofilesctl get",
    "format": "  {}",
    "tooltip": true,
    "on-click": "bash -c \"current_profile=$(powerprofilesctl get); if [[ \\\"$current_profile\\\" == \\\"balanced\\\" ]]; then powerprofilesctl set performance; elif [[ \\\"$current_profile\\\" == \\\"performance\\\" ]]; then powerprofilesctl set power-saver; else powerprofilesctl set balanced; fi\"",
    "on-click-right": "gnome-control-center power"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
