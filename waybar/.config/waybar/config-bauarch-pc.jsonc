// Desktop (bauarch-pc): the shared config.jsonc, with only these keys changed.
// Keys here win over the included file (waybar: "the first defined value takes precedence").
// Started by hypr/lua/apps.lua (barStart) because this file exists for this hostname.
{
  "include": ["~/.config/waybar/config.jsonc"],
  // Laptop-only, hidden here (owner, 2026-11-04): custom/ai (Open WebUI button; the PC is the AI node instead),
  // battery, custom/touchpad and custom/powerprofile (asusctl).
  "modules-right": [
    "memory",
    "network",
    "bluetooth",
    "pulseaudio",
    "custom/vault",
    "tray"
  ]
}
