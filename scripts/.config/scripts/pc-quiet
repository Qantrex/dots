#!/usr/bin/env bash
# Quiet mode for the desktop (bauarch-pc) while nobody sits at it but the AI
# node keeps working (an overnight code session, agent jobs).
#
#   pc-quiet on       CPU: no boost, EPP=power. GPU: power limit at its minimum.
#   pc-quiet off      back to the defaults (boost on, EPP=balance_performance,
#                     GPU default power limit)
#   pc-quiet status   show the current values
#
# Runs as root. setup-pc-quiet.sh installs a root-owned copy in
# /usr/local/sbin and a sudoers line, so `away` can call `sudo -n pc-quiet on`
# without a password. Never point sudoers at this copy in the home directory:
# it is writable by the user.
#
# Why these knobs: less heat means the BIOS fan curve (CPU and case fans) and
# the GPU's own fan curve stay low. Token generation is memory-bound, so a
# 125 W GPU cap costs little speed; prompt processing gets somewhat slower.
# Nothing here survives a reboot, so the PC always boots into normal mode.

set -euo pipefail

readonly CPUFREQ=/sys/devices/system/cpu/cpufreq

die() { echo "pc-quiet: $*" >&2; exit 1; }

set_epp() {
    local f
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [[ -w $f ]] && echo "$1" >"$f"
    done
    return 0
}

set_boost() { [[ -w $CPUFREQ/boost ]] && echo "$1" >"$CPUFREQ/boost"; return 0; }

gpu_limit() {
    command -v nvidia-smi >/dev/null || return 0
    local w
    w=$(nvidia-smi --query-gpu="power.${1}_limit" --format=csv,noheader,nounits 2>/dev/null | head -1)
    [[ -n $w ]] && nvidia-smi -pl "${w%.*}" >/dev/null
    return 0
}

status() {
    printf '%-10s %s\n' \
        'CPU EPP'   "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo ?)" \
        'CPU boost' "$(cat $CPUFREQ/boost 2>/dev/null || echo ?)"
    command -v nvidia-smi >/dev/null &&
        printf '%-10s %s\n' 'GPU' "$(nvidia-smi --query-gpu=power.limit,power.draw,temperature.gpu,fan.speed --format=csv,noheader 2>/dev/null)"
    return 0
}

case ${1:-status} in
    on)
        [[ $EUID -eq 0 ]] || die "must run as root"
        set_boost 0; set_epp power; gpu_limit min
        ;;
    off)
        [[ $EUID -eq 0 ]] || die "must run as root"
        set_boost 1; set_epp balance_performance; gpu_limit default
        ;;
    status) status ;;
    *) echo "usage: ${0##*/} on|off|status" >&2; exit 2 ;;
esac
