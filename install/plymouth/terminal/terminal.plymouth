[Plymouth Theme]
Name=terminal
Description=Boot log on black: every unit systemd starts scrolls by as a "[  ok  ]" line in Iosevka Term, with a progress bar and a blinking cursor.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/terminal
ScriptFile=/usr/share/plymouth/themes/terminal/terminal.script
# The mkinitcpio hook copies these into the initramfs as Plymouth.ttf and
# Plymouth-monospace(-bold).ttf. Package: ttf-iosevkaterm-nerd.
Font=IosevkaTerm Nerd Font Mono
MonospaceFont=IosevkaTerm Nerd Font Mono
