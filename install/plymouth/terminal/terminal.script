// terminal.script -- plymouth "script" theme: a boot log on pure black.
//
// systemd tells plymouth about every unit it activates; each one becomes a
// "[  ok  ] started NetworkManager.service" line, so the log is real, not
// decoration. A progress bar sits at the bottom, a cursor blinks under the log.
//
// Installed by ~/.config/scripts/setup-boot-style.sh, which also puts in the
// hostname and sets DeviceScale=1: this plugin draws text at scale 1 and would
// pixel-double it on a HiDPI panel, so it gets native pixels instead and sizes
// the font from the screen height.
//
// ASCII only: plymouthd runs in the C locale in the initramfs, where the label
// plugin cannot decode multi-byte UTF-8.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();

DIGITS = "0123456789";
fun digits(n) {
    n = Math.Int(n);
    if (n <= 0) return "0";
    s = "";
    while (n > 0) {
        d = n - Math.Int(n / 10) * 10;
        s = DIGITS.CharAt(d) + s;
        n = Math.Int(n / 10);
    }
    return s;
}

// ~48 rows: 22 pt on 2880x1800, 18 pt on 2560x1440.
PT = Math.Int(H / 80);
if (PT < 12) PT = 12;
FONT = "Mono " + digits(PT);

fun text(str, r, g, b) {
    return Image.Text(str, r, g, b, 1, FONT);
}

fun repeat(ch, count) {
    s = "";
    for (i = 0; i < count; i++) s = s + ch;
    return s;
}

fun ends(s, suffix) {
    ls = s.Length();
    lf = suffix.Length();
    if (ls < lf) return 0;
    return s.SubString(ls - lf, ls) == suffix;
}

fun contains(s, ch) {
    for (i = 0; i < s.Length(); i++)
        if (s.CharAt(i) == ch) return 1;
    return 0;
}

// Colours: the desktop's greys, Rose Pine love/gold only for trouble.
WHITE_R = 0.88; WHITE_G = 0.88; WHITE_B = 0.88;
GREY = 0.55;
DIM = 0.30;

probe = text("M", 1, 1, 1);
CW = probe.GetWidth();
CH = probe.GetHeight();

X0 = CW * 4;
Y0 = CH * 2;
TEXT_X = X0 + CW * 9;             // after "[  ok  ] "
LOG_Y0 = Y0 + CH * 3;             // header, rule, blank line
BAR_Y = H - CH * 3;
ROWS = Math.Int((BAR_Y - CH * 2 - LOG_Y0) / CH);   // keeps a row for the cursor

// ------------------------------------------------------------------ header

mode = Plymouth.GetMode();
title = "Arch Linux @HOST@ (tty1)";
if (mode == "shutdown") title = title + "  -  shutting down";
else if (mode == "reboot") title = title + "  -  rebooting";
else if (mode == "updates" || mode == "system-upgrade") title = title + "  -  installing updates";

header = Sprite(text(title, GREY, GREY, GREY));
header.SetPosition(X0, Y0, 1);

rule = Sprite(text(repeat("-", Math.Int((W - X0 * 2) / CW)), DIM, DIM, DIM));
rule.SetPosition(X0, Y0 + CH, 1);

OK_IMG   = text("[  ok  ]", WHITE_R, WHITE_G, WHITE_B);
INFO_IMG = text("[ info ]", 0.96, 0.76, 0.47);

// --------------------------------------------------------------------- log

n = 0;
cursor = Sprite(text("_", WHITE_R, WHITE_G, WHITE_B));
cursor.SetPosition(X0, LOG_Y0, 2);

fun place_cursor() {
    if (global.pw_visible)
        global.cursor.SetPosition(X0 + global.pw_width, LOG_Y0 + global.n * CH, 2);
    else
        global.cursor.SetPosition(X0, LOG_Y0 + global.n * CH, 2);
}

fun add_line(prefix_img, body_img) {
    if (global.n < ROWS) {
        idx = global.n;
        global.n = global.n + 1;
        global.pre_spr[idx] = Sprite();
        global.pre_spr[idx].SetPosition(X0, LOG_Y0 + idx * CH, 1);
        global.txt_spr[idx] = Sprite();
        global.txt_spr[idx].SetPosition(TEXT_X, LOG_Y0 + idx * CH, 1);
    } else {
        // Full: scroll up one row, reusing the rendered images.
        for (i = 0; i < ROWS - 1; i++) {
            global.pre_img[i] = global.pre_img[i + 1];
            global.txt_img[i] = global.txt_img[i + 1];
            global.pre_spr[i].SetImage(global.pre_img[i]);
            global.txt_spr[i].SetImage(global.txt_img[i]);
        }
        idx = ROWS - 1;
    }
    global.pre_img[idx] = prefix_img;
    global.txt_img[idx] = body_img;
    global.pre_spr[idx].SetImage(prefix_img);
    global.txt_spr[idx].SetImage(body_img);
    place_cursor();
}

fun on_status(status) {
    if (contains(status, ":")) {
        // fsck progress and similar ("fsckd:..."), not a unit name.
        add_line(INFO_IMG, text(status, GREY, GREY, GREY));
        return;
    }
    verb = "started  ";
    if (ends(status, ".target"))      verb = "reached  ";
    else if (ends(status, ".mount"))  verb = "mounted  ";
    else if (ends(status, ".socket")) verb = "listening";
    else if (ends(status, ".device")) verb = "found    ";
    else if (ends(status, ".swap"))   verb = "swap on  ";
    else if (ends(status, ".path"))   verb = "watching ";
    else if (ends(status, ".timer"))  verb = "scheduled";
    else if (ends(status, ".slice"))  verb = "created  ";
    add_line(OK_IMG, text(verb + " " + status, GREY, GREY, GREY));
}
Plymouth.SetUpdateStatusFunction(on_status);

fun on_message(msg) {
    add_line(INFO_IMG, text(msg, WHITE_R, WHITE_G, WHITE_B));
}
Plymouth.SetDisplayMessageFunction(on_message);

// ----------------------------------------------------------- progress bar

BAR_CELLS = 48;
last_pct = -1;
bar = Sprite();
bar.SetPosition(X0, BAR_Y, 1);

fun on_progress(duration, progress) {
    pct = Math.Int(progress * 100);
    if (pct > 100) pct = 100;
    if (pct == global.last_pct) return;
    global.last_pct = pct;
    filled = Math.Int(progress * BAR_CELLS);
    if (filled > BAR_CELLS) filled = BAR_CELLS;
    s = "boot [" + repeat("#", filled) + repeat(".", BAR_CELLS - filled) + "] " + digits(pct) + "%";
    global.bar.SetImage(text(s, DIM, DIM, DIM));
}
Plymouth.SetBootProgressFunction(on_progress);

// ------------------------------------------------- password / questions
// Only used if a disk is ever encrypted; shows "Password: ****" inline.

pw_visible = 0;
pw_width = 0;
pw = Sprite();
pw.SetPosition(X0, LOG_Y0, 3);

fun show_prompt(line) {
    img = text(line, WHITE_R, WHITE_G, WHITE_B);
    global.pw.SetImage(img);
    global.pw.SetPosition(X0, LOG_Y0 + global.n * CH, 3);
    global.pw.SetOpacity(1);
    global.pw_visible = 1;
    global.pw_width = img.GetWidth() + CW;
    place_cursor();
}

fun on_password(prompt, bullets) {
    if (prompt == "") prompt = "Password";
    show_prompt(prompt + ": " + repeat("*", bullets));
}
Plymouth.SetDisplayPasswordFunction(on_password);

fun on_question(prompt, entry) {
    show_prompt(prompt + " " + entry);
}
Plymouth.SetDisplayQuestionFunction(on_question);

fun on_normal() {
    global.pw.SetOpacity(0);
    global.pw_visible = 0;
    place_cursor();
}
Plymouth.SetDisplayNormalFunction(on_normal);

// ------------------------------------------------------------- cursor blink

frame = 0;
fun on_refresh() {
    global.frame = global.frame + 1;
    // ~50 refreshes a second: on for 0.5 s, off for 0.5 s.
    phase = global.frame - Math.Int(global.frame / 50) * 50;
    if (phase < 25) global.cursor.SetOpacity(1);
    else global.cursor.SetOpacity(0);
}
Plymouth.SetRefreshFunction(on_refresh);
