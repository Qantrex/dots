# zathura -- PDF viewer. Font, colours and page recolouring come from the theme
# (./theme links to ~/dotfiles/theme/current/zathurarc); Ctrl+R toggles
# back to paper.
include theme
set selection-clipboard     clipboard
set adjust-open             "best-fit"
set scroll-page-aware       true
set statusbar-h-padding     12
set statusbar-v-padding     4
set guioptions              "s"
