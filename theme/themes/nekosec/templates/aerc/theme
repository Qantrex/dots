# aerc styleset of the {{ theme }} theme. GENERATED by `theme` from
# ~/dotfiles/theme/themes/nekosec/templates/aerc/theme.
# Hot pink for what is selected and unread, lavender for headers and folders, mint
# for new mail counts and good signatures, love for errors and deletes.

*.default = true
*.normal = true

title.fg = {{ bg }}
title.bg = {{ accent }}
title.bold = true
header.fg = {{ lilac }}
header.bold = true

tab.fg = {{ tone(0x88) }}
tab.bg = {{ bg }}
tab.selected.fg = {{ bg }}
tab.selected.bg = {{ accent }}
tab.selected.bold = true

border.fg = {{ lilac.mix(bg, 0.55) }}
border.bg = {{ bg }}

statusline_default.fg = {{ fg }}
statusline_default.bg = {{ lilac.mix(bg, 0.7) }}
statusline_error.fg = {{ love }}
statusline_error.bold = true
statusline_success.fg = {{ mint }}
statusline_warning.fg = {{ gold }}

dirlist_default.fg = {{ tone(0xb0) }}
dirlist_unread.fg = {{ mint }}
dirlist_unread.bold = true
dirlist_recent.fg = {{ lilac }}
dirlist*.selected.fg = {{ bg }}
dirlist*.selected.bg = {{ accent }}
dirlist*.selected.bold = true

msglist_default.fg = {{ tone(0xa8) }}
msglist_unread.fg = {{ fg }}
msglist_unread.bold = true
msglist_read.fg = {{ tone(0x90) }}
msglist_flagged.fg = {{ gold }}
msglist_marked.fg = {{ mint }}
msglist_marked.bold = true
msglist_deleted.fg = {{ love }}
msglist_deleted.dim = true
msglist_result.fg = {{ accent }}
msglist_result.underline = true
msglist_thread_folded.fg = {{ lilac }}
msglist_answered.fg = {{ lilac }}
msglist_*.selected.fg = {{ bg }}
msglist_*.selected.bg = {{ accent }}
msglist_*.selected.bold = true

part_mimetype.fg = {{ lilac }}
part_mimetype.dim = true
part_*.selected.fg = {{ bg }}
part_*.selected.bg = {{ accent }}
part_filename.selected.bold = true

completion_default.fg = {{ fg }}
completion_default.bg = {{ lilac.mix(bg, 0.75) }}
completion_description.fg = {{ tone(0x90) }}
completion_description.dim = true
completion_gutter.bg = {{ bg }}
completion_pill.bg = {{ accent }}
completion_default.selected.fg = {{ bg }}
completion_default.selected.bg = {{ accent }}

selector_default.fg = {{ fg }}
selector_focused.fg = {{ bg }}
selector_focused.bg = {{ accent }}
selector_chooser.fg = {{ mint }}
selector_chooser.bold = true

spinner.fg = {{ accent }}
*error.fg = {{ love }}
*error.bold = true
*warning.fg = {{ gold }}
*success.fg = {{ mint }}

[viewer]
*.default = true
*.normal = true
url.fg = {{ lilac }}
url.underline = true
header.fg = {{ accent }}
header.bold = true
signature.fg = {{ tone(0x80) }}
signature.dim = true
diff_meta.bold = true
diff_chunk*.fg = {{ lilac }}
diff_add.fg = {{ mint }}
diff_del.fg = {{ love }}
diff_whitespace.bg = {{ love }}
quote_1.fg = {{ lilac }}
quote_2.fg = {{ accent.mix(fg, 0.3) }}
quote_*.fg = {{ tone(0x88) }}
quote_*.dim = true
code.fg = {{ mint }}
