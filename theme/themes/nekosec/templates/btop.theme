# nekosec: this theme's own copy of templates/btop.theme, only colours differ.
# btop.theme of the {{ theme }} theme. GENERATED by `theme` from
# ~/dotfiles/theme/themes/nekosec/templates/btop.theme; edit that and run `theme apply`.
# btop: nekosec gradients, lavender -> pink -> mint; temperatures run mint -> gold -> love.
theme[main_bg]="{{ bg }}"
theme[main_fg]="{{ tone(0xd0) }}"
theme[title]="{{ mint }}"
theme[hi_fg]="{{ accent }}"
theme[selected_bg]="{{ accent.mix(bg, 0.65) }}"
theme[selected_fg]="{{ fg }}"
theme[inactive_fg]="{{ tone(0x4a) }}"
theme[graph_text]="{{ tone(0x88) }}"
theme[meter_bg]="{{ tone(0x26) }}"
theme[proc_misc]="{{ tone(0xa0) }}"
theme[cpu_box]="{{ accent.mix(bg, 0.45) }}"
theme[mem_box]="{{ mint.mix(bg, 0.5) }}"
theme[net_box]="{{ lilac.mix(bg, 0.45) }}"
theme[proc_box]="{{ rose.mix(bg, 0.5) }}"
theme[div_line]="{{ tone(0x26) }}"
theme[temp_start]="{{ mint }}"
theme[temp_mid]="{{ gold }}"
theme[temp_end]="{{ love }}"
theme[cpu_start]="{{ lilac }}"
theme[cpu_mid]="{{ accent }}"
theme[cpu_end]="{{ mint }}"
theme[free_start]="{{ lilac.mix(bg,0.5) }}"
theme[free_mid]="{{ lilac }}"
theme[free_end]="{{ iris }}"
theme[cached_start]="{{ lilac.mix(bg,0.4) }}"
theme[cached_mid]="{{ iris }}"
theme[cached_end]="{{ rose }}"
theme[available_start]="{{ mint.mix(bg,0.5) }}"
theme[available_mid]="{{ mint }}"
theme[available_end]="{{ fg }}"
theme[used_start]="{{ lilac }}"
theme[used_mid]="{{ accent }}"
theme[used_end]="{{ rose }}"
theme[download_start]="{{ lilac }}"
theme[download_mid]="{{ mint }}"
theme[download_end]="{{ fg }}"
theme[upload_start]="{{ lilac }}"
theme[upload_mid]="{{ accent }}"
theme[upload_end]="{{ fg }}"
theme[process_start]="{{ lilac }}"
theme[process_mid]="{{ accent }}"
theme[process_end]="{{ mint }}"
