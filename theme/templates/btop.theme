# btop.theme of the {{ theme }} theme. GENERATED by `theme` from
# ~/dotfiles/theme/templates/btop.theme; edit that and run `theme apply`.
# btop: true-black monochrome. Greys and white; Rose Pine love only for the
# "hot" end of meters, so a maxed core still stands out.
theme[main_bg]="{{ bg }}"
theme[main_fg]="{{ tone(0xd0) }}"
theme[title]="{{ fg }}"
theme[hi_fg]="{{ fg }}"
theme[selected_bg]="{{ tone(0x26) }}"
theme[selected_fg]="{{ fg }}"
theme[inactive_fg]="{{ tone(0x4a) }}"
theme[graph_text]="{{ tone(0x88) }}"
theme[meter_bg]="{{ tone(0x26) }}"
theme[proc_misc]="{{ tone(0xa0) }}"
theme[cpu_box]="{{ tone(0x44) }}"
theme[mem_box]="{{ tone(0x44) }}"
theme[net_box]="{{ tone(0x44) }}"
theme[proc_box]="{{ tone(0x44) }}"
theme[div_line]="{{ tone(0x26) }}"
theme[temp_start]="{{ tone(0x55) }}"
theme[temp_mid]="{{ tone(0xa0) }}"
theme[temp_end]="{{ love }}"
theme[cpu_start]="{{ tone(0x55) }}"
theme[cpu_mid]="{{ tone(0xa0) }}"
theme[cpu_end]="{{ fg }}"
theme[free_start]="{{ tone(0x33) }}"
theme[free_mid]="{{ tone(0x66) }}"
theme[free_end]="{{ tone(0x99) }}"
theme[cached_start]="{{ tone(0x44) }}"
theme[cached_mid]="{{ tone(0x77) }}"
theme[cached_end]="{{ tone(0xaa) }}"
theme[available_start]="{{ tone(0x44) }}"
theme[available_mid]="{{ tone(0x88) }}"
theme[available_end]="{{ tone(0xcc) }}"
theme[used_start]="{{ tone(0x55) }}"
theme[used_mid]="{{ tone(0xa0) }}"
theme[used_end]="{{ fg }}"
theme[download_start]="{{ tone(0x44) }}"
theme[download_mid]="{{ tone(0x88) }}"
theme[download_end]="{{ fg }}"
theme[upload_start]="{{ tone(0x44) }}"
theme[upload_mid]="{{ tone(0x88) }}"
theme[upload_end]="{{ tone(0xd0) }}"
theme[process_start]="{{ tone(0x55) }}"
theme[process_mid]="{{ tone(0xa0) }}"
theme[process_end]="{{ fg }}"
