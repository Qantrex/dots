# zathurarc of the {{ theme }} theme. GENERATED by `theme` from
# ~/dotfiles/theme/templates/zathurarc; edit that and run `theme apply`.
# Included by ~/.config/zathura/zathurarc. Dark themes recolour pages (light text
# on the theme's background, keeping hue off); Ctrl+R toggles back to paper.
set font                    "{{ font.mono }} 11"
set recolor                 {{ lua(dark) }}
set recolor-keephue         false
set recolor-darkcolor       "{{ tone(0xe0) }}"
set recolor-lightcolor      "{{ bg }}"
set default-bg              "{{ bg }}"
set default-fg              "{{ tone(0xd0) }}"
set statusbar-bg            "{{ bg }}"
set statusbar-fg            "{{ tone(0x88) }}"
set inputbar-bg             "{{ bg }}"
set inputbar-fg             "{{ fg }}"
set notification-bg         "{{ bg }}"
set notification-fg         "{{ tone(0xd0) }}"
set notification-error-bg   "{{ bg }}"
set notification-error-fg   "{{ love }}"
set notification-warning-bg "{{ bg }}"
set notification-warning-fg "{{ gold }}"
set highlight-color         "rgba({{ gold.csv }},0.35)"
set highlight-active-color  "rgba({{ fg.csv }},0.45)"
set completion-bg           "{{ bg }}"
set completion-fg           "{{ tone(0xa0) }}"
set completion-highlight-bg "{{ accent }}"
set completion-highlight-fg "{{ on_accent }}"
set completion-group-bg     "{{ bg }}"
set completion-group-fg     "{{ tone(0x55) }}"
set index-bg                "{{ bg }}"
set index-fg                "{{ tone(0xd0) }}"
set index-active-bg         "{{ accent }}"
set index-active-fg         "{{ on_accent }}"
