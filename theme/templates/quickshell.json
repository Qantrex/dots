{
  "_": "Quickshell values of the {{ theme }} theme. GENERATED by `theme` from ~/dotfiles/theme/templates/quickshell.json. Read by services/Theme.qml, which derives the translucent surfaces from bg and fg.",
  "bg": "{{ bg }}",
  "fg": "{{ fg }}",
  "fgMuted": "{{ tone(0xb3) }}",
  "fgDim": "{{ tone(0x80) }}",
  "fgFaint": "{{ tone(0x4d) }}",
  "accent": "{{ accent }}",
  "inverse": "{{ on_accent }}",
  "inverseMuted": "{{ mix(on_accent, accent, 0x59/255) }}",
  "fillHover": "{{ mix(on_accent, accent, 0xd9/255) }}",
  "love": "{{ love }}",
  "gold": "{{ gold }}",
  "iris": "{{ iris }}",
  "font": "{{ font.shell }}",
  "fontSize": {{ font.shell_size }},
  "fontSmall": {{ font.shell_small }},
  "fontLarge": {{ font.shell_large }},
  "iconSize": {{ font.shell_icon }},
  "barHeight": {{ look.bar_height }},
  "gap": {{ look.bar_gap }},
  "radius": {{ look.radius }},
  "radiusSmall": {{ look.radius_small }},
  "pad": {{ look.pad }},
  "wallpaper": "{{ asset.wallpaper }}"
}
