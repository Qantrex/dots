# micro.micro of the {{ theme }} theme. GENERATED by `theme` from
# ~/dotfiles/theme/templates/micro.micro; edit that and run `theme apply`.
# True-black monochrome; Rosé Pine Moon iris only for keywords.
# Background is left to the terminal (foot: {{ bg }}).
color-link default "{{ fg }}"
color-link comment "italic {{ tone(0x66) }}"

color-link identifier "{{ fg }}"
color-link identifier.class "bold {{ fg }}"
color-link identifier.var "{{ tone(0xdd) }}"

color-link constant "bold {{ fg }}"
color-link constant.number "{{ fg }}"
color-link constant.string "{{ tone(0xaa) }}"
color-link constant.string.url "underline {{ tone(0xaa) }}"
color-link constant.bool "bold {{ fg }}"

color-link symbol "{{ tone(0x88) }}"
color-link symbol.operator "{{ tone(0x88) }}"
color-link symbol.brackets "{{ tone(0x88) }}"
color-link symbol.tag "{{ iris }}"

color-link type "{{ tone(0xcc) }}"
color-link type.keyword "bold {{ iris }}"
color-link type.extended "default"

color-link statement "bold {{ iris }}"
color-link special "{{ iris }}"
color-link preproc "{{ iris }}"

color-link underlined "underline {{ fg }}"
color-link error "bold {{ love }}"
color-link todo "bold {{ gold }}"

color-link diff-added "{{ tone(0xcc) }}"
color-link diff-modified "{{ gold }}"
color-link diff-deleted "{{ love }}"

color-link gutter-error "{{ love }}"
color-link gutter-warning "{{ gold }}"

color-link statusline "{{ fg }},{{ tone(0x11) }}"
color-link tabbar "{{ fg }},{{ tone(0x11) }}"
color-link indent-char "{{ tone(0x33) }}"
color-link line-number "{{ tone(0x44) }}"
color-link current-line-number "{{ fg }}"
color-link divider "{{ tone(0x22) }},{{ tone(0x22) }}"
color-link cursor-line "{{ tone(0x0f) }}"
color-link color-column "{{ tone(0x11) }}"
color-link selection "{{ fg }},{{ tone(0x33) }}"
color-link scrollbar "{{ tone(0x44) }}"
