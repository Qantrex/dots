#!/usr/bin/env bash
# The always-running main Claude chat and everything around it.
#   agentic on [--login]   start it: tmux session "main", the chat in window 1 (named "main"), the side panel
#                          (hidden until SUPER+SHIFT+A). --login does nothing after `agentic off`.
#   agentic off            stop the main chat, its panel and every thread; keeps all data and transcripts.
#                          Stays off across logins until `agentic on`.
#   agentic status         what runs right now
#   agentic restart        fresh main chat (same as /exit inside it)
# The chat runs in ~/.local/share/agentic/main; its rules are that folder's CLAUDE.md. Threads: `thread`.
# Panel: `dock`. Map: `atlas`. Undo everything: `agentic off`, then revert the commits.

set -u
data="${XDG_DATA_HOME:-$HOME/.local/share}/agentic"
state="${XDG_STATE_HOME:-$HOME/.local/state}/agentic"
dir="$data/main"
off_flag="$state/off"
session=main
claude="$HOME/.local/bin/claude"

has_main_window() { tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | grep -qx main; }

ensure_session() {
    tmux has-session -t "=$session" 2>/dev/null && return
    # One-time move: the session terminals used so far was tmux's default "0".
    if tmux has-session -t "=0" 2>/dev/null; then
        tmux rename-session -t "=0" "$session"
    else
        tmux new-session -d -s "$session" -c "$HOME"
    fi
}

start_main() {
    mkdir -p "$dir" "$state"
    [[ -e $dir/README.md ]] || printf '# Main chat\n\nWorking folder of the always-running main Claude chat (`agentic`). Its rules: CLAUDE.md here.\n' > "$dir/README.md"
    # The chat restarts by itself after /exit or a crash; everything that matters is in files.
    local loop='while :; do
        env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_SESSION_ID \
            AGENTIC_ROLE=main "'"$claude"'" -n main --add-dir "$HOME" --autocompact 100000
        sleep 2
    done'
    local first
    first=$(tmux list-windows -t "$session" -F '#{window_index}' | sort -n | head -1)
    # Window 1 belongs to the main chat: insert it before whatever is there now; the others move up one.
    tmux new-window -d -b -t "$session:$first" -n main -c "$dir" "$loop"
    tmux set-option -w -t "$session:main" automatic-rename off
    tmux set-option -w -t "$session:main" allow-rename off
}

case ${1:-status} in
on)
    if [[ ${2:-} == --login && -e $off_flag ]]; then exit 0; fi
    rm -f "$off_flag"
    ensure_session
    has_main_window || start_main
    "$HOME/.local/bin/dock" ensure >/dev/null 2>&1 &
    (command -v atlas >/dev/null && atlas refresh >/dev/null 2>&1 &)
    echo "Main chat is on (tmux window $session:main; SUPER+SHIFT+A shows the panel)."
    ;;
off)
    mkdir -p "$state"; touch "$off_flag"
    "$HOME/.local/bin/dock" close >/dev/null 2>&1
    command -v thread >/dev/null && thread stop --all >/dev/null 2>&1
    if has_main_window; then
        tmux send-keys -t "$session:main" C-u '/exit' Enter 2>/dev/null
        sleep 2
        tmux kill-window -t "$session:main" 2>/dev/null
    fi
    echo "Main chat, panel and threads are off; data kept. 'agentic on' brings them back."
    ;;
restart)
    has_main_window && tmux send-keys -t "$session:main" C-u '/exit' Enter
    ;;
status)
    if [[ -e $off_flag ]]; then echo "off (agentic on to start)"; exit 0; fi
    if has_main_window; then
        echo "main chat: running in tmux $session:main ($(tmux display -p -t "$session:main" '#{pane_current_command}'))"
    else
        echo "main chat: not running (agentic on)"
    fi
    "$HOME/.local/bin/dock" status 2>/dev/null
    command -v thread >/dev/null && thread list 2>/dev/null; true
    ;;
*)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
