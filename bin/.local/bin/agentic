#!/usr/bin/env bash
# The always-running main Claude chat and everything around it.
#   agentic on [--login]   start it: tmux session "main", the chat in window 1 (named "main"), the side panel
#                          (hidden until SUPER+SHIFT+A). --login does nothing after `agentic off`.
#   agentic off            stop the main chat, its panel, the threads it started and the focus recorder; keeps
#                          all data and transcripts. Your own (adopted) sessions keep running.
#                          Stays off across logins until `agentic on`.
#   agentic status         what runs right now
#   agentic restart        fresh main chat (same as /exit inside it)
#   agentic brief [--print] what needs me (deadlines, left-open threads, failures, inbox, usage); at login
#   agentic doctor         check the setup; prints one line per problem, nothing when all is well
# The chat runs in ~/.local/share/agentic/main; its rules are that folder's CLAUDE.md. Threads: `thread`.
# Panel: `dock`. Map: `atlas`. Undo everything: `agentic off`, then revert the commits.

set -u
data="${XDG_DATA_HOME:-$HOME/.local/share}/agentic"
state="${XDG_STATE_HOME:-$HOME/.local/state}/agentic"
dir="$data/main"
off_flag="$state/off"
session=main
claude="$HOME/.local/bin/claude"

# Started from Hyprland at login there's no SSH_AUTH_SOCK (only shells set it): give it to tmux and the chat.
export SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket}

# The main chat's pane, by id: tmux names a plain shell window after its folder, so a shell opened in the
# main chat's folder is also called "main" and "$session:main" is ambiguous. Its own window has
# automatic-rename off.
main_pane() {
    tmux list-windows -t "=$session" -F '#{window_name} #{automatic-rename} #{pane_id}' 2>/dev/null |
        awk '$1 == "main" && $2 == "0" {print $3; exit}'
}

# The main chat's input line is empty (nothing typed, no question or dialog): only then type into it.
main_idle_prompt() {
    local screen line rest pane
    pane=$(main_pane); [[ -n $pane ]] || return 1
    screen=$(tmux capture-pane -p -t "$pane" 2>/dev/null) || return 1
    grep -qE '^\s*❯ [0-9]+\.|Enter to confirm|Esc to cancel' <<<"$(tail -15 <<<"$screen")" && return 1
    line=$(tmux capture-pane -p -e -t "$pane" | grep '❯' | tail -1)
    rest=${line#*❯}
    rest=$(sed -E $'s/\x1b\\[2m.*(\x1b\\[0m|\x1b\\[22m|$)//; s/\x1b\\[[0-9;]*[A-Za-z]//g; s/\xc2\xa0/ /g' <<<"$rest")
    [[ -z ${rest// /} ]]
}

has_main_window() { [[ -n $(main_pane) ]]; }

ensure_session() {
    tmux has-session -t "=$session" 2>/dev/null && return
    # One-time move: the session terminals used so far was tmux's default "0".
    if tmux has-session -t "=0" 2>/dev/null; then
        tmux rename-session -t "=0" "$session"
    else
        tmux new-session -d -s "$session" -c "$HOME"
    fi
}

start_main() {
    mkdir -p "$dir" "$state"
    [[ -e $dir/README.md ]] || printf '# Main chat\n\nWorking folder of the always-running main Claude chat (`agentic`). Its rules: CLAUDE.md here.\n' > "$dir/README.md"
    # The chat restarts by itself after /exit or a crash; everything that matters is in files.
    # ~ comes in through settings, not --add-dir: --add-dir asks for trust in every new session.
    # --remote-control: the same conversation continues in the Claude app on the phone.
    # --autocompact: Claude Code compacts about 32k below the flag (measured 2026-11-19: flag 100k fired at
    # 68k, 150k at 117-120k, 240k at 207-208k), so 182000 makes it compact at about 150k.
    local loop='while :; do
        env -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_SESSION_ID \
            AGENTIC_ROLE=main SSH_AUTH_SOCK="'"$SSH_AUTH_SOCK"'" "'"$claude"'" -n main-chat --model opus --effort high --autocompact 182000 --remote-control main-chat \
            --settings "{\"permissions\":{\"additionalDirectories\":[\"$HOME\"]}}"
        sleep 2
    done'
    local first
    first=$(tmux list-windows -t "$session" -F '#{window_index}' | sort -n | head -1)
    # Window 1 belongs to the main chat: insert it before whatever is there now; the others move up one.
    local pane
    pane=$(tmux new-window -d -b -P -F '#{pane_id}' -t "$session:$first" -n main -c "$dir" "$loop")
    tmux set-option -w -t "$pane" automatic-rename off
    tmux set-option -w -t "$pane" allow-rename off
}

case ${1:-status} in
on)
    if [[ ${2:-} == --login && -e $off_flag ]]; then exit 0; fi
    rm -f "$off_flag"
    ensure_session
    tmux set-environment -g SSH_AUTH_SOCK "$SSH_AUTH_SOCK"
    has_main_window || start_main
    "$HOME/.local/bin/dock" ensure >/dev/null 2>&1 &
    pgrep -f "$HOME/.local/bin/journal record" >/dev/null || setsid -f "$HOME/.local/bin/journal" record >/dev/null 2>&1
    if [[ ${2:-} == --login ]]; then
        (atlas refresh >/dev/null 2>&1; inbox collect >/dev/null 2>&1; "$0" brief) &
    else
        (atlas refresh >/dev/null 2>&1 &)
    fi
    echo "Main chat is on (tmux window $session:main; SUPER+SHIFT+A shows the panel)."
    ;;
off)
    mkdir -p "$state"; touch "$off_flag"
    "$HOME/.local/bin/dock" close >/dev/null 2>&1
    command -v thread >/dev/null && thread stop --all >/dev/null 2>&1   # not the adopted ones: those are mine
    pkill -f "$HOME/.local/bin/journal record" 2>/dev/null
    if has_main_window; then
        # Gracefully when nothing is typed; otherwise just close the window (nothing gets answered).
        pane=$(main_pane)
        main_idle_prompt && { tmux send-keys -t "$pane" '/exit' Enter; sleep 2; }
        tmux kill-window -t "$pane" 2>/dev/null
    fi
    echo "Main chat, panel, its threads and the focus recorder are off; data kept. 'agentic on' brings them back."
    echo "Still on: your own sessions, ssh-unlock at login (independent), failed services still queue to the inbox file."
    ;;
brief)
    # One notification with what needs me, from data (no AI): deadlines in 3 days, threads left open,
    # failed units, new inbox events, weekly Claude usage. Shown at login.
    lines=()
    dl=$(atlas deadlines 2>/dev/null | awk -F'|' 'NR > 3 && $2 ~ /(overdue|in [0-3] d)/ {gsub(/^ +| +$/, "", $3); gsub(/^ +| +$/, "", $4); gsub(/^ +| +$/, "", $2); print $3 " " $4 " (" $2 ")"}' | head -4)
    [[ -n $dl ]] && lines+=("Due: ${dl//$'\n'/, }")
    left=$(thread list --json 2>/dev/null | jq '[.[] | select(.state == "left open")] | length')
    (( ${left:-0} > 0 )) && lines+=("$left thread(s) left open (cr)")
    failed=$( (systemctl --failed --no-legend --plain; systemctl --user --failed --no-legend --plain) 2>/dev/null | awk '{print $1}' | paste -sd, -)
    [[ -n $failed ]] && lines+=("Failed: $failed")
    new=$(inbox list 200 2>/dev/null | grep -c '(new)')
    (( new > 0 )) && lines+=("$new new inbox event(s)")
    week=$(jq -r '.seven_day.used // empty' "${XDG_CACHE_HOME:-$HOME/.cache}/claude-usage.json" 2>/dev/null)
    [[ -n $week ]] && lines+=("Claude this week: ${week%.*} %")
    if (( ${#lines[@]} )); then
        msg=$(printf '%s\n' "${lines[@]}")
        [[ ${2:-} == --print ]] && echo "$msg" || notify-send -a Claude "Good to know" "$msg"
    fi
    ;;
doctor)
    # Checks the whole setup with code and prints one line per problem; nothing printed means all good.
    # The main chat sees this at start and proposes fixes.
    bin="$HOME/.local/bin"
    for c in agentic dock thread atlas inbox context desk journal run-logged ssh-unlock claude-usage; do
        [[ -x $bin/$c ]] || echo "missing command: $c (link it from ~/dotfiles/bin/.local/bin, see install/links.sh)"
    done
    [[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/agentic/atlas.conf ]] || echo "no ~/.config/agentic/atlas.conf (link from claude-config/agentic)"
    [[ -e $dir/CLAUDE.md ]] || echo "the main chat has no rules: $dir/CLAUDE.md (link from claude-config/agentic/main-CLAUDE.md)"
    for h in main-start.sh main-prompt.sh session-track.sh; do
        grep -q "$h" "$HOME/.claude/settings.json" 2>/dev/null || echo "hook not registered in ~/.claude/settings.json: $h"
    done
    if [[ ! -e $off_flag ]]; then
        has_main_window || echo "the main chat isn't running (agentic on)"
        "$HOME/.local/bin/dock" status 2>/dev/null | grep -q closed && echo "the side panel isn't open (dock ensure)"
        pgrep -f 'journal record' >/dev/null || echo "the focus recorder for journal isn't running (journal record, started at login)"
    fi
    idx="${XDG_DATA_HOME:-$HOME/.local/share}/agentic/atlas/index.md"
    if [[ ! -e $idx ]]; then echo "no atlas yet (atlas refresh)"
    else
        (( $(date +%s) - $(stat -c %Y "$idx") > 86400 )) && echo "the atlas is older than a day (atlas refresh)"
        grep -m1 '^\*\*Stale' "$idx"
    fi
    log="$state/usage.log"
    [[ -e $log ]] && (( $(date +%s) - $(stat -c %Y "$log") > 3 * 86400 )) && echo "no usage readings for 3 days (status line script in claude-config)"
    "$HOME/.local/bin/ssh-unlock" --check >/dev/null 2>&1 || echo "ssh keys not loaded (ssh-unlock opens the passphrase window)"
    for f in "${XDG_DATA_HOME:-$HOME/.local/share}"/agentic/threads/*.md; do
        [[ -e $f ]] || continue
        sid=$(awk -F': ' '/^session:/{print $2; exit}' "$f")
        ls "$HOME"/.claude/projects/*/"$sid".jsonl >/dev/null 2>&1 || echo "thread $(basename "$f" .md) has no transcript any more (thread rm)"
    done
    ;;
restart)
    if has_main_window && main_idle_prompt; then tmux send-keys -t "$(main_pane)" '/exit' Enter
    else echo "The main chat has something typed or a question open; restart it when it's idle."; exit 1; fi
    ;;
status)
    if [[ -e $off_flag ]]; then echo "off (agentic on to start)"; exit 0; fi
    if has_main_window; then
        echo "main chat: running in tmux $session:main, pane $(main_pane) ($(tmux display -p -t "$(main_pane)" '#{pane_current_command}'))"
    else
        echo "main chat: not running (agentic on)"
    fi
    "$HOME/.local/bin/dock" status 2>/dev/null
    command -v thread >/dev/null && thread list 2>/dev/null; true
    ;;
*)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
