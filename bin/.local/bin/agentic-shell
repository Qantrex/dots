#!/usr/bin/env python3
"""What the shell's agent panel (theme root-agentic, quickshell/agentic/) reads, as JSON.

  agentic-shell feed <main|thread> [--once] [--strong '#fff'] [--code '#aaa']
                               the conversation of that session, one JSON object per line, and
                               then every new message as it is written (until killed)
  agentic-shell home [--seen]  one JSON object: the brief, the last inbox events, how many are
                               new since the home tab was last looked at (--seen: now), and
                               the threads that are open, and the number of unread result cards
  agentic-shell requests       one JSON object: what waits for a yes, a no or an answer (permission
                               requests and question dialogs of Claude sessions, open question
                               rounds of threads)
  agentic-shell answer <id> allow|deny [json]
                               the panel's answer to one of them; json: {"answers": {question: label
                               | [labels] | free text}} for questions, {"message": why} for a deny
  agentic-shell hold [--for SECONDS]
                               the PermissionRequest hook of Claude Code (hook input on stdin): shows
                               the request in the panel and waits for its answer. Prints nothing
                               whenever the panel cannot answer, and the terminal asks as always.
  agentic-shell release [--all]
                               hook input on stdin: drops the requests of that session which are
                               settled (the tool ran, the turn ended). --all: every request, back
                               to the terminal (the theme's leave hook).
  agentic-shell grab window|clipboard
                               the panel's desk row: {"insert": text} for the input box, or
                               {"error": why}. window: a screenshot of the focused window (the
                               panel hides itself first), saved under ~/.cache/agentic/shots;
                               clipboard: its text, or the path of the image it holds
  agentic-shell notify <session> <event> <title> <why> [pane]
                               the session hook's notification in this theme (exit 1: not on, the
                               hook notifies as before): an inbox line for sessions other than the
                               main chat, nothing on screen while the panel is shown, else a
                               notification with real buttons (Allow, Deny, Open on a permission
                               request; Open, Terminal otherwise) that closes once it is settled
  agentic-shell snapshot       what is running that a theme could have started: user units,
                               layers, keybinds, windows, the shell's child processes, wallpaper
  agentic-shell leave-check    from root: switch to root-agentic and back, and compare the
                               snapshots before and after. Changes the desktop for a few seconds.
  agentic-shell workspaces     which thread belongs to which workspace, as JSON: a pin, else the
                               thread whose folder the workspace's windows work in (their processes'
                               folders, tmux clients by their pane's folder)
  agentic-shell pin [<ws>] <thread>|--clear
                               pin a workspace (default: the focused one) to a thread, or unpin it

The panel never talks to Claude itself. It reads the transcript Claude Code writes for the session
in a tmux window of "main" (found through the pane, so a /clear or a resume is followed), and it
sends with `thread send`. Nothing costs usage. One Claude Code setting is used: the PermissionRequest
hook (~/Projects/claude-config/hooks/permission-panel.sh) that runs `hold`. The terminal's own
dialog stays up and answerable the whole time; whichever answers first counts. A request is a file
in ~/.local/state/agentic/requests/, its answer a file next to it, so any process of this user can
answer one, as it could already type into the session's terminal with tmux.

feed lines: {"op": "reset", "target", "session"}            start, or the session changed
            {"op": "add", "id", "role", "text", "rich", "at"}  role: user, assistant, tool, ask, note
            {"op": "set", "id", ...}                         replaces the entry with that id (tool steps)
            {"op": "ready"}                                  the history is through, live from here
            {"op": "gone"}                                   no session in that window right now
"""
import glob
import hashlib
import html
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from datetime import datetime

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "agentic")
RECORDS = os.path.join(os.path.dirname(STATE), "claude-sessions")
THREADS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "agentic", "threads")
INBOX = os.path.join(STATE, "inbox.jsonl")
SEEN = os.path.join(STATE, "panel-seen")
REQUESTS = os.path.join(STATE, "requests")
ANSWERED = os.path.join(STATE, "panel-answers.log")
QS = shlex.split(os.environ.get("AGENTIC_QS") or "qs")    # the test instance: "qs -p <dir>"
CONF = os.environ.get("QS_AGENTIC_CONF") or os.path.join(HOME, "dotfiles/theme/current/agentic.json")
MAX_REQUEST = 20000      # characters of one request shown in the panel
BIN = os.environ.get("AGENTIC_BIN") or os.path.join(HOME, ".local/bin")       # stand-ins in tests
SCRIPTS = os.environ.get("AGENTIC_SCRIPTS") or os.path.join(HOME, ".config/scripts")
NOTE_FIT = 400           # Allow is offered on a notification only when the whole request fits in it
SESSION = "main"
HISTORY = 150            # entries shown from before the panel opened
TAIL_BYTES = 12 << 20    # read at most this much from the end of a long transcript
MAX_TEXT = 12000         # characters of one message


def sh(args, timeout=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def out(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


# ---- which transcript ---------------------------------------------------------------------

def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def pane_of(target):
    """The pane of tmux window main:TARGET, or "". tmux names a plain shell after its folder
    (automatic-rename), so a second window can carry the same name: the one named on purpose wins."""
    rows = [r.split("\t") for r in sh(["tmux", "list-windows", "-t", f"={SESSION}", "-F",
                                       "#{window_name}\t#{automatic-rename}\t#{pane_id}"]).splitlines()]
    rows = sorted((r for r in rows if len(r) == 3 and r[0] == target), key=lambda r: r[1] != "0")
    return rows[0][2] if rows else ""


def transcript_of(target):
    """(session id, transcript path) of the Claude session in tmux window main:TARGET, or (None, None).
    Session records name their pane; several can (a /clear, a resume, an older session in the same
    pane), so a live process wins and then the newest."""
    pane = pane_of(target)
    if not pane:
        return None, None
    best = None
    for f in glob.glob(os.path.join(RECORDS, "*.json")):
        try:
            r = json.load(open(f, encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if r.get("pane") != pane or not r.get("transcript"):
            continue
        key = (alive(r.get("pid")), r.get("started") or 0)
        if best is None or key > best[0]:
            best = (key, r)
    if best and os.path.isfile(best[1]["transcript"]):
        return best[1].get("id"), best[1]["transcript"]
    return None, None


# ---- one transcript line -> what the panel shows ---------------------------------------------

def clip(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def tool_line(b):
    name, i = b.get("name", "tool"), b.get("input") or {}
    if name == "Bash":
        return clip(i.get("description") or i.get("command") or "command", 110)
    if name in ("Read", "Edit", "Write", "NotebookEdit"):
        return f"{name} {os.path.basename(i.get('file_path') or i.get('notebook_path') or '')}"
    if name == "SendMessage":
        return clip(f"to {i.get('to', '?')}: {i.get('message', '')}", 110)
    if name in ("Agent", "Task"):
        return clip(f"agent: {i.get('description', '')}", 110)
    if name == "Skill":
        return f"skill {i.get('skill', '')}"
    if name in ("WebSearch", "WebFetch"):
        return clip(f"{name} {i.get('query') or i.get('url') or ''}", 110)
    if name.startswith("mcp__"):
        return name.split("__", 1)[1].replace("__", " ")
    return name


def question(b):
    qs = (b.get("input") or {}).get("questions") or []
    return clip(qs[0].get("question", "") if qs else "", 300) or "a question"


INLINE = re.compile(r"(`[^`\n]+`)|\*\*([^*\n]+)\*\*|\[([^\]\n]+)\]\(([^)\s]+)\)")


def table_sep(line):
    """The line under a table's header: cells of dashes, a colon at an end for the alignment.
    Cell by cell, so a long line costs its length (one pattern over the whole line took seconds
    on a wide line of spaces, and the feed with it)."""
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|"):
        s = s[:-1]
    return all(re.fullmatch(r":?-+:?", c.strip()) for c in s.split("|"))


def table_cells(line):
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|") and not s.endswith("\\|"):
        s = s[:-1]
    return [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", s)]


def rich(text, strong, code):
    """A message as Qt rich text. Everything from the message is escaped first, so the only tags
    in the result are the ones written here (no images, no links to fetch): bold, headings,
    code, tables. The rest of Markdown stays as typed. The feed is the panel's only source, so a
    table that trips the code costs the tables, never the message."""
    try:
        return _rich(text, strong, code, True)
    except Exception:
        return _rich(text, strong, code, False)


def _rich(text, strong, code, tables):
    def inline(line):
        res, pos = [], 0
        for m in INLINE.finditer(line):
            res.append(html.escape(line[pos:m.start()], quote=False))
            if m.group(1):
                res.append(f'<span style="color:{code}">{html.escape(m.group(1)[1:-1], quote=False)}</span>')
            elif m.group(2):
                res.append(f'<b style="color:{strong}">{html.escape(m.group(2), quote=False)}</b>')
            else:
                label, url = m.group(3), m.group(4)
                res.append(html.escape(label if label == url else f"{label} ({url})", quote=False))
            pos = m.end()
        res.append(html.escape(line[pos:], quote=False))
        return "".join(res)

    def table(head, aligns, rows):
        # Qt draws the grid from border="1"; its colour is the muted text colour of the theme.
        def row(cells, tag):
            out = []
            for k in range(len(head)):
                c = inline(cells[k]) if k < len(cells) else ""
                if tag == "th":
                    c = f'<b style="color:{strong}">{c}</b>'
                out.append(f'<{tag} align="{aligns[k]}">{c}</{tag}>')
            return "<tr>" + "".join(out) + "</tr>"
        return (f'<table border="1" cellspacing="0" cellpadding="4" '
                f'style="border-collapse:collapse;border-color:{code};margin-top:4px;margin-bottom:4px">'
                + row(head, "th") + "".join(row(r, "td") for r in rows) + "</table>")

    blocks, lines, fenced = [], [], False

    def flush(for_table=False):
        # Empty lines next to a table would add to the table's own margin.
        if for_table:
            while lines and not lines[-1].strip():
                lines.pop()
        if lines:
            blocks.append('<p style="white-space:pre-wrap;margin:0">' + "\n".join(lines) + "</p>")
        lines.clear()

    src = text.split("\n")
    n = 0
    while n < len(src):
        line = src[n]
        n += 1
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            lines.append(f'<span style="color:{code}">{html.escape(line, quote=False)}</span>')
            continue
        # A table: a row with a pipe, then the line of dashes with as many cells (GitHub's rule).
        if tables and "|" in line and n < len(src) and "-" in src[n] and table_sep(src[n]):
            head, sep = table_cells(line), table_cells(src[n])
            if len(head) == len(sep) and (len(head) > 1 or line.strip().startswith("|")):
                aligns = ["center" if c.startswith(":") and c.endswith(":") else "right" if c.endswith(":") else "left"
                          for c in sep]
                n += 1
                rows = []
                while n < len(src) and src[n].strip() and "|" in src[n] and not src[n].lstrip().startswith("```"):
                    rows.append(table_cells(src[n]))
                    n += 1
                flush(True)
                blocks.append(table(head, aligns, rows))
                while n < len(src) and not src[n].strip():
                    n += 1
                continue
        m = re.match(r"\s{0,3}#{1,6}\s+(.*)", line)
        if m:
            lines.append(f'<b style="color:{strong}">{inline(m.group(1))}</b>')
            continue
        m = re.match(r"(\s*)[-*]\s+(.*)", line)
        if m:
            lines.append(f"{m.group(1)}• {inline(m.group(2))}")
            continue
        lines.append(inline(line))
    flush()
    return "".join(blocks) or '<p style="white-space:pre-wrap;margin:0"></p>'


def when(d):
    try:
        return datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).astimezone().strftime("%H:%M")
    except (KeyError, ValueError, AttributeError):
        return ""


TAGS = re.compile(r"<(/?)[a-zA-Z][\w-]*(\s[^>]*)?>")


PASTED = re.compile(r'\n*</?pasted_content id="[^"]*">\n*')


def user_text(text):
    """(role, text) for something that arrived as a user message, or None to leave it out."""
    t = text.strip()
    if "<pasted_content id=" in t:
        # What Claude Code took as pasted (a paste in the terminal, a long text that arrived at
        # once) is still the message: the marks around it go, a line break stays in their place.
        t = PASTED.sub("\n", t).strip()
    if not t:
        return None
    if t.startswith("This session is being continued from a previous conversation"):
        return "note", "The conversation got long and was summarized here."
    if t.startswith("[inbox, from code]"):
        return "note", t
    m = re.search(r"<command-name>\s*(/[^<\s]+)", t)
    if m:
        return "note", m.group(1)
    if t.startswith(("<local-command", "<system-reminder", "<bash-", "Caveat:")):
        return None
    if t.startswith("<task-notification"):
        # A finished background task: what it says about itself, not its ids and file paths.
        m = re.search(r"<summary>(.*?)</summary>", t, re.S)
        if m and m.group(1).strip():
            return "note", clip(" ".join(m.group(1).split()), 240)
    if t.startswith("<"):
        # A wrapper Claude Code put around something that wasn't typed (a message from another
        # session, a finished background task): one dim line, tags dropped.
        rest = clip(TAGS.sub(" ", t), 240)
        return ("note", rest) if rest.strip() else None
    return "user", t


class Feed:
    """Turns transcript lines into entries, folding runs of tool steps into one line."""

    def __init__(self, strong, code):
        self.strong, self.code = strong, code
        self.n = 0
        self.steps = None  # the open run of tool steps: {"id", "count"}

    def entry(self, role, text, d):
        self.steps = None
        self.n += 1
        text = text[:MAX_TEXT]
        e = {"op": "add", "id": d.get("uuid") or f"e{self.n}", "role": role, "text": text, "at": when(d)}
        e["rich"] = rich(text, self.strong, self.code) if role == "assistant" else ""
        return e

    def parse(self, line):
        if '"type":"user"' not in line and '"type":"assistant"' not in line:
            return []
        try:
            d = json.loads(line)
        except ValueError:
            return []
        kind = d.get("type")
        if kind not in ("user", "assistant") or d.get("isMeta") or d.get("isSidechain"):
            return []
        content = (d.get("message") or {}).get("content")
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else (content or [])
        res = []
        for b in blocks:
            if not isinstance(b, dict):
                continue
            bt = b.get("type")
            if bt == "text" and kind == "user":
                got = user_text(b.get("text") or "")
                if got:
                    res.append(self.entry(got[0], got[1], d))
            elif bt == "text" and (b.get("text") or "").strip():
                res.append(self.entry("assistant", b["text"].strip(), d))
            elif bt == "tool_use" and b.get("name") == "AskUserQuestion":
                res.append(self.entry("ask", question(b), d))
            elif bt == "tool_use":
                if self.steps is None:
                    self.n += 1
                    self.steps = {"id": d.get("uuid") or f"e{self.n}", "count": 0, "new": True}
                s = self.steps
                s["count"] += 1
                text = tool_line(b) if s["count"] == 1 else f"{s['count']} steps, last: {tool_line(b)}"
                res.append({"op": "add" if s.pop("new", False) else "set", "id": s["id"], "role": "tool",
                            "text": text, "rich": "", "at": when(d)})
        return res


def fold(entries):
    """History only: drop the intermediate versions of a tool line and keep the last HISTORY entries."""
    order, last = [], {}
    for e in entries:
        if e["id"] not in last:
            order.append(e["id"])
        last[e["id"]] = {**e, "op": "add"}
    return [last[i] for i in order][-HISTORY:]


def cmd_feed(args):
    once = "--once" in args
    opt = lambda k, default: args[args.index(k) + 1] if k in args and args.index(k) + 1 < len(args) else default
    strong, code = opt("--strong", "#ffffff"), opt("--code", "#a0a0a0")
    names = [a for i, a in enumerate(args) if not a.startswith("--") and (i == 0 or args[i - 1] not in ("--strong", "--code"))]
    if not names:
        sys.exit("agentic-shell feed <main|thread> [--once]")
    target = names[0]
    current, fh, feed = False, None, None  # False: not looked yet (None: looked, no session)
    buf, checked, gone = "", 0.0, False
    while True:
        now = time.monotonic()
        if fh is None or now - checked > 3:
            checked = now
            sid, path = transcript_of(target)
            if path != current:
                if fh:
                    fh.close()
                current, fh, buf = path, None, ""
                if path is None:
                    if not gone:
                        out({"op": "gone", "target": target})
                    gone = True
                else:
                    gone = False
                    out({"op": "reset", "target": target, "session": sid})
                    fh = open(path, "rb")
                    size = os.fstat(fh.fileno()).st_size
                    if size > TAIL_BYTES:
                        fh.seek(size - TAIL_BYTES)
                        fh.readline()  # the rest of a cut line
                    feed = Feed(strong, code)
                    data = fh.read()
                    cut = data.rfind(b"\n") + 1
                    fh.seek(fh.tell() - (len(data) - cut))  # a half-written last line is read next time
                    history = []
                    for line in data[:cut].decode("utf-8", "replace").splitlines():
                        history.extend(feed.parse(line))
                    for e in fold(history):
                        out(e)
                    out({"op": "ready"})
        if once:
            return
        if fh:
            chunk = fh.read()
            if chunk:
                buf += chunk.decode("utf-8", "replace")
                *lines, buf = buf.split("\n")
                for line in lines:
                    for e in feed.parse(line):
                        out(e)
        time.sleep(0.4)


# ---- home tab ---------------------------------------------------------------------------------

def threads():
    """The threads that have a window in tmux "main" right now, with what the session hook last said."""
    said = {}
    try:
        for t in json.load(open(os.path.join(HOME, ".cache/agentic-threads.json"), encoding="utf-8")):
            said[t.get("name")] = t
    except (OSError, ValueError, AttributeError):
        pass
    res = []
    for name in sh(["tmux", "list-windows", "-t", f"={SESSION}", "-F", "#{window_name}"]).split():
        if name == "main" or not os.path.isfile(os.path.join(THREADS, name + ".md")):
            continue
        t = said.get(name) or {}
        res.append({"name": name, "state": t.get("state") or "idle", "detail": clip(t.get("detail") or "", 160),
                    "since": t.get("since") or 0})
    return res


def cmd_home(args):
    try:
        seen = int(open(SEEN).read().strip())
    except (OSError, ValueError):
        seen = 0
    events = []
    try:
        for line in open(INBOX, encoding="utf-8"):
            try:
                events.append(json.loads(line))
            except ValueError:
                pass
    except OSError:
        pass
    events.sort(key=lambda e: e.get("ts", 0), reverse=True)
    today = datetime.now().date()

    def stamp(ts):
        t = datetime.fromtimestamp(ts)
        return t.strftime("%H:%M") if t.date() == today else t.strftime("%a %H:%M")

    inbox = [{"at": stamp(e.get("ts", 0)), "level": e.get("level", ""), "source": e.get("source", ""),
              "text": clip(e.get("text", ""), 400), "untrusted": bool(e.get("untrusted")), "new": e.get("ts", 0) > seen}
             for e in events[:40]]
    new = sum(1 for e in events if e.get("ts", 0) > seen)
    if "--seen" in args:
        # This answer still marks what is new; from the next one on it counts as looked at.
        os.makedirs(STATE, exist_ok=True)
        with open(SEEN, "w") as f:
            f.write(str(int(time.time())))
        new = 0
    brief = sh([os.path.join(BIN, "agentic"), "brief", "--print"], timeout=20).strip().splitlines()
    try:
        results = int(sh([os.path.join(BIN, "results"), "count"], timeout=5).strip() or 0)
    except ValueError:
        results = 0
    out({"brief": brief, "inbox": inbox, "new": new, "threads": threads(), "results": results})


# ---- what is running (the leave check) --------------------------------------------------------

# ---- requests: what waits for the owner ---------------------------------------------------

def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def stdin_json():
    """What a hook got on stdin. Read from the open stream: Claude Code passes a socket, and a
    socket cannot be opened again by its path (/dev/stdin)."""
    try:
        return json.loads(sys.stdin.read())
    except (OSError, ValueError):
        return None


def save(path, obj):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False)
    os.replace(tmp, path)


def drop(*paths):
    for p in paths:
        try:
            os.unlink(p)
        except OSError:
            pass


def panel_status():
    """off, hidden or shown; off also when the shell does not answer."""
    return (sh(QS + ["ipc", "call", "agentic", "status"], timeout=3).split() or ["off"])[0]


def tell_panel():
    """True when the shell took the news that the requests changed."""
    try:
        return subprocess.run(QS + ["ipc", "call", "agentic", "requests"], capture_output=True, timeout=3).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def request_id(session, tool, tool_input):
    """The same for the PermissionRequest of a call and for its PostToolUse. A question dialog comes
    back with its answers added, so only the questions count there."""
    what = tool_input.get("questions") if tool == "AskUserQuestion" and isinstance(tool_input, dict) else tool_input
    digest = hashlib.sha1(json.dumps([tool, what], sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:12]
    return f"{session}.{digest}"


def request_text(tool, i):
    """(title, text) of a permission request, as plain text."""
    if not isinstance(i, dict):
        return tool, json.dumps(i, ensure_ascii=False, indent=2)
    path = i.get("file_path") or i.get("notebook_path") or ""
    if tool == "Bash":
        return i.get("description") or "Run a command", str(i.get("command") or "")
    if tool == "Write":
        return f"Write {path}", str(i.get("content") or "")
    if tool == "Edit":
        old = "\n".join("- " + l for l in str(i.get("old_string") or "").splitlines())
        new = "\n".join("+ " + l for l in str(i.get("new_string") or "").splitlines())
        return f"Edit {path}" + (" (every occurrence)" if i.get("replace_all") else ""), f"{old}\n{new}"
    if path:
        rest = {k: v for k, v in i.items() if k not in ("file_path", "notebook_path")}
        return f"{tool} {path}", json.dumps(rest, ensure_ascii=False, indent=2) if rest else ""
    return tool, json.dumps(i, ensure_ascii=False, indent=2)


def held():
    """The requests whose hook still waits, oldest first. Files of hooks that are gone are removed."""
    reqs = []
    for path in glob.glob(os.path.join(REQUESTS, "*.json")):
        r = load(path)
        if not r or not alive(r.get("pid")):
            drop(path, path[:-5] + ".answer")
            continue
        reqs.append(r)
    return sorted(reqs, key=lambda r: r.get("at") or 0)


def cmd_requests():
    reqs = []
    for r in held():
        tool, i = r.get("tool") or "", r.get("input")
        e = {"id": r["id"], "tab": r.get("tab") or "", "name": r.get("name") or "", "tool": tool,
             "at": datetime.fromtimestamp(r.get("at") or 0).strftime("%H:%M"), "cwd": r.get("cwd") or ""}
        if tool == "AskUserQuestion" and isinstance(i, dict) and isinstance(i.get("questions"), list):
            e.update(kind="ask", title="A question" if len(i["questions"]) == 1 else f"{len(i['questions'])} questions",
                     text="", questions=i["questions"])
        else:
            title, text = request_text(tool, i)
            if len(text) > MAX_REQUEST:
                text = text[:MAX_REQUEST] + f"\n... ({len(text) - MAX_REQUEST} more characters, see the terminal)"
                e["cut"] = True      # not all of it can be read here: the panel offers no yes then
            e.update(kind="approve", title=clip(title, 200), text=text, questions=[])
        reqs.append(e)
    # A thread never opens a dialog: its questions are a stored round (`thread ask`), answered with
    # `thread answer`. The main chat is told about the same round and may ask it again itself.
    for path in sorted(glob.glob(os.path.join(THREADS, "*.questions.json"))):
        r = load(path)
        if not r or not r.get("questions") or r.get("answers") or not r.get("round"):
            continue
        name = os.path.basename(path)[:-len(".questions.json")]
        if not os.path.exists(os.path.join(THREADS, name + ".md")):
            continue
        reqs.append({"id": f"thread:{name}:{r['round']}", "tab": name, "name": name, "tool": "thread ask", "kind": "ask",
                     "title": "Questions from this thread", "text": "", "questions": r["questions"],
                     "at": str(r.get("asked") or "")[11:16], "cwd": ""})
    out({"requests": reqs})


def cmd_answer(args):
    usage = "agentic-shell answer <id> allow|deny [json]"
    if len(args) < 2 or args[1] not in ("allow", "deny"):
        sys.exit(usage)
    rid, behavior = args[0], args[1]
    try:
        extra = json.loads(args[2]) if len(args) > 2 and args[2].strip() else {}
    except ValueError:
        sys.exit(usage)
    if not isinstance(extra, dict):
        sys.exit(usage)
    m = re.fullmatch(r"thread:([A-Za-z0-9._-]+):([A-Za-z0-9-]+)", rid)
    if m:
        if behavior != "allow" or not isinstance(extra.get("answers"), dict):
            sys.exit("agentic-shell answer: a thread's questions take answers, not a yes or no")
        r = subprocess.run([os.path.join(BIN, "thread"), "answer", m.group(1)], capture_output=True, text=True, timeout=30,
                           input=json.dumps({"round": m.group(2), "answers": extra["answers"]}))
        tell_panel()
        if r.returncode:
            sys.exit((r.stderr.strip() or r.stdout.strip() or "thread answer failed").replace("thread answer: ", ""))
        return
    if not re.fullmatch(r"[A-Za-z0-9-]+\.[0-9a-f]{12}", rid):
        sys.exit(usage)
    path = os.path.join(REQUESTS, rid + ".json")
    req = load(path)
    if not req or not alive(req.get("pid")):
        drop(path)
        tell_panel()
        sys.exit("That request is gone: it was answered in the terminal, or its turn ended.")
    ans = {"behavior": behavior}
    if req.get("tool") == "AskUserQuestion":
        if behavior != "allow" or not isinstance(extra.get("answers"), dict) or not extra["answers"]:
            sys.exit("agentic-shell answer: a question takes answers, not a yes or no")
        ans["answers"] = extra["answers"]
    elif behavior == "deny":
        ans["message"] = str(extra.get("message") or "").strip() or "The owner said no to this in the agent panel."
    save(path[:-5] + ".answer", ans)


def cmd_hold(args):
    data = stdin_json()
    if not isinstance(data, dict) or data.get("hook_event_name") != "PermissionRequest":
        return
    session, tool = str(data.get("session_id") or ""), str(data.get("tool_name") or "")
    if not re.fullmatch(r"[A-Za-z0-9-]{8,}", session) or not tool:
        return
    try:
        seconds = float(args[args.index("--for") + 1]) if "--for" in args else 3600
    except (IndexError, ValueError):
        seconds = 3600
    # Only where the panel can show it: this theme, a shell that answers, a session the desktop knows.
    if not (load(CONF) or {}).get("enabled"):
        return
    rec = load(os.path.join(RECORDS, session + ".json"))
    if not rec or panel_status() not in ("hidden", "shown"):
        return
    tab = "main" if rec.get("role") == "main" else (str(rec.get("name") or "") if rec.get("role") == "thread" else "")
    if not re.fullmatch(r"[A-Za-z0-9._-]*", tab):
        tab = ""
    rid = request_id(session, tool, data.get("tool_input"))
    path = os.path.join(REQUESTS, rid + ".json")
    answer = path[:-5] + ".answer"
    parent = os.getppid()
    drop(answer)
    save(path, {"id": rid, "session": session, "tab": tab, "tool": tool, "input": data.get("tool_input"),
                "name": rec.get("name") or os.path.basename(str(data.get("cwd") or "")) or session[:8],
                "cwd": data.get("cwd") or "", "mode": data.get("permission_mode") or "", "pid": os.getpid(),
                "at": time.time()})

    def leave(*_):
        drop(path, answer)
        tell_panel()
        sys.exit(0)

    signal.signal(signal.SIGTERM, leave)
    signal.signal(signal.SIGHUP, leave)
    if not tell_panel():
        drop(path)
        return
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        ans = load(answer) if os.path.exists(answer) else None
        if ans:
            break
        # Settled somewhere else (the terminal, the end of the turn), or Claude itself is gone.
        if not os.path.exists(path) or os.getppid() != parent:
            leave()
        time.sleep(0.25)
    else:
        leave()
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    decision = {"behavior": "deny" if ans.get("behavior") == "deny" else "allow"}
    if decision["behavior"] == "deny":
        decision["message"] = str(ans.get("message") or "The owner said no to this in the agent panel.")
    elif tool == "AskUserQuestion":
        answers = {q: (", ".join(map(str, a)) if isinstance(a, list) else str(a)) for q, a in (ans.get("answers") or {}).items()}
        decision["updatedInput"] = dict(data.get("tool_input") or {}, answers=answers)
    try:
        with open(ANSWERED, "a", encoding="utf-8") as f:
            f.write(json.dumps({"at": datetime.now().isoformat(timespec="seconds"), "session": session, "tab": tab,
                                "tool": tool, "behavior": decision["behavior"]}) + "\n")
    except OSError:
        pass
    out({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}})
    drop(path, answer)
    tell_panel()


def cmd_release(args):
    if "--all" in args:
        paths = glob.glob(os.path.join(REQUESTS, "*.json"))
    else:
        data = stdin_json()
        session = str((data or {}).get("session_id") or "")
        if not re.fullmatch(r"[A-Za-z0-9-]{8,}", session):
            return
        event = data.get("hook_event_name")
        if event == "PostToolUse":
            paths = [os.path.join(REQUESTS, request_id(session, str(data.get("tool_name") or ""), data.get("tool_input")) + ".json")]
        elif event in ("UserPromptSubmit", "Stop", "SessionEnd"):
            paths = glob.glob(os.path.join(REQUESTS, glob.escape(session) + ".*.json"))
        else:
            return
    paths = [p for p in paths if os.path.exists(p)]
    if not paths:
        return
    drop(*paths, *[p[:-5] + ".answer" for p in paths])
    if panel_status() != "off":
        tell_panel()


def qs_pid():
    return sh(["pgrep", "-x", "-o", "qs"]).strip() or sh(["pgrep", "-x", "-o", "quickshell"]).strip()


def snapshot():
    lines = []
    for row in sh(["systemctl", "--user", "list-units", "--state=active,activating", "--no-legend", "--plain"]).splitlines():
        cols = row.split()
        unit = cols[0] if cols else ""
        # Scopes and slices come and go with every window opened; services, timers, sockets and paths don't.
        if unit.endswith((".service", ".timer", ".socket", ".path")) and not unit.startswith("app-"):
            # A timer's job in the middle of its run (a oneshot that is still starting) ends by itself.
            job = (unit.endswith(".service") and len(cols) > 2 and cols[2] == "activating"
                   and sh(["systemctl", "--user", "show", unit, "-p", "Type", "--value"]).strip() == "oneshot")
            lines.append(f"unit {unit}{JOB if job else ''}")
    try:
        layers = json.loads(sh(["hyprctl", "layers", "-j"]) or "{}")
        for mon, m in layers.items():
            for level in (m.get("levels") or {}).values():
                for l in level:
                    lines.append(f"layer {mon} {l.get('namespace')}")
    except ValueError:
        lines.append("layer ?")
    try:
        for b in json.loads(sh(["hyprctl", "binds", "-j"]) or "[]"):
            # A lua bind's dispatcher is a pointer and its arg a running number, new on every
            # Hyprland reload: its description says what it does.
            what = b.get("description") or re.sub(r"0x[0-9a-f]+", "", f"{b.get('dispatcher')}")
            lines.append(f"bind {b.get('submap') or '-'} {b.get('modmask')} {b.get('key')} {what}")
    except ValueError:
        lines.append("bind ?")
    try:
        for c in json.loads(sh(["hyprctl", "clients", "-j"]) or "[]"):
            lines.append(f"window {c.get('class')}")
    except ValueError:
        lines.append("window ?")
    pid = qs_pid()
    for child in sh(["pgrep", "-P", pid]).split() if pid else []:
        try:
            cmd = open(f"/proc/{child}/cmdline", "rb").read().replace(b"\0", b" ").decode("utf-8", "replace").strip()
        except OSError:
            continue
        lines.append(f"shell-child {cmd}")
    for row in sh(["hyprctl", "hyprpaper", "listactive"]).splitlines():
        lines.append(f"wallpaper {row.strip()}")
    try:
        lines.append("wallpaper-last " + open(os.path.join(HOME, ".cache/wallpaper/last")).read().strip())
    except OSError:
        pass
    # What the panel's request cards leave behind while a session asks: a file each, and the hook that waits.
    for path in glob.glob(os.path.join(REQUESTS, "*")):
        lines.append(f"request {os.path.basename(path)}")
    for pid in sh(["pgrep", "-f", "^python3? .*agentic-shell hold"]).split():
        lines.append(f"hold {pid}")
    # "off", "hidden" or "shown <tab>"; without the service (an older shell) it is off too.
    status = (sh(["qs", "ipc", "call", "agentic", "status"]).split() or ["off"])[0]
    lines.append(f"panel {status if status in ('shown', 'hidden') else 'off'}")
    return sorted(lines)


JOB = " (a job, running)"
# Layers of the shell that show and go on their own in every theme.
PASSING_LAYERS = ("qs-notifications", "qs-osd")


def passing(line):
    """Something that comes and goes by itself whatever the theme: a notification or the volume
    display on screen, a timer's job in the middle of its run."""
    return line.endswith(JOB) or (line.startswith("layer ") and line.split()[-1] in PASSING_LAYERS)


def leave_diff(before, after, look_again):
    """(left over, missing, not counted) after the round trip. Missing: what only passed by before
    is not counted. Left over: what only passes by gets looks until it is gone (look_again()
    returns a new snapshot, or None when it has looked long enough); what stays is reported."""
    def unit(l):   # a unit is the same unit while its job runs
        return l[:-len(JOB)] if l.endswith(JOB) else l

    lost = {l for l in set(before) - set(after) if unit(l) not in {unit(a) for a in after}}
    skipped = {l for l in lost if passing(l)}
    left = {l for l in set(after) - set(before) if unit(l) not in {unit(b) for b in before}}
    while any(passing(l) for l in left):
        again = look_again()
        if again is None:
            break
        # A look that saw no layers (hyprctl failed) or no units (systemctl failed) proves nothing gone.
        seen = {kind for kind in ("layer ", "unit ") if any(l.startswith(kind) and l != "layer ?" for l in again)}
        gone = {l for l in left if passing(l) and l not in again and l.split()[0] + " " in seen}
        # A job that is over and left its unit running: that unit is new and counts.
        stays = {unit(l) for l in gone if l.endswith(JOB) and unit(l) in again}
        skipped |= {l for l in gone if unit(l) not in stays}
        left = (left - gone) | stays
    return sorted(left), sorted(lost - skipped), sorted(skipped)


def stable_snapshot():
    """The shell starts short-lived helpers (a `claude-usage` read, a volume query) all the time.
    Keep only what is there in three looks, half a second apart."""
    looks = []
    for i in range(3):
        if i:
            time.sleep(0.5)
        looks.append(snapshot())
    return sorted(l for l in set(looks[0]) if all(l in s for s in looks[1:]) or not l.startswith("shell-child"))


def cmd_leave_check():
    theme = os.path.join(BIN, "theme")
    cur = sh([theme, "list"]).splitlines()[0].replace("current:", "").strip() if sh([theme, "list"]) else ""
    if cur != "root":
        sys.exit(f"agentic-shell leave-check: starts from root (current: {cur or 'unknown'})")
    before = stable_snapshot()
    subprocess.run([theme, "set", "root-agentic"], capture_output=True)
    time.sleep(2.5)
    during = stable_snapshot()
    subprocess.run([theme, "set", "root"], capture_output=True)
    time.sleep(2.5)
    after = stable_snapshot()
    print("root-agentic adds:")
    for l in sorted(set(during) - set(before)):
        print(f"  + {l}")
    for l in sorted(set(before) - set(during)):
        print(f"  - {l}")
    looks = [0]

    def look_again():
        # A notification stays for some seconds, a job for as long as it runs: up to 20 s more.
        if looks[0] >= 5:
            return None
        looks[0] += 1
        time.sleep(4)
        return snapshot()

    left, lost, skipped = leave_diff(before, after, look_again)
    for l in skipped:
        print(f"not counted, it comes and goes on its own: {l}")
    if not left and not lost:
        print("back on root: nothing left over, nothing missing. OK")
        return
    print("back on root, DIFFERENT from before:")
    for l in left:
        print(f"  left over: {l}")
    for l in lost:
        print(f"  missing:   {l}")
    sys.exit(1)


SHOTS = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "agentic", "shots")
KEEP_SHOTS = 20
CLIP_MAX = 20000


def shot_path(name):
    os.makedirs(SHOTS, exist_ok=True)
    old = sorted((f for f in os.listdir(SHOTS) if f.endswith(".png")),
                 key=lambda f: os.path.getmtime(os.path.join(SHOTS, f)))
    for f in old[:max(0, len(old) - KEEP_SHOTS + 1)]:
        try:
            os.remove(os.path.join(SHOTS, f))
        except OSError:
            pass
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-")[:40] or "shot"
    return os.path.join(SHOTS, f"{safe}-{datetime.now():%Y%m%d-%H%M%S}.png")


def cmd_grab(args):
    what = args[0] if args else ""
    if what == "window":
        try:
            w = json.loads(sh(["hyprctl", "activewindow", "-j"]) or "{}")
        except ValueError:
            w = {}
        if not w.get("address"):
            return out({"error": "No window has the focus."})
        # The panel hides itself before it calls this; wait until it has faded out.
        time.sleep(float(os.environ.get("AGENTIC_GRAB_WAIT", "0.4")))
        (x, y), (wd, ht) = w["at"], w["size"]
        f = shot_path(w.get("class") or "window")
        r = subprocess.run(["grim", "-g", f"{x},{y} {wd}x{ht}", f], capture_output=True, text=True)
        if r.returncode != 0 or not os.path.exists(f):
            return out({"error": "The screenshot failed: " + (r.stderr.strip() or "grim")})
        title = (w.get("title") or "").strip()
        title = title if len(title) <= 60 else title[:57] + "..."
        what = w.get("class") or "window"
        return out({"insert": f"Screenshot of the {what} window" + (f' ("{title}")' if title else "") + f": {f}"})
    if what == "clipboard":
        types = sh(["wl-paste", "--list-types"], timeout=3).split()
        if not types:
            return out({"error": "The clipboard is empty."})
        img = next((t for t in types if t == "image/png"), None) or next((t for t in types if t.startswith("image/")), None)
        if img and not any(t.startswith("text/") or t in ("UTF8_STRING", "STRING", "TEXT") for t in types):
            f = shot_path("clipboard")
            try:
                with open(f, "wb") as fh:
                    r = subprocess.run(["wl-paste", "--no-newline", "--type", "image/png"], stdout=fh, timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                r = None
            if not r or r.returncode != 0 or os.path.getsize(f) == 0:
                return out({"error": "Could not read the image in the clipboard."})
            return out({"insert": f"Image from the clipboard: {f}"})
        text = sh(["wl-paste", "--no-newline"], timeout=3)
        if not text.strip():
            return out({"error": "The clipboard holds nothing to paste."})
        if len(text) > CLIP_MAX:
            text = text[:CLIP_MAX] + f"\n[... cut at {CLIP_MAX} characters]"
        return out({"insert": text})
    print("agentic-shell grab window|clipboard", file=sys.stderr)
    sys.exit(1)


def cmd_notify(args):
    """Called by the session hook instead of its own notification while root-agentic is on."""
    if len(args) < 4:
        sys.exit("agentic-shell notify <session> <event> <title> <why> [pane]")
    session, event, title, why = args[:4]
    pane = args[4] if len(args) > 4 else ""
    if not (load(CONF) or {}).get("enabled"):
        sys.exit(1)
    status = panel_status()
    if status not in ("hidden", "shown"):
        sys.exit(1)
    rec = load(os.path.join(RECORDS, session + ".json")) or {}
    # The main chat hears about other sessions through its inbox (queued, no wake: it isn't a question for
    # it). Their text is a session's output, which can quote anything it read, so it is marked untrusted.
    if rec.get("role") != "main":
        name = clip(str(rec.get("name") or title), 60)
        try:
            subprocess.run([os.path.join(BIN, "inbox"), "add", "--untrusted", "needs" if event == "Notification" else "info",
                            "session", f"'{name}': {why}"], capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass
    if status == "shown":
        return              # the panel shows it already: its card, the tab's state, "Waiting for you"
    req = next((r for r in reversed(held()) if r.get("session") == session), None)
    subprocess.Popen([os.path.abspath(__file__), "_notify-wait", session, title, why, pane, req["id"] if req else ""],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def close_note(nid):
    if nid.isdigit():
        sh(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path",
            "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.CloseNotification", nid], timeout=3)


def cmd_notify_wait(args):
    """The notification itself, waiting up to 15 min for a button; it goes away once the request is
    answered elsewhere (panel, terminal) or the session went on."""
    session, title, why, pane, rid = (list(args) + [""] * 5)[:5]
    path = os.path.join(REQUESTS, rid + ".json") if rid else ""
    req = load(path) if path else None
    body, actions = why, [("default", "Open"), ("open", "Open"), ("term", "Terminal")]
    if req and req.get("tool") == "AskUserQuestion":
        body = "A question waits for you in the panel."
    elif req:
        head, text = request_text(req.get("tool") or "", req.get("input"))
        whole = head if not text or text == head else head + "\n" + text
        body = whole if len(whole) <= NOTE_FIT else whole[:NOTE_FIT - 1] + "…"
        actions = [("default", "Open")] + ([("allow", "Allow")] if len(whole) <= NOTE_FIT else []) + \
                  [("deny", "Deny"), ("open", "Open")]
    # The card shows the body as styled text: escape it, keep the command's line breaks.
    body = html.escape(body).replace("\n", "<br>")
    cmd = ["notify-send", "-a", "Claude", "-p", "--wait"] + [f"--action={k}={l}" for k, l in actions] + ["--", title, body]
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return
    lines = []
    import threading
    threading.Thread(target=lambda: lines.extend(l.strip() for l in p.stdout), daemon=True).start()
    rpath = os.path.join(RECORDS, session + ".json")
    end = time.time() + 900
    while p.poll() is None:
        time.sleep(0.5)
        settled = (path and not (os.path.exists(path) and alive((load(path) or {}).get("pid")))) or \
                  (not path and "waiting" not in (load(rpath) or {"waiting": 1}))
        if settled or time.time() > end:
            close_note(lines[0] if lines else "")
            p.terminate()
            return
    time.sleep(0.2)
    act = lines[1] if len(lines) > 1 else ""
    target = pane or "main"
    if act in ("allow", "deny") and rid:
        r = subprocess.run([os.path.abspath(__file__), "answer", rid, act], capture_output=True, text=True, timeout=30)
        if r.returncode:
            sh(["notify-send", "-a", "Claude", "-t", "4000", "Not answered", (r.stderr.strip() or "That request is gone.")[:200]])
    elif act in ("default", "open"):
        subprocess.run([os.path.join(BIN, "dock"), "show", target], timeout=30)
    elif act == "term":
        subprocess.run([os.path.join(SCRIPTS, "claude-jump.sh"), session], timeout=30)


# ---- workspaces that know their thread ----------------------------------------------------------

PINS = os.path.join(STATE, "workspace-pins.json")
STATE_RANK = {"needs you": 0, "working": 1}


def thread_folders(ts):
    """{name: (folder, thread)} of the threads that have a tmux window, from their state files."""
    res = {}
    for t in ts:
        try:
            with open(os.path.join(THREADS, t["name"] + ".md"), encoding="utf-8") as f:
                head = f.read(2000).split("\n---", 1)[0]
        except OSError:
            continue
        for line in head.splitlines():
            if line.startswith("folder:"):
                folder = os.path.realpath(os.path.expanduser(line.split(":", 1)[1].strip()))
                # Home itself would match every terminal.
                if folder not in (HOME, "/"):
                    res[t["name"]] = (folder, t)
    return res


def proc_children():
    kids = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        kids.setdefault(ppid, []).append(int(d))
    return kids


def window_folders(pid, kids, tmux_paths):
    """The folders a window's processes work in: every process under it, a tmux client by its pane."""
    found, todo, seen = [], [pid], set()
    while todo and len(seen) < 400:
        p = todo.pop()
        if p in seen:
            continue
        seen.add(p)
        if p in tmux_paths:
            found.append(tmux_paths[p])
        else:
            try:
                found.append(os.readlink(f"/proc/{p}/cwd"))
            except OSError:
                pass
        todo.extend(kids.get(p, []))
    return [os.path.realpath(x) for x in found if x and x not in (HOME, "/")]


def workspace_map():
    try:
        clients = json.loads(sh(["hyprctl", "clients", "-j"]) or "[]")
        focused = json.loads(sh(["hyprctl", "activeworkspace", "-j"]) or "{}").get("id")
    except ValueError:
        clients, focused = [], None
    ts = threads()
    folders = thread_folders(ts)
    pins = load(PINS) or {}
    tmux_paths = {}
    for line in sh(["tmux", "list-clients", "-F", "#{client_pid}\t#{pane_current_path}"]).splitlines():
        pid, _, path = line.partition("\t")
        if pid.isdigit():
            tmux_paths[int(pid)] = path
    kids = proc_children() if folders else {}
    hits = {}                                     # workspace -> {thread: processes working in its folder}
    for c in clients:
        ws = (c.get("workspace") or {}).get("id") or 0
        if ws <= 0 or not c.get("pid") or not folders:
            continue
        for path in window_folders(c["pid"], kids, tmux_paths):
            for name, (folder, _) in folders.items():
                if path == folder or path.startswith(folder + "/"):
                    # Threads that share a folder (~/Notes): a subfolder named like the thread counts more,
                    # ~/Notes/Trip for "trip".
                    sub = path[len(folder) + 1:].split("/", 1)[0].lower()
                    hint = bool(sub) and (sub == name.lower() or sub in name.lower().split("-"))
                    n = hits.setdefault(str(ws), {})
                    n[name] = n.get(name, 0) + (3 if hint else 1)
    res = {}
    for ws, n in hits.items():
        # Most processes first; between threads of one folder the one that needs me, then the busy one.
        best = sorted(n, key=lambda t: (-n[t], STATE_RANK.get(folders[t][1]["state"], 2), -(folders[t][1].get("since") or 0)))
        res[ws] = {"thread": best[0], "how": "folder", "others": best[1:]}
    for ws, name in pins.items():
        if any(t["name"] == name for t in ts):
            res[str(ws)] = {"thread": name, "how": "pin", "others": []}
    states = {t["name"]: t["state"] for t in ts}
    for v in res.values():
        v["state"] = states.get(v["thread"], "idle")
    return {"focused": focused, "workspaces": res}


def cmd_workspaces(args):
    out(workspace_map())


def cmd_pin(args):
    if not args or len(args) > 2:
        sys.exit("agentic-shell pin [<workspace>] <thread>|--clear")
    if len(args) == 2:
        ws, what = args
    else:
        ws = str(json.loads(sh(["hyprctl", "activeworkspace", "-j"]) or "{}").get("id") or "")
        what = args[0]
    if not ws.isdigit() or ws == "0":
        sys.exit("agentic-shell pin: no such workspace")
    pins = load(PINS) or {}
    if what == "--clear":
        pins.pop(ws, None)
    elif re.fullmatch(r"[A-Za-z0-9._-]+", what) and os.path.isfile(os.path.join(THREADS, what + ".md")):
        pins[ws] = what
    else:
        sys.exit(f"agentic-shell pin: no thread '{what}'")
    save(PINS, pins)
    print(f"workspace {ws}: " + (pins.get(ws) or "no pin"))


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else ""
    try:
        if cmd == "feed":
            cmd_feed(a[1:])
        elif cmd == "home":
            cmd_home(a[1:])
        elif cmd == "requests":
            cmd_requests()
        elif cmd == "answer":
            cmd_answer(a[1:])
        elif cmd == "hold":
            cmd_hold(a[1:])
        elif cmd == "release":
            cmd_release(a[1:])
        elif cmd == "grab":
            cmd_grab(a[1:])
        elif cmd == "notify":
            cmd_notify(a[1:])
        elif cmd == "_notify-wait":
            cmd_notify_wait(a[1:])
        elif cmd == "snapshot":
            print("\n".join(stable_snapshot()))
        elif cmd == "leave-check":
            cmd_leave_check()
        elif cmd == "workspaces":
            cmd_workspaces(a[1:])
        elif cmd == "pin":
            cmd_pin(a[1:])
        else:
            print(__doc__)
            sys.exit(0 if cmd in ("-h", "--help", "help") else 1)
    except KeyboardInterrupt:
        pass
    except BrokenPipeError:
        # The reader went away (the panel closed): nothing more to say, and no traceback at exit.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())


if __name__ == "__main__":
    main()
