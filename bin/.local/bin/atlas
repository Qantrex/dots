#!/usr/bin/env python3
"""A map of this machine for people and agents, built by plain code (no AI, about 1-2 s).

  atlas                 print the index (short: what needs attention, areas, threads, pointers)
  atlas refresh         rebuild everything
  atlas <topic>         print one detail file: repos, deadlines, keybinds, tools, packages,
                        services, recent, sessions, homelab
  atlas topics          list the topics
  atlas queue [--json]  what waits on the owner, in one list: late school work and work due within 3 days
                        (Moodle, cached for 6 hours and refreshed in the background together with `moodle
                        sync`; tracker notes marked done or dropped are left out), threads with a `needs:`
                        line or open questions, homelab reports at ALERT or WARN, the open items of a plan
                        note, and blocked sessions. With a warm cache it answers in about a second.

Output: ~/.local/share/agentic/atlas/. Settings: ~/.config/agentic/atlas.conf (areas, where repos,
deadline notes, the homelab note and the homelab agent's host are). A topic whose collector fails is marked "stale" instead
of breaking the rest.
"""
import configparser
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from datetime import date, datetime

HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "agentic")
OUT = os.path.join(DATA, "atlas")
THREADS = os.path.join(DATA, "threads")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "agentic", "atlas.conf")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "agentic")
SCHOOL_CACHE = os.path.join(CACHE, "queue-school.json")
SCHOOL_MAX_AGE = 6 * 3600
TOPICS = ["repos", "deadlines", "keybinds", "tools", "packages", "services", "recent", "sessions", "homelab"]


def sh(cmd, timeout=20):
    try:
        return subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True,
                              timeout=timeout).stdout
    except (subprocess.SubprocessError, OSError):
        return ""


def short(p):
    return p.replace(HOME, "~", 1) if p.startswith(HOME) else p


def conf():
    c = configparser.ConfigParser(interpolation=None, delimiters=("=",))
    c.optionxform = str
    c.read(CONF)
    return c


def paths(value):
    return [os.path.expanduser(p) for p in (value or "").split()]


def ago(ts):
    d = time.time() - ts
    if d < 3600:
        return f"{int(d / 60)} min"
    if d < 86400:
        return f"{int(d / 3600)} h"
    return f"{int(d / 86400)} d"


# ---------------------------------------------------------------- collectors (each returns markdown)

def machine():
    host = socket.gethostname()
    up = sh("uptime -p").strip().replace("up ", "")
    mem = sh("free -m").split("\n")[1].split() if sh("free -m") else []
    ram = f"{int(mem[6]) / 1024:.1f} of {int(mem[1]) / 1024:.0f} GB free" if len(mem) > 6 else "?"
    disks = []
    for mnt in ("/", "/home"):
        try:
            u = shutil.disk_usage(mnt)
            disks.append((mnt, u.free / u.total, u.free / 1e9))
        except OSError:
            pass
    seen, dl = set(), []
    for mnt, frac, gb in disks:
        if round(gb) in seen:
            continue
        seen.add(round(gb))
        dl.append(f"`{mnt}` {gb:.0f} GB free ({frac * 100:.0f} %)")
    bat = ""
    for b in glob.glob("/sys/class/power_supply/BAT*/capacity"):
        st = open(b.replace("capacity", "status")).read().strip()
        bat = f", battery {open(b).read().strip()} % ({st.lower()})"
    kernel = os.uname().release
    return (f"{host}, kernel {kernel}, up {up}, RAM {ram}, " + ", ".join(dl) + bat,
            [f"disk {m} has only {f * 100:.0f} % free" for m, f, g in disks if f < 0.10])


def repos(c):
    roots = paths(c.get("repos", "roots", fallback="~/Projects ~/dotfiles"))
    found = []
    for root in roots:
        for g in sorted(glob.glob(os.path.join(root, "**", ".git"), recursive=True)):
            if "node_modules" in g or g.count(os.sep) - root.count(os.sep) > 5:
                continue
            found.append(os.path.dirname(g))
    rows, attention = [], []
    for r in found:
        st = sh(["git", "-C", r, "status", "--porcelain=v1", "-b"]).splitlines()
        if not st:
            continue
        head = st[0][3:]
        branch = head.split("...")[0]
        ahead = re.search(r"ahead (\d+)", head)
        changed = len(st) - 1
        last = sh(["git", "-C", r, "log", "-1", "--format=%ct\t%s"]).strip().split("\t", 1)
        ts = int(last[0]) if last and last[0].isdigit() else 0
        subj = last[1][:60] if len(last) > 1 else ""
        md = "yes" if os.path.exists(os.path.join(r, "CLAUDE.md")) else ""
        rows.append((ts, short(r), branch, changed, int(ahead.group(1)) if ahead else 0, subj, md))
        if changed or ahead:
            attention.append(f"`{short(r)}`: " + ", ".join(
                x for x in (f"{changed} uncommitted" if changed else "", f"{ahead.group(1)} unpushed" if ahead else "") if x))
    rows.sort(reverse=True)
    lines = ["| Repo | Branch | Uncommitted | Unpushed | Last commit | CLAUDE.md |", "|---|---|---|---|---|---|"]
    for ts, p, b, ch, ah, subj, md in rows:
        lines.append(f"| `{p}` | {b} | {ch or ''} | {ah or ''} | {ago(ts) if ts else '?'} ago: {subj} | {md} |")
    return "\n".join(lines), rows, attention


def frontmatter(path):
    try:
        text = open(path, encoding="utf-8", errors="ignore").read(3000)
    except OSError:
        return {}
    m = re.match(r"---\n(.*?)\n---", text, re.S)
    if not m:
        return {}
    out = {}
    for line in m.group(1).splitlines():
        if ":" in line and not line.startswith(" "):
            k, v = line.split(":", 1)
            out[k.strip()] = v.strip().strip('"')
    return out


def deadlines(c):
    roots = paths(c.get("deadlines", "notes", fallback=""))
    items = []
    for root in roots:
        for f in glob.glob(os.path.join(root, "**", "*.md"), recursive=True):
            fm = frontmatter(f)
            if fm.get("type") not in ("assignment", "test", "project", "exam") or fm.get("status") == "done":
                continue
            items.append((fm.get("due") or "", fm.get("subject", ""), os.path.splitext(os.path.basename(f))[0],
                          fm.get("type"), fm.get("status", ""), short(f)))
    items.sort(key=lambda x: (x[0] == "", x[0]))
    today = date.today()
    lines = ["| Due | Subject | What | Type | Status | Note |", "|---|---|---|---|---|---|"]
    soon = []
    for due, subj, name, typ, st, f in items:
        tag = ""
        try:
            d = (date.fromisoformat(due) - today).days
            tag = "overdue" if d < 0 else f"in {d} d"
            if d <= 7:
                soon.append(f"{subj} {name}: {due} ({tag})")
        except ValueError:
            pass
        lines.append(f"| {due or 'no date'} {tag} | {subj} | {name} | {typ} | {st} | `{f}` |")
    return "\n".join(lines), soon, sum(1 for i in items if not i[0])


def keybinds(c):
    out = ["| Keys | What |", "|---|---|"]
    for f in paths(c.get("desktop", "keybinds", fallback="")):
        try:
            text = open(f, encoding="utf-8").read()
        except OSError:
            continue
        for m in re.finditer(r'hl\.bind\(\s*mod \.\. "([^"]+)"[^\n]*?(?:\n[^\n]*?)?description = "([^"]+)"', text):
            out.append(f"| SUPER{m.group(1)} | {m.group(2)} |")
    return "\n".join(out), len(out) - 2


def tools(c):
    out = []
    dirs = paths(c.get("desktop", "tools", fallback="~/.local/bin"))
    for d in dirs:
        for f in sorted(glob.glob(os.path.join(d, "*"))):
            if not os.access(f, os.X_OK) or os.path.isdir(f):
                continue
            desc = ""
            try:
                with open(f, "rb") as fb:
                    head = fb.read(2048)
                if head.startswith(b"\x7fELF") or b"\0" in head:
                    out.append(f"- `{short(f)}`: (binary)")
                    continue
                if True:
                    for line in head.decode("utf-8", "ignore").splitlines()[:12]:
                        s = line.strip()
                        if s.startswith("#!") or not s:
                            continue
                        if s.startswith(("#", '"""', "//")):
                            desc = s.lstrip('#"/ ').strip()
                            if desc:
                                break
                        else:
                            break
            except (OSError, UnicodeDecodeError):
                pass
            out.append(f"- `{short(f)}`: {desc[:110]}")
    return "\n".join(out), len(out)


def packages():
    explicit = sh("pacman -Qeq").split()
    foreign = set(sh("pacman -Qmq").split())
    return (f"{len(explicit)} explicitly installed ({len(foreign)} from the AUR).\n\n" +
            " ".join(f"{p}{'*' if p in foreign else ''}" for p in explicit) + "\n\n`*` = AUR"), len(explicit)


def services():
    failed_sys = [l.split()[0] for l in sh("systemctl --failed --no-legend --plain").splitlines() if l.strip()]
    failed_usr = [l.split()[0] for l in sh("systemctl --user --failed --no-legend --plain").splitlines() if l.strip()]
    usr = [l.split()[0] for l in sh("systemctl --user list-unit-files --state=enabled --no-legend").splitlines() if l.strip()]
    sysd = [l.split()[0] for l in sh("systemctl list-unit-files --state=enabled --no-legend").splitlines() if l.strip()]
    timers = [l.split()[-2] for l in sh("systemctl list-timers --all --no-legend").splitlines() if l.strip()]
    md = (f"Failed: {', '.join(failed_sys + failed_usr) or 'none'}\n\n"
          f"User units enabled: {', '.join(usr)}\n\nSystem units enabled: {', '.join(sysd)}\n\n"
          f"Timers: {', '.join(timers)}")
    return md, [f"failed unit {u}" for u in failed_sys] + [f"failed user unit {u}" for u in failed_usr]


def recent(rows):
    cutoff = time.time() - 7 * 86400
    out = []
    for ts, p, b, ch, ah, subj, md in rows:
        if ts < cutoff:
            continue
        r = os.path.expanduser(p.replace("~", HOME, 1)) if p.startswith("~") else p
        log = sh(["git", "-C", r, "log", f"--since={int(cutoff)}", "--format=%cd %s", "--date=format:%a %H:%M"])
        n = len(log.splitlines())
        out.append(f"### `{p}` ({n} commits)\n" + "\n".join(f"- {l[:110]}" for l in log.splitlines()[:8]))
    return "\n\n".join(out) or "No commits in the last 7 days."


def sessions():
    claude = shutil.which("claude") or os.path.join(HOME, ".local/bin/claude")
    try:
        j = json.loads(sh([claude, "agents", "--json"], timeout=15) or "[]")
    except ValueError:
        j = []
    out = ["| Name | Kind | State | Folder |", "|---|---|---|---|"]
    for s in j:
        out.append(f"| {s.get('name', '')} | {s.get('kind', '')} | {s.get('state') or s.get('status') or ''} | "
                   f"`{short(s.get('cwd', ''))}` |")
    return "\n".join(out), len(j)


def threads():
    out = []
    for f in sorted(glob.glob(os.path.join(THREADS, "*.md"))):
        fm = frontmatter(f)
        out.append((fm.get("status", "?"), fm.get("name", os.path.basename(f)[:-3]), fm.get("model", ""),
                    short(fm.get("folder", "")), fm.get("updated", "")))
    return out


def homelab(c):
    note = os.path.expanduser(c.get("homelab", "note", fallback=""))
    if not note or not os.path.exists(note):
        return ""
    text = open(note, encoding="utf-8", errors="ignore").read(6000)
    m = re.search(r"Last verified[^\n]*", text)
    return (m.group(0).replace("**", "")[:220] if m else "") + f" (details: `{short(note)}`)"


def homelab_agent():
    """The homelab agent's reports and usage through `homelab-agent` (ssh with a short timeout and a cache).
    Returns (topic markdown, index line, attention) or None when it isn't set up."""
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "homelab-agent")
    if not os.access(exe, os.X_OK):
        exe = shutil.which("homelab-agent")
    if not exe:
        return None
    d = json.loads(sh([exe, "json"], timeout=4) or "{}")
    if not d.get("_host"):
        return None
    topic = sh([exe, "--offline"], timeout=4).strip()
    seen = d.get("_seen") or 0
    attention = []
    if not seen:
        line = f"Agent: no data yet from `{d['_host']}` ({str(d.get('_error') or '')[:120]})"
    else:
        reps = sorted((r for r in d.get("reports") or [] if isinstance(r, dict)),
                      key=lambda r: str(r.get("time", "")), reverse=True)
        newest = ", ".join(f"{str(r.get('job'))[:30]} {str(r.get('time', ''))[5:16].replace('T', ' ')} "
                           f"{str(r.get('status') or '?')[:6]}" for r in reps[:6])
        cost = {"today": 0.0, "week": 0.0}
        runs = {"today": 0, "week": 0}
        today = date.today()
        for u in d.get("usage") or []:
            try:
                day = date.fromisoformat(str(u[0])[:10])
                c = float(u[5] or 0)
            except (ValueError, TypeError, IndexError):
                continue
            for k, n in (("today", 0), ("week", 6)):
                if (today - day).days <= n:
                    cost[k] += c
                    runs[k] += 1
        def n(k):
            return f"{runs[k]} run{'' if runs[k] == 1 else 's'} ${cost[k]:.2f}"
        line = (f"Agent, last seen {ago(seen)} ago: {n('today')} today, {n('week')} in 7 days. Newest: {newest or 'none'} (`atlas homelab`)")
        for r in reps:
            try:
                t = datetime.fromisoformat(str(r.get("time")))
            except ValueError:
                continue
            if r.get("status") == "ALERT" and time.time() - t.timestamp() < 86400:
                attention.append(f"homelab agent: {str(r.get('job'))[:30]} ALERT at {t:%H:%M} "
                                 f"(`homelab-agent report {str(r.get('job'))[:30]}`)")
        if time.time() - seen > 2 * 86400:
            attention.append(f"homelab agent data is {ago(seen)} old (`homelab-agent --refresh`)")
    return topic, line, attention


def areas(c):
    """The areas: from the "## Areas" list of a CLAUDE.md (areas_from in atlas.conf), so they're kept in one
    place; a [areas] section in atlas.conf (path | description) works too."""
    out = []
    src = os.path.expanduser(c.get("atlas", "areas_from", fallback=""))
    if src and os.path.exists(src):
        text = open(src, encoding="utf-8").read()
        m = re.search(r"^## Areas\n(.*?)(?=^## |\Z)", text, re.S | re.M)
        # Join wrapped lines back onto their bullet.
        block = re.sub(r"\n\s+(?=\S)", " ", m.group(1) if m else "")
        for line in block.splitlines():
            mm = re.match(r"- `([^`]+)`[^:]*:\s*(.*)", line)
            if not mm:
                continue
            p = os.path.expanduser(re.sub(r"/<[^>]+>.*$", "", mm.group(1)))
            desc = mm.group(2)
            out.append((p, desc if len(desc) <= 160 else desc[:157].rsplit(" ", 1)[0] + " …"))
    if c.has_section("areas"):
        for name, val in c.items("areas"):
            path, _, desc = val.partition("|")
            out.append((os.path.expanduser(path.strip()), f"{name}: {desc.strip()}"))
    return out


# ---------------------------------------------------------------- build

def write(name, body):
    with open(os.path.join(OUT, name + ".md"), "w", encoding="utf-8") as f:
        f.write(f"<!-- atlas {name}, generated {datetime.now():%Y-%m-%d %H:%M} -->\n{body}\n")


def refresh():
    os.makedirs(OUT, exist_ok=True)
    c = conf()
    attention, stale, facts = [], [], {}

    def run(name, fn, *a):
        try:
            return fn(*a)
        except Exception as e:  # one broken collector must not break the map
            stale.append(f"{name} ({type(e).__name__})")
            return None

    from concurrent.futures import ThreadPoolExecutor
    pool = ThreadPoolExecutor(max_workers=8)
    fut = {n: pool.submit(run, n, f, *a) for n, f, a in (
        ("machine", machine, ()), ("repos", repos, (c,)), ("deadlines", deadlines, (c,)),
        ("keybinds", keybinds, (c,)), ("tools", tools, (c,)), ("packages", packages, ()),
        ("services", services, ()), ("sessions", sessions, ()), ("threads", threads, ()),
        ("homelab", homelab, (c,)), ("homelab-agent", homelab_agent, ()))}
    got = {n: f.result() for n, f in fut.items()}
    m = got["machine"]
    if m:
        facts["machine"] = m[0]
        attention += m[1]
    r = got["repos"]
    rows = []
    if r:
        write("repos", r[0])
        rows = r[1]
        facts["repos"] = len(rows)
        attention += r[2][:8] + ([f"... and {len(r[2]) - 8} more repos with changes"] if len(r[2]) > 8 else [])
    d = got["deadlines"]
    if d:
        write("deadlines", d[0])
        attention += [f"deadline {x}" for x in d[1]]
        facts["undated"] = d[2]
    k = got["keybinds"]
    if k:
        write("keybinds", k[0])
        facts["keybinds"] = k[1]
    t = got["tools"]
    if t:
        write("tools", t[0])
        facts["tools"] = t[1]
    p = got["packages"]
    if p:
        write("packages", p[0])
        facts["packages"] = p[1]
    s = got["services"]
    if s:
        write("services", s[0])
        attention += s[1]
    if rows:
        rc = run("recent", recent, rows)
        if rc:
            write("recent", rc)
    se = got["sessions"]
    if se:
        write("sessions", se[0])
        facts["sessions"] = se[1]
    th = got["threads"] or []
    hl = got["homelab"] or ""
    ha = got["homelab-agent"]
    if ha:
        write("homelab", ha[0])
        attention += ha[2]

    lines = [f"# Atlas of {socket.gethostname()}", f"Generated {datetime.now():%a %Y-%m-%d %H:%M} by `atlas refresh` "
             f"(code, no AI). Details: `atlas <topic>` with topics {', '.join(TOPICS)}.", ""]
    if stale:
        lines += [f"**Stale:** {', '.join(stale)} (collector failed; older detail files kept).", ""]
    lines += ["## Machine", facts.get("machine", "?"), ""]
    lines += ["## Needs attention"] + ([f"- {a}" for a in attention] or ["- nothing"]) + [""]
    lines += ["## Threads"]
    if th:
        lines += [f"- **{n}** ({st}, {mo}) in `{fo}`" + (f", updated {u}" if u else "") for st, n, mo, fo, u in th]
    else:
        lines += ["- none yet (`thread list`)"]
    lines += [""]
    ar = areas(c)
    if ar:
        lines += ["## Areas (each has its own rules; read its CLAUDE.md before working there)"]
        for p, desc in ar:
            md = " (CLAUDE.md)" if os.path.exists(os.path.join(p, "CLAUDE.md")) else ""
            lines.append(f"- `{short(p)}`{md}: {desc}")
        lines += [""]
    if hl or ha:
        lines += ["## Homelab", "\n\n".join(x for x in (hl, ha[1] if ha else "") if x), ""]
    lines += ["## Counts",
              f"{facts.get('repos', '?')} repos (`atlas repos`), {facts.get('packages', '?')} explicit packages, "
              f"{facts.get('keybinds', '?')} keybinds, {facts.get('tools', '?')} own commands (`atlas tools`), "
              f"{facts.get('sessions', '?')} Claude sessions open (`atlas sessions`), "
              f"{facts.get('undated', '?')} school tasks without a date (`atlas deadlines`)."]
    write("index", "\n".join(lines))


# ---- atlas queue: what waits on the owner ---------------------------------------------------------------

WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]


def days_text(d):
    return "today" if d == 0 else "tomorrow" if d == 1 else f"in {d} days"


def school_refresh():
    """Moodle's open and late work into the cache, then `moodle sync` so the tracker notes are current.
    Slow (list --all takes about 15 s), so `atlas queue` runs it in the background."""
    exe = shutil.which("moodle")
    if not exe:
        return
    keep = ("cmid", "name", "course", "subject", "year", "due", "state", "graded", "grade", "url")
    try:
        raw = json.loads(sh([exe, "list", "--all", "--json"], timeout=90) or "null")
        due = json.loads(sh([exe, "due", "--json"], timeout=60) or "null")
    except ValueError:
        raw = due = None
    if not isinstance(raw, list) or not isinstance(due, dict):
        return   # Moodle didn't answer: the old cache stays
    data = {"ts": time.time(), "all": [{k: x.get(k) for k in keep} for x in raw],
            "due": [{k: x.get(k) for k in ("cmid", "name", "course", "subject", "due_ts", "overdue", "url")}
                    for x in due.get("items") or []]}
    os.makedirs(CACHE, exist_ok=True)
    with open(SCHOOL_CACHE + ".tmp", "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(SCHOOL_CACHE + ".tmp", SCHOOL_CACHE)
    sh([exe, "sync"], timeout=180)


def school_cache():
    """The cached Moodle data; starts a background refresh when it is missing or older than 6 hours."""
    try:
        data = json.load(open(SCHOOL_CACHE, encoding="utf-8"))
    except (OSError, ValueError):
        data = None
    if not data or time.time() - data.get("ts", 0) > SCHOOL_MAX_AGE:
        lock = SCHOOL_CACHE + ".lock"
        try:
            fresh_lock = time.time() - os.path.getmtime(lock) < 600
        except OSError:
            fresh_lock = False
        if not fresh_lock and shutil.which("moodle"):
            os.makedirs(CACHE, exist_ok=True)
            open(lock, "w").close()
            subprocess.Popen(["bash", "-c", f'"$0" queue --refresh-school; rm -f "{lock}"', os.path.realpath(__file__)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
    return data


def trackers(c):
    """School tracker notes: {cmid: (status, path)} and the notes without a Moodle id."""
    by_id, other = {}, []
    for root in paths(c.get("deadlines", "notes", fallback="")):
        for f in glob.glob(os.path.join(root, "**", "*.md"), recursive=True):
            fm = frontmatter(f)
            if fm.get("type") not in ("assignment", "test", "project", "exam"):
                continue
            cmid = fm.get("cmid") or fm.get("moodle") or ""
            if cmid.isdigit():
                by_id[int(cmid)] = (fm.get("status", ""), f)
            else:
                other.append((fm, f))
    return by_id, other


def school_items(c):
    items = []
    by_id, other = trackers(c)
    closed = ("done", "dropped")
    data = school_cache()
    now = time.time()
    today = date.today()
    if data:
        alls = data.get("all") or []
        # My class: the most common class in course names ("AM 5BHIT 26/27"); entries for the parallel
        # classes ("... 5AHIT") are left out.
        classes = {}
        for x in alls:
            for k in re.findall(r"\b(\d[A-Z]HIT)\b", x.get("course") or ""):
                if k[1] != "X":
                    classes[k] = classes.get(k, 0) + 1
        mine = max(classes, key=classes.get) if classes else ""

        def other_class(x):
            return mine and any(k != mine for k in re.findall(r"\b(\d[A-Z]HIT)\b", x.get("name") or ""))

        def closed_in_tracker(cmid):
            return by_id.get(cmid, ("",))[0] in closed

        year = max((x.get("year") or "" for x in alls), default="")
        timeline = {x["cmid"] for x in data.get("due") or []}
        late, untracked = [], 0
        for x in alls:
            if x.get("year") != year or not x.get("due") or x["due"] >= now or not x.get("subject"):
                continue
            if x.get("state") != "new" or (x.get("graded") and x.get("grade")) or other_class(x):
                continue
            if closed_in_tracker(x["cmid"]):
                continue
            if x["cmid"] in by_id or x["cmid"] in timeline:
                late.append(x)
            else:
                untracked += 1
        for x in sorted(late, key=lambda x: x["due"]):
            d = (today - date.fromtimestamp(x["due"])).days
            items.append({"source": "school", "level": "late", "text": subject_name(x['subject'], x['name']),
                          "detail": f"{d} day{'s' if d != 1 else ''} late (due {date.fromtimestamp(x['due']):%m-%d})",
                          "url": x.get("url"), "tracker": short(by_id[x["cmid"]][1]) if x["cmid"] in by_id else None})
        for x in sorted(data.get("due") or [], key=lambda x: x.get("due_ts") or 0):
            if x.get("overdue") or not x.get("due_ts") or other_class(x) or closed_in_tracker(x["cmid"]):
                continue
            dd = datetime.fromtimestamp(x["due_ts"])
            d = (dd.date() - today).days
            if d > 3 or x["due_ts"] < now:
                continue
            items.append({"source": "school", "level": "due", "text": subject_name(x['subject'], x['name']),
                          "detail": f"due {days_text(d)} {dd:%H:%M}", "url": x.get("url"),
                          "tracker": short(by_id[x["cmid"]][1]) if x["cmid"] in by_id else None})
        if untracked:
            items.append({"source": "school", "level": "info", "text": f"{untracked} more late in Moodle without a "
                          "tracker note or a place in Moodle's timeline", "detail": "moodle list --all"})
        age = now - data.get("ts", 0)
        if age > SCHOOL_MAX_AGE:
            items.append({"source": "school", "level": "info", "text": f"Moodle data is {ago(data.get('ts', 0))} old",
                          "detail": "refreshing in the background"})
    # Tracker notes that Moodle doesn't know (or all of them while there is no Moodle data yet).
    for fm, f in other + ([] if data else [(frontmatter(p), p) for _, p in by_id.values()]):
        if fm.get("status") in closed:
            continue
        try:
            d = (date.fromisoformat(fm.get("due", "")) - today).days
        except ValueError:
            continue
        if d > 3:
            continue
        name = os.path.splitext(os.path.basename(f))[0]
        items.append({"source": "school", "level": "late" if d < 0 else "due", "text": subject_name(fm.get('subject', ''), name),
                      "detail": (f"{-d} days late (due {fm['due'][5:]})" if d < 0 else f"due {days_text(d)}")
                      + (", tracker note only" if data else ", from the tracker note (no Moodle data yet)"),
                      "tracker": short(f)})
    # Notes about the data itself go last.
    return [i for i in items if i["level"] != "info"] + [i for i in items if i["level"] == "info"]


def subject_name(subject, name):
    return name if not subject or name.lower().startswith(subject.lower()) else f"{subject} {name}"


def thread_items():
    items = []
    for f in sorted(glob.glob(os.path.join(THREADS, "*.md"))):
        fm = frontmatter(f)
        name = fm.get("name") or os.path.basename(f)[:-3]
        if fm.get("status") == "archived":
            continue
        q = None
        try:
            q = json.load(open(f[:-3] + ".questions.json", encoding="utf-8"))
        except (OSError, ValueError):
            pass
        if q and q.get("questions") and not q.get("answers"):
            n = len(q["questions"])
            items.append({"source": "thread", "level": "questions", "text": f"{name}: {n} question{'s' if n > 1 else ''}",
                          "detail": f"thread questions {name}", "since": q.get("asked")})
        elif fm.get("needs"):
            items.append({"source": "thread", "level": "needs", "text": f"{name}: {fm['needs']}",
                          "detail": f"thread status {fm.get('status', '?')}"})
    return items


def since_text(text, at):
    """"since Tue 09:50" or "since 2026-11-17" in a report, as "for N days"."""
    m = re.search(r"since (?:(\d{4}-\d\d-\d\d)|(mon|tue|wed|thu|fri|sat|sun)\w*\.?(?: (\d\d?:\d\d))?)", text, re.I)
    if not m:
        return ""
    try:
        if m.group(1):
            start = datetime.fromisoformat(m.group(1))
        else:
            wd = WEEKDAYS.index(m.group(2).lower()[:3])
            back = (at.weekday() - wd) % 7
            hh, mm = (m.group(3) or "00:00").split(":")
            start = (at - __import__("datetime").timedelta(days=back)).replace(hour=int(hh), minute=int(mm))
    except ValueError:
        return ""
    hours = (datetime.now() - start).total_seconds() / 3600
    return f"for {hours / 24:.0f} days" if hours >= 36 else f"for {hours:.0f} h"


def homelab_items():
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "homelab-agent")
    if not os.access(exe, os.X_OK):
        exe = shutil.which("homelab-agent")
    if not exe:
        return []
    try:
        d = json.loads(sh([exe, "json"], timeout=4) or "{}")
    except ValueError:
        return []
    items = []
    for r in sorted((r for r in d.get("reports") or [] if isinstance(r, dict)),
                    key=lambda r: (r.get("status") != "ALERT", str(r.get("time", "")))):
        if r.get("status") not in ("ALERT", "WARN"):
            continue
        try:
            at = datetime.fromisoformat(str(r.get("time")))
        except ValueError:
            continue
        if r.get("status") == "WARN" and (datetime.now() - at).days >= 3:
            continue   # an old warning of a weekly job: `atlas homelab` has it
        job = str(r.get("job"))[:30]
        if r["status"] == "WARN":
            # A warning sits somewhere in a longer report (the morning one starts with the weather): name it only.
            items.append({"source": "homelab", "level": "warn", "text": job,
                          "detail": f"report {at:%a %H:%M}, `homelab-agent report {job}`"})
            continue
        para = " ".join(str(r.get("text") or "").split("\n\n")[0].split())
        first = re.split(r"(?<=[.!?])\s", para, maxsplit=1)[0][:140]
        dur = since_text(para, at)
        items.append({"source": "homelab", "level": "alert", "text": f"{job}: {first}",
                      "detail": ", ".join(x for x in (dur, f"report {at:%a %H:%M}") if x)})
    return items


def plan_items(c):
    note = os.path.expanduser(c.get("queue", "plan", fallback=""))
    head = c.get("queue", "plan_section", fallback="Waiting on me")
    if not note or not os.path.exists(note):
        return []
    items, on = [], False
    for line in open(note, encoding="utf-8", errors="ignore"):
        s = line.strip()
        if head.lower() in s.lower() and (s.startswith("#") or s.startswith("**")):
            on = True
            continue
        if on and (s.startswith("#") or (s.startswith("**") and not s.startswith("- "))):
            break
        if on and re.match(r"[-*] (\[ \] )?", s) and not re.match(r"[-*] \[[xX]\]", s) and not s.startswith("- ~~"):
            items.append({"source": "plan", "level": "todo", "text": re.sub(r"^[-*] (\[ \] )?", "", s)[:160],
                          "detail": short(note)})
    return items


def session_items():
    claude = shutil.which("claude") or os.path.join(HOME, ".local/bin/claude")
    try:
        j = json.loads(sh([claude, "agents", "--json"], timeout=10) or "[]")
    except ValueError:
        j = []
    return [{"source": "session", "level": "blocked", "text": f"{s.get('name', '?')} ({s.get('kind', '')})",
             "detail": f"blocked in `{short(s.get('cwd', ''))}`"}
            for s in j if (s.get("state") or s.get("status")) == "blocked"]


def queue(as_json=False):
    c = conf()
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=5) as pool:
        futs = [pool.submit(f, *a) for f, a in ((school_items, (c,)), (thread_items, ()), (homelab_items, ()),
                                                 (plan_items, (c,)), (session_items, ()))]
        groups = []
        for f in futs:
            try:
                groups.append(f.result())
            except Exception as e:
                groups.append([{"source": "atlas", "level": "info", "text": f"a queue source failed ({type(e).__name__})",
                                "detail": ""}])
    items = [i for g in groups for i in g]
    if as_json:
        print(json.dumps({"generated": datetime.now().isoformat(timespec="seconds"), "items": items},
                         ensure_ascii=False))
        return
    titles = {"school": "School", "thread": "Threads", "homelab": "Homelab", "plan": "Plan (waiting on me)",
              "session": "Sessions"}
    print(f"What waits on the owner ({datetime.now():%a %H:%M}, `atlas queue`):" if items
          else "Nothing waits on the owner (`atlas queue`).")
    for src in ("school", "thread", "homelab", "plan", "session", "atlas"):
        g = [i for i in items if i["source"] == src]
        if not g:
            continue
        print(f"{titles.get(src, src)}:")
        for i in g:
            lvl = {"late": "LATE ", "due": "", "questions": "", "needs": "", "alert": "ALERT ", "warn": "WARN ",
                   "todo": "", "blocked": "", "info": ""}.get(i["level"], "")
            print(f"- {lvl}{i['text']}" + (f" ({i['detail']})" if i.get("detail") and src != "plan" else ""))


def main():
    a = sys.argv[1:] or ["index"]
    if a[0] in ("-h", "--help", "help"):
        print(__doc__)
    elif a[0] == "refresh":
        t = time.time()
        refresh()
        print(f"atlas refreshed in {time.time() - t:.1f} s: {short(OUT)}")
    elif a[0] == "queue":
        if "--refresh-school" in a:
            school_refresh()
        else:
            queue("--json" in a)
    elif a[0] == "topics":
        print(" ".join(TOPICS))
    else:
        f = os.path.join(OUT, a[0] + ".md")
        if not os.path.exists(os.path.join(OUT, "index.md")):
            refresh()
        if not os.path.exists(f):
            sys.exit(f"No topic '{a[0]}'. Topics: {' '.join(TOPICS)}")
        sys.stdout.write(open(f, encoding="utf-8").read())


if __name__ == "__main__":
    main()
