#!/usr/bin/env python3
"""Claude Code usage from the local transcripts, priced at API rates as a stand-in for plan usage.

  claude-usage [report] [--days N]     cost per day, model, project and session, by context size and kind
                                       of session, and since the weekly reset next to the meter (default 7 days)
  claude-usage calibrate               what 1 % of the 5-hour and weekly limit is worth: everything spent
                                       since the window started, divided by the meter's percent (status
                                       line history in ~/.local/state/agentic/usage.log); from 5 % on,
                                       below that the last good value, then $13
  claude-usage estimate --agents N [--model opus|sonnet|haiku|fable]
                                       what a fan-out of N agents costs, from past agents' average
  claude-usage session <id-prefix>     cost of one session (with its agents); a full id is fast,
                                       and with --json prints {"dollars", "week_percent"}

Plan limits are not published in tokens. API prices are only a proxy; `calibrate` checks how
well it fits. Usage outside these transcripts (another machine) is not seen, except the homelab
agent: `homelab-agent` reads its usage over ssh (cached), shown as its own block with its own cost
figure (Claude Code's total_cost_usd), and counted in `calibrate` since it uses the same plan.
"""
import argparse
import glob
import json
import os
import statistics
import subprocess
import sys
import time
from collections import defaultdict
from datetime import datetime

# $ per million tokens: input, output, cache read, cache write 5 min, cache write 1 h
PRICES = {
    "fable": (8.0, 40.0, 0.20, 10.0, 16.0),
    "opus": (4.0, 20.0, 0.20, 5.0, 8.0),
    "sonnet": (2.0, 10.0, 0.10, 2.5, 4.0),
    "haiku": (0.10, 0.50, 0.01, 0.125, 0.20),
}
FALLBACK_PER_PERCENT = 13.0   # $ per 1 % of the weekly limit, measured 2026-11-18
PROJECTS = os.path.expanduser("~/.claude/projects")
LOG = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "agentic", "usage.log")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "agentic", "claude-usage-calibration.json")


def family(model):
    for k in PRICES:
        if k in (model or ""):
            return k
    return None


def price(fam, inp, out, read, w5, w1):
    p = PRICES[fam]
    return (inp * p[0] + out * p[1] + read * p[2] + w5 * p[3] + w1 * p[4]) / 1e6


def session_files(sid):
    """The transcript of one session and its agents' transcripts, found by the full session id (fast path)."""
    return (glob.glob(os.path.join(PROJECTS, "*", sid + ".jsonl"))
            + glob.glob(os.path.join(PROJECTS, "*", sid, "**", "*.jsonl"), recursive=True))


def load(since, files=None):
    """One row per API request since `since`:
    (time, family, dollars, project, session, agent file or '', context tokens of the request)."""
    rows, seen = [], set()
    for f in files if files is not None else glob.glob(os.path.join(PROJECTS, "**", "*.jsonl"), recursive=True):
        try:
            if os.path.getmtime(f) < since:
                continue
            fh = open(f, encoding="utf-8", errors="ignore")
        except OSError:
            continue
        rel = os.path.relpath(f, PROJECTS).split(os.sep)
        project = rel[0]
        agent = f if "subagents" in rel else ""
        session = rel[1][:8] if len(rel) > 2 else os.path.basename(f)[:8]
        with fh:
            for line in fh:
                if '"usage"' not in line:
                    continue
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("type") != "assistant":
                    continue
                m = e.get("message") or {}
                key = (m.get("id"), e.get("requestId"))
                if key in seen:
                    continue
                seen.add(key)
                try:
                    t = datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
                except (KeyError, ValueError):
                    continue
                if t < since:
                    continue
                u = m.get("usage") or {}
                fam = family(m.get("model"))
                if fam:
                    cc = u.get("cache_creation") or {}
                    w1 = cc.get("ephemeral_1h_input_tokens") or 0
                    w5 = cc.get("ephemeral_5m_input_tokens") or (0 if cc else u.get("cache_creation_input_tokens") or 0)
                    d = price(fam, u.get("input_tokens") or 0, u.get("output_tokens") or 0,
                              u.get("cache_read_input_tokens") or 0, w5, w1)
                    ctx = ((u.get("input_tokens") or 0) + (u.get("cache_read_input_tokens") or 0)
                           + (u.get("cache_creation_input_tokens") or 0))
                    rows.append((t, fam, d, project, session, agent, ctx))
                # The advisor runs as a separate model inside the same request.
                for it in u.get("iterations") or []:
                    if it.get("type") == "advisor_message" and family(it.get("model")):
                        fa = family(it.get("model"))
                        d = price(fa, it.get("input_tokens") or 0, it.get("output_tokens") or 0,
                                  it.get("cache_read_input_tokens") or 0, it.get("cache_creation_input_tokens") or 0, 0)
                        rows.append((t, fa + " (advisor)", d, project, session, agent, 0))
    return rows


_PI = None


def pi_usage():
    """The homelab agent's runs: (time, model, dollars, job), plus the export's info. Cached per process."""
    global _PI
    if _PI is None:
        exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "homelab-agent")
        d = {}
        try:
            d = json.loads(subprocess.run([exe, "json"], capture_output=True, text=True, timeout=5).stdout or "{}")
        except (OSError, subprocess.SubprocessError, ValueError):
            pass
        rows = []
        for r in d.get("usage") or []:
            try:
                t = datetime.fromisoformat(str(r[0])).timestamp()
                rows.append((t, str(r[7] if len(r) > 7 and r[7] else "?")[:20], float(r[5] or 0), str(r[1])[:40]))
            except (ValueError, TypeError, IndexError):
                continue
        try:
            gen = datetime.fromisoformat(str(d.get("generated"))).timestamp()
        except (TypeError, ValueError):
            gen = 0
        _PI = (rows, d, gen)
    return _PI


def per_percent(which="week"):
    """$ per 1 % of the weekly (or 5-hour) limit: the window measurement, else its last good value, else the
    fallback. Cached for 15 minutes, so `thread progress` stays fast."""
    c = load_cache()
    if time.time() - c.get("checked", 0) > 900:
        calibrate_values()
        c = load_cache()
    return c.get(which) or (FALLBACK_PER_PERCENT if which == "week" else FALLBACK_PER_PERCENT / 7)


def load_cache():
    try:
        return json.load(open(CACHE))
    except (OSError, ValueError):
        return {}


def save_cache(c):
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        json.dump(c, open(tmp, "w"))
        os.replace(tmp, CACHE)
    except OSError:
        pass


def read_log():
    out = []
    try:
        for line in open(LOG):
            p = line.split()
            if len(p) == 5:
                out.append(tuple(float(x) if x else 0 for x in p))
    except OSError:
        pass
    return out


def window_reading(log, ip, ia):
    """The current window of one meter: (start-independent reset time, highest value, time it applied).
    Idle sessions keep writing stale readings (lower values, or the previous window's reset time), so the
    newest reset time and the highest value in it are the real state. The time is the middle of the span in
    which that highest value was seen, since the meter shows whole percent."""
    resets = [r[ia] for r in log if r[ia]]
    if not resets:
        return None
    reset = max(resets)
    vals = [r for r in log if r[ia] == reset]
    top = max(r[ip] for r in vals)
    seen = [r[0] for r in vals if r[ip] == top]
    return reset, top, (min(seen) + max(seen)) / 2


def calibrate_values(verbose=False):
    """$ per 1 % from the window itself: everything spent since the window started (laptop transcripts plus
    the homelab agent) divided by the meter's percent. Used when the meter shows 5 % or more; below that the
    last good value stays (cache), then the fallback. The old step median is printed only as a cross-check."""
    log = read_log()
    cache = load_cache()
    result = {}
    if log:
        pi, _, gen = pi_usage()
        for name, ip, ia, length in (("5h", 1, 2, 5 * 3600), ("week", 3, 4, 7 * 86400)):
            w = window_reading(log, ip, ia)
            if not w:
                continue
            reset, top, at = w
            start = reset - length
            if top < 5:
                if verbose:
                    print(f"{name:5} meter at {top:.0f} %, too low to measure; keeping "
                          f"{'$%.2f' % cache[name] if cache.get(name) else 'the fallback'}")
                continue
            laptop = sum(r[2] for r in load(start) if r[0] <= at)
            home = sum(d for t, m, d, j in pi if start <= t <= at)
            result[name] = (laptop + home) / top
            if verbose:
                print(f"{name:5} 1 % ≈ ${result[name]:.2f}  (${laptop + home:.0f} since "
                      f"{datetime.fromtimestamp(start):%a %m-%d %H:%M}, of which homelab agent ${home:.2f}, "
                      f"meter {top:.0f} % at {datetime.fromtimestamp(at):%m-%d %H:%M}; whole percent, so ±{50 / top:.0f} % of this value)")
        if verbose:
            if gen:
                print(f"Homelab agent counted up to its export of {datetime.fromtimestamp(gen):%m-%d %H:%M}.")
            else:
                print("Without the homelab agent (no data from `homelab-agent`), so 1 % is a floor.")
    cache.update(result)
    cache["checked"] = time.time()
    if result:
        cache["measured"] = time.time()
    save_cache(cache)
    if verbose:
        steps = step_values(log)
        if steps:
            print("Cross-check, old step method: " + "  ".join(
                f"{k} ${v[0]:.2f} (median of {v[1]} steps)" for k, v in steps.items()))
        for name in ("5h", "week"):
            if name not in result and cache.get(name):
                print(f"{name:5} using the last good value ${cache[name]:.2f}")
    return {k: cache[k] for k in ("5h", "week") if cache.get(k)}


def step_values(log):
    """The old method: dollars per whole-percent step of the meter, median. Rough; only a cross-check."""
    if len(log) < 2:
        return {}
    rows = load(log[0][0] - 1)
    pi, _, gen = pi_usage()
    rows += [(t, "pi", d, "pi-agent", "", "", 0) for t, m, d, j in pi if t >= log[0][0] - 1]
    result = {}
    for name, ip, ia in (("5h", 1, 2), ("week", 3, 4)):
        ratios, top = [], {}
        for r in log:
            key, val, t = r[ia], r[ip], r[0]
            if key not in top:
                top[key] = (val, t)
                continue
            best, since = top[key]
            if val <= best:
                continue
            dollars = sum(x[2] for x in rows if since <= x[0] < t and (t <= gen or x[1] != "pi"))
            if dollars > 0:
                ratios.append(dollars / (val - best))
            top[key] = (val, t)
        if ratios:
            result[name] = (statistics.median(ratios), len(ratios))
    return result


def cmd_report(days):
    since = time.time() - days * 86400
    rows = load(since)
    ppp = per_percent()
    if not rows:
        print("Laptop: no usage in that period.")
        report_pi(since, days, 0.0, ppp)
        return
    total = sum(r[2] for r in rows)
    print(f"Laptop (Claude Code transcripts here), last {days} days: ${total:.2f} API-equivalent ≈ {total / ppp:.1f} % of a week "
          f"(1 % ≈ ${ppp:.2f}{'' if os.path.exists(LOG) and len(read_log()) > 5 else ', not calibrated yet'})")
    day, model, proj, sess = defaultdict(float), defaultdict(float), defaultdict(float), defaultdict(float)
    agents = 0.0
    for t, fam, d, project, session, agent, _ctx in rows:
        day[datetime.fromtimestamp(t).strftime("%a %m-%d")] += d
        model[fam] += d
        proj[project.replace("-home-" + os.environ.get("USER", ""), "~")] += d
        sess[session] += d
        if agent:
            agents += d
    print("\nPer day:  " + "  ".join(f"{k} {v / ppp:.1f}%" for k, v in sorted(day.items(), key=lambda x: x[0][4:])))
    print("Models:   " + "  ".join(f"{k} {100 * v / total:.0f}%" for k, v in sorted(model.items(), key=lambda x: -x[1])))
    print(f"Agents:   {100 * agents / total:.0f}% of the total")
    print("\nFolders:")
    for k, v in sorted(proj.items(), key=lambda x: -x[1])[:8]:
        print(f"  {v / ppp:5.1f} %  {k}")
    print("\nSessions:")
    titles = session_titles()
    for k, v in sorted(sess.items(), key=lambda x: -x[1])[:8]:
        print(f"  {v / ppp:5.1f} %  {k}  {titles.get(k, '')[:60]}")
    report_context(rows, ppp)
    report_pi(since, days, total, ppp)
    report_window(ppp)


def thread_sessions():
    """Session id prefixes (8 chars) of every thread, from the thread state files."""
    out = set()
    base = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "agentic", "threads")
    for f in glob.glob(os.path.join(base, "*.md")):
        try:
            for line in open(f):
                if line.startswith("session:"):
                    out.add(line.split(":", 1)[1].strip()[:8])
                    break
        except OSError:
            pass
    return out


def main_chat_project():
    """The transcript folder of the main chat (Claude Code names it after the working folder)."""
    d = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "agentic", "main")
    return "".join(c if c.isalnum() else "-" for c in d)


def report_context(rows, ppp):
    """Cost by context size of the request (main sessions; agents and the advisor apart) and by kind of session."""
    total = sum(r[2] for r in rows) or 1
    buckets = (("under 100k", 0, 100e3), ("100-240k", 100e3, 240e3), ("240-500k", 240e3, 500e3), ("over 500k", 500e3, 1e12))
    size = defaultdict(lambda: [0, 0.0])
    for t, fam, d, project, session, agent, ctx in rows:
        if agent:
            key = "agents"
        elif "advisor" in fam:
            key = "advisor"
        else:
            key = next(b[0] for b in buckets if b[1] <= ctx < b[2])
        size[key][0] += 1
        size[key][1] += d
    print("\nBy context size of the request (main sessions; agents and advisor apart):")
    for key in [b[0] for b in buckets] + ["agents", "advisor"]:
        n, d = size.get(key, (0, 0.0))
        if n:
            print(f"  {key:11} {n:6} requests  ${d:7.2f}  {100 * d / total:3.0f} %  ${d / n:.3f} each")
    threads, main = thread_sessions(), main_chat_project()
    kind = defaultdict(float)
    for t, fam, d, project, session, agent, ctx in rows:
        kind["main chat" if project == main else "threads" if session in threads else "plain"] += d
    print("By kind of session (with their agents): " + "  ".join(
        f"{k} {100 * v / total:.0f} % ({v / ppp:.1f} % of a week)" for k, v in sorted(kind.items(), key=lambda x: -x[1])))


def report_window(ppp):
    """Since the weekly reset: what the transcripts add up to, next to what the meter says."""
    w = window_reading(read_log(), 3, 4)
    if not w:
        return
    reset, top, at = w
    start = reset - 7 * 86400
    laptop = sum(r[2] for r in load(start))
    pi, _, _ = pi_usage()
    home = sum(d for t, m, d, j in pi if t >= start)
    print(f"\nSince the weekly reset ({datetime.fromtimestamp(start):%a %m-%d %H:%M}): ${laptop + home:.0f} "
          f"≈ {(laptop + home) / ppp:.1f} % of a week; the meter said {top:.0f} % at {datetime.fromtimestamp(at):%H:%M}")


def report_pi(since, days, laptop, ppp):
    pi, d, gen = pi_usage()
    host = d.get("_host")
    if not host:
        return
    seen = d.get("_seen") or 0
    when = (f"last seen {datetime.fromtimestamp(seen):%m-%d %H:%M}" if seen else "no data yet") + \
           (f", last fetch failed: {str(d['_error'])[:100]}" if d.get("_error") else "")
    print(f"\nHomelab agent on {host} (its own figure: Claude Code's total_cost_usd; {when}):")
    rows = [r for r in pi if r[0] >= since]
    if not rows:
        print("  no runs in that period" if seen else "  nothing to show")
        return
    total = sum(r[2] for r in rows)
    day, model, job = defaultdict(float), defaultdict(float), defaultdict(float)
    for t, m, c, j in rows:
        day[datetime.fromtimestamp(t).strftime("%a %m-%d")] += c
        model[m] += c
        job[j] += c
    print(f"  Last {days} days: ${total:.2f} in {len(rows)} runs ≈ {total / ppp:.1f} % of a week")
    print("  Per day:  " + "  ".join(f"{k} {v / ppp:.2f}%" for k, v in sorted(day.items(), key=lambda x: x[0][4:])))
    if total:
        print("  Models:   " + "  ".join(f"{k} {100 * v / total:.0f}%" for k, v in sorted(model.items(), key=lambda x: -x[1])))
    print("  Jobs:     " + "  ".join(f"{k} ${v:.2f}" for k, v in sorted(job.items(), key=lambda x: -x[1])[:8]))
    both = laptop + total
    print(f"\nBoth: ${both:.2f} ≈ {both / ppp:.1f} % of a week (laptop {100 * laptop / both:.0f} %, "
          f"homelab agent {100 * total / both:.0f} %)" if both else "")


def session_titles():
    out = {}
    for f in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        if os.path.getmtime(f) < time.time() - 30 * 86400:
            continue
        title = ""
        with open(f, encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                if '"custom-title"' in line or '"ai-title"' in line:
                    try:
                        e = json.loads(line)
                        title = e.get("customTitle") or e.get("aiTitle") or title
                    except ValueError:
                        pass
        out[os.path.basename(f)[:8]] = title
    return out


def cmd_estimate(n, model):
    rows = load(time.time() - 30 * 86400)
    per_agent = defaultdict(float)
    fam_of = {}
    for t, fam, d, project, session, agent, _ctx in rows:
        if agent:
            per_agent[agent] += d
            fam_of[agent] = fam
    costs = [v for k, v in per_agent.items() if fam_of[k] == model]
    ppp = per_percent()
    if len(costs) >= 3:
        med, q = statistics.median(costs), statistics.quantiles(costs, n=10)
        lo, hi = q[0], q[8]
        src = f"from {len(costs)} past {model} agents (last 30 days)"
    else:
        # Too few own runs: scale the Opus figures by price.
        base = [v for k, v in per_agent.items() if fam_of[k] == "opus"] or [0.6]
        f = PRICES[model][1] / PRICES["opus"][1]
        med = statistics.median(base) * f
        lo, hi = med * 0.3, med * 3
        src = f"scaled from Opus agents (too few {model} runs of my own)"
    print(f"{n} {model} agents: about {n * med / ppp:.1f} % of a week "
          f"(range {n * lo / ppp:.1f}-{n * hi / ppp:.1f} %), ${n * med:.0f} API-equivalent; {src}")


def session_cost(sid):
    """(dollars, % of the weekly limit) of one session with its agents, from its full id. Used by `thread progress`."""
    d = sum(r[2] for r in load(0, session_files(sid)))
    return d, d / per_percent()


def cmd_session(prefix):
    if len(prefix) == 36 and session_files(prefix):
        d, pct = session_cost(prefix)
        print(json.dumps({"session": prefix, "dollars": round(d, 2), "week_percent": round(pct, 2)})
              if "--json" in sys.argv else f"{prefix[:8]}: ${d:.2f} ≈ {pct:.1f} % of a week")
        return
    rows = [r for r in load(time.time() - 90 * 86400) if r[4].startswith(prefix)]
    if not rows:
        print("No such session in the last 90 days.")
        return
    total = sum(r[2] for r in rows)
    print(f"{prefix}: ${total:.2f} ≈ {total / per_percent():.1f} % of a week, {len(rows)} requests, "
          f"agents {100 * sum(r[2] for r in rows if r[5]) / total:.0f}%")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", nargs="?", default="report", choices=["report", "calibrate", "estimate", "session"])
    ap.add_argument("arg", nargs="?")
    ap.add_argument("--days", type=int, default=7)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--agents", type=int, default=10)
    ap.add_argument("--model", default="opus", choices=list(PRICES))
    a = ap.parse_args()
    if a.cmd == "report":
        cmd_report(a.days)
    elif a.cmd == "calibrate":
        if not calibrate_values(verbose=True):
            print(f"Not enough history in {LOG} yet; it grows while Claude sessions run.")
    elif a.cmd == "estimate":
        cmd_estimate(a.agents, a.model)
    elif a.cmd == "session":
        if not a.arg:
            sys.exit("claude-usage session <id-prefix>")
        cmd_session(a.arg)


if __name__ == "__main__":
    main()
