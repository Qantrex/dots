#!/usr/bin/env python3
"""Threads: named Claude sessions for one work stream each, in tmux windows of session "main".

  thread list [--all] [--json]               every thread with its live state; --all includes archived ones
  thread start <name> <folder> [model] [-- brief...]
                                             new session in <folder> (its CLAUDE.md loads), tmux window <name>
  thread start <profile> [-- task]           a profile thread: a standing thread defined by one file,
                                             <profiles>/<profile>.md (front matter: model, folder, report,
                                             archive, effort, advisor, description, start; the body is its
                                             standing prompt; effort low..max, default high; advisor off or a
                                             model, default the settings' advisorModel). A new
                                             session each time, one state file across them; the standing
                                             prompt and these thread rules go into the system prompt on every
                                             start and resume, so they survive compaction. start: is a standing
                                             first task, sent on every start and resume; a task given here
                                             follows it ("First: <start>. Then: <task>"), or is the first
                                             message on its own. An edited profile reaches the next start
                                             (a resumed session keeps its recorded prompt until it compacts).
                                             report: none makes it silent: no inbox lines, questions, stall
                                             lines, result card, `thread send main` or SendMessage; progress
                                             shows only its state; when it stops the owner gets a desktop
                                             notification that says "done" or "waiting for you". Profile
                                             threads are never archived by `thread watch` unless archive: auto
  thread profiles                            every profile with its settings and state, and its problems
                                             (unknown model or field, missing folder, no prompt); exit 1 then.
                                             Folder: $AGENTIC_PROFILES or ~/.local/share/agentic/profiles;
                                             files starting with _ (the template) and README.md are skipped
  thread show <name>                         the state file (goal, now, next, decisions, where, open)
  thread stop <name> | --all                 end the session (/exit); state and transcript stay
  thread resume <name> | --open              reopen a thread where it was (claude --resume); --open: all
                                             that a shutdown or crash left open (what `cr` did)
  thread model <name> <model>                switch the model (only while it's idle)
  thread send <name|main> <text...>          type a message into a thread or the main chat and send it, as if
                                             typed there (several lines stay several lines, one message);
                                             refused (exit 3) while a question or dialog is open or something
                                             is already typed; exit 4 when the text is typed there but could
                                             not be sent. The shell's agent panel uses this.
  thread progress [--brief]                  what each running thread is doing right now: state, how long, steps
                                             done (4/7, 57 %), last action, its share of the weekly limit.
                                             A turn ended with Esc runs no Stop hook: list, progress and watch
                                             read the thread's screen and record that stop themselves
  thread step [<name>] <done>/<total> [next] a thread records how far it is (inside a thread the name comes
                                             from $AGENTIC_THREAD), e.g. `thread step 4/7 panel QML`;
                                             <total>/<total> is the done signal
  thread needs [<name>] "<what the owner has to do>" | --clear
                                             the thread waits for the owner: front matter `needs:` and a line
                                             under "Open for the owner"
  thread ask [<name>] [file]                 questions for the owner as JSON (stdin or file), in the shape
                                             AskUserQuestion takes: {"questions": [{question, header, options:
                                             [{label, description, preview?}], multiSelect?}]}, at most 4;
                                             a [questions] inbox line tells the main chat right away
  thread questions <name> [--json]           the open question round: {"thread", "round", "questions"}
                                             (questions empty when none is open)
  thread answer <name> [--resend]            answers from stdin: {"round"?, "answers": {"<question>": "<label>"
                                             | ["<label>", ...] | "<free text>"}}; stored beside the questions
                                             and sent into the thread as one message. A second answer to the
                                             same round is refused (exit 4); stored but not delivered: exit 3
  thread signal <name> [--transcript <file>] for the stop hook: label<TAB>detail<TAB>sent, label one of done,
                                             questions, needs, paused, idle (misc with no step done: waits for
                                             its next job) (sent: the last turn messaged main-chat;
                                             "notified" for a question round `thread ask` already announced)
  thread result <name> [--transcript <file>] the thread's result card in ~/Notes/Results from its newest answer
                                             (a done stop writes it by itself): one card per thread session,
                                             newest answer on top, files from /tmp and other short-lived places
                                             copied to Results/files/<card>/. --backfill [--since YYYY-MM-DD]
                                             [--dry-run]: once, a card for every session that ended at done
                                             since then (default 14 days), marked read except today's
  thread watch                               for the agentic-watch timer (every 5 min): a thread still in its
                                             turn (working, not idle at its prompt) whose pane, transcript and
                                             subagents stay unchanged 10 min gives one [stalled] inbox line with
                                             a wake, once per quiet period (never while background shells or
                                             agents run for it). Also stops and
                                             archives a finished thread: idle 30 min after a done stop whose
                                             result card exists (never misc, fixes or a profile thread without archive: auto; one
                                             quiet inbox line). Silent threads are never watched
  thread adopt                               turn sessions from before (cr records, open sessions) into threads
  thread durations [name...] [--json]        how long thread work took, per finished run of work: working time
                                             (waits for the owner left out), start to done, steps, minutes per
                                             step, and the medians; with a name every step with its time.
                                             From ~/.local/share/agentic/durations.jsonl (one line per start,
                                             resume, step, stop, end, model change) and the transcripts.
                                             --backfill [--dry-run]: once, from older transcripts
  thread archive <name>...                   finished thread off the lists; state and transcript stay, and
                                             `thread resume`/`thread show` still work
  thread rm <name>                           forget a thread (the transcript stays, but nothing points to it)

The main chat (`agentic`) uses these; they work just as well by hand. At most MAX_RUNNING threads run;
starting another stops the oldest idle one, which `thread resume` brings back. State files:
~/.local/share/agentic/threads/<name>.md (facts only).
"""
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import uuid
from datetime import datetime

HOME = os.path.expanduser("~")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "agentic")
DIR = os.path.join(DATA, "threads")
RUN = os.path.join(DIR, ".run")
PROGRESS = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "agentic", "progress")
RECORDS = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "claude-sessions")
# One JSON line per thread event (start, resume, step, stop, end, model), for `thread durations`.
DURATIONS = os.path.join(DATA, "durations.jsonl")
SESSION = "main"
MAX_RUNNING = 8
UNCOUNTED = {"misc"}  # never counted toward MAX_RUNNING, never stopped to make room, idle between jobs
# A thread idle this long after a done stop, with its result card written, is stopped and archived by
# `thread watch`, except these (owner, 2026-11-21). `thread resume` brings any of them back.
RETIRE_AFTER = 30 * 60
KEEP_OPEN = UNCOUNTED | {"fixes"}
# Profiles: standing threads, one Markdown file each (front matter: model, folder, report, archive, description;
# the body is the standing prompt). `thread start <name>` starts one from its file, `thread profiles` lists them.
PROFILES = os.environ.get("AGENTIC_PROFILES") or os.path.join(DATA, "profiles")
PROFILE_FIELDS = ("model", "folder", "report", "archive", "effort", "advisor", "description", "start")
EFFORTS = ("low", "medium", "high", "xhigh", "max")
ADVISORS = ("off", "fable", "opus", "sonnet")   # off, or an advisor model; left out: settings' advisorModel
REPORTS = ("normal", "none")      # none: a silent thread, nothing it does reaches the main chat
ARCHIVES = ("never", "auto")      # auto: archived 30 min after a done stop, like other threads
# Threads compact at 240k: the fixed base is about 60k, so 150k (the main chat's cap) left a research thread
# about 90k and it compacted after a few fetched pages. Requests under 250k cost about half of those above it.
AUTOCOMPACT = "240000"
CLAUDE = os.path.join(HOME, ".local/bin/claude")
MODELS = {"fable", "opus", "sonnet", "haiku", "claude-opus-4-8"}
CLEAN_ENV = ["CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_ID",
             "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN", "CLAUDE_PID", "AGENTIC_ROLE"]


def sh(args, check=False):
    r = subprocess.run(args, capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(r.stderr.strip() or f"{args[0]} failed")
    return r.stdout


def slug(s):
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:32] or "thread"


def path(name):
    return os.path.join(DIR, name + ".md")


def read(name):
    try:
        text = open(path(name), encoding="utf-8").read()
    except OSError:
        return None, ""
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    fm = {}
    if m:
        for line in m.group(1).splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                fm[k.strip()] = v.strip()
    if not fm.get("session"):
        # The thread rewrote its state file without the front matter (2026-11-26: a profile thread wrote it
        # anew with its Write tool, and the next `thread step` kept only `updated:`; it then lost its profile,
        # model and silence). Take the keys back from the copy write() keeps; the next write repairs the file.
        try:
            for k, v in json.load(open(keep_path(name), encoding="utf-8")).items():
                fm.setdefault(k, v)
        except (OSError, ValueError, AttributeError):
            pass
    return fm, (m.group(2) if m else text)


def keep_path(name):
    """The copy of a thread's front matter that write() keeps beside its run script."""
    return os.path.join(RUN, name + ".fm.json")


def write(name, fm, body):
    os.makedirs(DIR, exist_ok=True)
    fm["updated"] = datetime.now().strftime("%Y-%m-%d %H:%M")
    keys = ["name", "folder", "model", "status", "origin", "profile", "report", "archive", "session", "started",
            "updated", "progress", "needs"]
    head = "\n".join(f"{k}: {fm[k]}" for k in keys if k in fm)
    with open(path(name) + ".tmp", "w", encoding="utf-8") as f:
        f.write(f"---\n{head}\n---\n{body}")
    os.replace(path(name) + ".tmp", path(name))
    if fm.get("session"):
        os.makedirs(RUN, exist_ok=True)
        with open(keep_path(name) + ".tmp", "w", encoding="utf-8") as f:
            json.dump({k: fm[k] for k in keys if k in fm and k != "updated"}, f)
        os.replace(keep_path(name) + ".tmp", keep_path(name))


def log_event(name, event, fm=None, **fields):
    """Append one event of a thread to durations.jsonl (one write, O_APPEND, so parallel threads don't mix
    lines). Never fails the command that logs it."""
    try:
        fm = fm if fm is not None else (read(name)[0] or {})
        e = {"ts": round(time.time(), 1), "at": datetime.now().astimezone().isoformat(timespec="seconds"),
             "thread": name, "session": fm.get("session", ""), "model": fm.get("model", ""), "event": event}
        e.update(fields)
        os.makedirs(DATA, exist_ok=True)
        fd = os.open(DURATIONS, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, (json.dumps(e, ensure_ascii=False) + "\n").encode())
        finally:
            os.close(fd)
    except Exception:
        pass


def body_template(goal, folder):
    return (f"\n## Goal\n{goal or '(not written yet)'}\n\n## Now\n\n## Next\n\n## Decisions\n\n"
            f"## Where things are\n- Folder: `{folder}`\n\n## Open for the owner\n")


def all_threads(archived=False):
    out = []
    for f in sorted(glob.glob(os.path.join(DIR, "*.md"))):
        fm, _ = read(os.path.basename(f)[:-3])
        if fm and (archived or fm.get("status") != "archived"):
            fm.setdefault("name", os.path.basename(f)[:-3])  # a state file without name: (e.g. copied by hand) must not crash every command
            out.append(fm)
    return out


def agents():
    """Live Claude sessions by id: {id: {state, name, cwd}}."""
    try:
        j = json.loads(sh([CLAUDE, "agents", "--json"]) or "[]")
    except ValueError:
        j = []
    return {(a.get("sessionId") or a.get("id") or ""): a for a in j}


def windows():
    """tmux windows of the main session that belong to the main chat or a thread: {name: (index, pane pid, pane id)}.
    Only windows with automatic-rename off: tmux names a plain shell window after its folder, so a shell in
    ~/.local/share/agentic/main is also called "main" (2026-11-19 that made `main:main` ambiguous and every
    wake failed). The main chat and threads switch renaming off when they start. Lowest index wins."""
    out = {}
    for line in sh(["tmux", "list-windows", "-t", "=" + SESSION, "-F",
                    "#{window_name}\t#{window_index}\t#{pane_pid}\t#{pane_id}\t#{automatic-rename}"]).splitlines():
        try:
            n, i, p, pane, auto = line.split("\t")
        except ValueError:
            continue
        if auto == "1" or n in out:
            continue
        out[n] = (int(i), int(p), pane)
    return out


def target(name, wins=None):
    """The tmux pane of the main chat or a thread (a pane id, never a name that a shell window can share)."""
    w = (wins if wins is not None else windows()).get(name)
    return w[2] if w else None


def live_state(fm, ag, wins):
    a = ag.get(fm.get("session", ""))
    if a:
        st = a.get("state") or a.get("status") or "running"
        return {"busy": "working", "idle": "idle"}.get(st, st)
    if fm.get("name") in wins:
        return "starting"
    return "left open" if fm.get("status") == "running" else "stopped"


def running(ag, wins, include_adopted=False):
    """Threads that run now. Adopted sessions (my own from before) don't count toward the limit and are never
    stopped automatically, unless include_adopted. The 'misc' thread (main chat's own small work) doesn't
    count either (owner, 2026-11-20)."""
    return [t for t in all_threads() if live_state(t, ag, wins) not in ("stopped", "left open")
            and (include_adopted or (t.get("origin") != "adopted" and t["name"] not in UNCOUNTED))]


def trust(folder):
    """Mark <folder> as trusted in Claude Code's config, so the thread doesn't stop at its trust question.
    The owner chose to trust every folder a thread runs in (2026-11-19). Trust of a parent folder doesn't
    carry over to its subfolders (checked: ~/Projects trusted, ~/Projects/wh still asked), so it's per folder."""
    path = os.path.join(HOME, ".claude.json")
    d = os.path.realpath(folder)
    try:
        conf = json.load(open(path))
    except (OSError, ValueError):
        return
    entry = conf.setdefault("projects", {}).setdefault(d, {})
    if entry.get("hasTrustDialogAccepted"):
        return
    entry["hasTrustDialogAccepted"] = True
    tmp = f"{path}.thread-{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(conf, f, indent=2)
    os.replace(tmp, path)
    print(f"Marked {d} as trusted in Claude Code, so '{os.path.basename(d)}' starts without the trust question.")


def launch(name, folder, cmd_args, env=None):
    """Open a tmux window <name> in <folder> running claude with the given arguments (and extra variables)."""
    trust(folder)
    os.makedirs(RUN, exist_ok=True)
    script = os.path.join(RUN, name + ".sh")
    unset = " ".join(f"-u {v}" for v in CLEAN_ENV)
    with open(script, "w") as f:
        f.write("#!/bin/sh\n# Written by `thread`; runs one Claude session for thread " + name + ".\n"
                f"exec env {unset} AGENTIC_ROLE=thread AGENTIC_THREAD={shlex.quote(name)} "
                + "".join(f"{k}={shlex.quote(v)} " for k, v in (env or {}).items()) +
                f"SSH_AUTH_SOCK={shlex.quote(os.environ.get('SSH_AUTH_SOCK') or os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid()), 'ssh-agent.socket'))} "
                f"{shlex.quote(CLAUDE)} {' '.join(shlex.quote(a) for a in cmd_args)}\n")
    os.chmod(script, 0o755)
    if subprocess.run(["tmux", "has-session", "-t", "=" + SESSION], capture_output=True).returncode:
        sys.exit("No tmux session 'main' (run `agentic on`).")
    pane = sh(["tmux", "new-window", "-d", "-P", "-F", "#{pane_id}", "-t", SESSION + ":", "-n", name, "-c", folder, script],
              check=True).strip()
    sh(["tmux", "set-option", "-w", "-t", pane, "automatic-rename", "off"])
    sh(["tmux", "set-option", "-w", "-t", pane, "allow-rename", "off"])


def make_room(ag, wins):
    live = running(ag, wins)
    while len(live) >= MAX_RUNNING:
        idle = [t for t in live if live_state(t, ag, wins) == "idle" and target(t["name"], wins)
                and empty_prompt(target(t["name"], wins))]
        if not idle:
            sys.exit(f"{len(live)} threads are working; none is idle to stop. Stop one first (thread stop <name>).")
        oldest = min(idle, key=lambda t: t.get("updated", ""))
        print(f"Stopping the oldest idle thread '{oldest['name']}' to stay at {MAX_RUNNING} (thread resume brings it back).")
        if not stop(oldest["name"]):
            sys.exit("Could not stop it safely; stop a thread yourself first.")
        live = [t for t in live if t["name"] != oldest["name"]]


def stop(name):
    fm, body = read(name)
    if fm is None:
        sys.exit(f"No thread '{name}'.")
    wins = windows()
    if name in wins:
        pane = target(name, wins)
        if not empty_prompt(pane):
            print(f"'{name}' has a question, a dialog or typed text open; not stopping it (answer or close it yourself).")
            return False
        sh(["tmux", "send-keys", "-t", pane, "/exit", "Enter"])
        for _ in range(30):
            time.sleep(0.2)
            if target(name) != pane:
                break
        if target(name) == pane:
            sh(["tmux", "kill-window", "-t", pane])
    elif fm.get("session") in agents():
        print(f"'{name}' runs outside tmux; close it there.")
        return
    fm["status"] = "stopped"
    write(name, fm, body)
    clear_progress(name)
    log_event(name, "end", fm)
    return True


def clear_progress(name):
    """Drop a stopped thread from the progress files (panel line, bar), rebuilt like the session hook does."""
    try:
        os.remove(os.path.join(PROGRESS, name + ".json"))
    except OSError:
        pass
    rebuild_progress()


def rebuild_progress():
    """The panel line and the bar's JSON from the progress files, as the session hook writes them."""
    items = []
    for f in glob.glob(os.path.join(PROGRESS, "*.json")):
        try:
            items.append(json.load(open(f)))
        except (OSError, ValueError):
            pass
    items.sort(key=lambda p: -p.get("at", 0))
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
    os.makedirs(cache, exist_ok=True)
    with open(os.path.join(cache, "agentic-threads.json"), "w") as f:
        json.dump(items, f)
    mark = {"working": "● ", "needs you": "! "}
    with open(os.path.join(cache, "agentic-threads.line"), "w") as f:
        f.write("   ".join(mark.get(p.get("state"), "○ ") + p["name"] + " " + time.strftime("%H:%M", time.localtime(p.get("since", 0)))
                           + (": " + p.get("detail", "")[:70] if p.get("detail") else "") for p in items) + "\n")


def empty_prompt(target):
    """True when the session shows its normal input line with nothing typed (no dialog, no question)."""
    screen = sh(["tmux", "capture-pane", "-p", "-t", target]).rstrip("\n").splitlines()
    if any(re.match(r"\s*❯ \d+\.", l) or "Enter to confirm" in l or "Esc to cancel" in l for l in screen[-15:]):
        return False
    return input_empty(sh(["tmux", "capture-pane", "-p", "-e", "-t", target]))

def input_empty(screen_e):
    """The last input line (captured with escape codes) has nothing typed: only Claude Code's dimmed
    placeholder ("Try ...") or nothing at all after the prompt sign."""
    lines = [l for l in screen_e.splitlines() if "❯" in l]
    if not lines:
        return False
    rest = lines[-1].split("❯", 1)[1]
    rest = re.sub(r"\x1b\[2m.*?(\x1b\[0m|\x1b\[22m|$)", "", rest)   # dimmed placeholder
    rest = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", rest)                  # other colours
    return rest.replace("\u00a0", " ").strip() == ""



def cmd_send(args):
    """Type TEXT into a session's input line and press Enter. One way in for everything that
    sends for me (the agent panel), with one rule: never type into a dialog or over a draft."""
    if len(args) < 2:
        sys.exit("thread send <name|main> <text...>")
    name = "main" if args[0] == "main" else slug(args[0])
    me = os.environ.get("AGENTIC_THREAD", "")
    if name == "main" and (os.environ.get("AGENTIC_SILENT") or (me and silent(read(slug(me))[0]))):
        print(f"thread send: '{me}' is a silent thread; nothing goes to the main chat. Tell the owner here.",
              file=sys.stderr)
        sys.exit(5)
    text = message(" ".join(args[1:]))
    if not text:
        sys.exit("thread send: nothing to send")
    # Only Claude sessions: the main chat and threads with a state file, never a shell window.
    if name not in windows() or (name != "main" and read(name)[0] is None):
        print(f"thread send: no running session '{name}' (thread list)", file=sys.stderr)
        sys.exit(2)
    sys.exit(send_text(name, text, quiet=False))


def message(raw):
    """What `thread send` sends for the text it was given. One line: its words with single spaces,
    as always. Several lines: the lines as written (indents kept), without empty lines around them."""
    lines = [l.rstrip() for l in raw.replace("\r\n", "\n").replace("\r", "\n").split("\n")]
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    return "\n".join(lines) if len(lines) > 1 else " ".join(raw.split())


def send_text(name, text, quiet=True):
    """Put a text into the main chat's or a thread's input and press Enter. 0 sent, 2 no such session,
    3 a question, dialog or draft is open there, 1 tmux failed with nothing typed, 4 the text is typed
    there but was not sent."""
    pane = target(name)
    if not pane:
        return 2
    return send_to(pane, text, name, quiet)


PIECE = 300


def shows(pane, typed, wait=5.0):
    """The screen shows the end of what was typed so far: that is where the cursor is, also when a
    long text has pushed the prompt sign off the screen. A dialog that came up in the meantime
    hides the input, so the text is not there. Spaces and line ends don't count (the input wraps
    where it likes), nor does the first character (`!` and `#` change the prompt instead)."""
    want = re.sub(r"\s+", "", typed)[1:][-24:]
    end = time.time() + wait
    while True:
        if want in re.sub(r"\s+", "", sh(["tmux", "capture-pane", "-p", "-t", pane])):
            return True
        if time.time() >= end:
            return False
        time.sleep(0.02)


def send_to(pane, text, name="", quiet=True):
    if not empty_prompt(pane):
        if not quiet:
            print(f"thread send: '{name}' is asking something or has text typed already; answer it in its terminal (dock show {name})", file=sys.stderr)
        return 3
    text = text.replace("\r\n", "\n").replace("\r", "\n")   # a carriage return is Enter
    # Typed keys are keys: a tab would complete or accept a suggestion, an escape would clear the
    # line. A tab becomes spaces, other control characters go; the line feed stays.
    text = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", text.replace("\t", "    "))

    def typed_not_sent():
        # Left as it is: clearing it would mean pressing keys into a session in an unknown state.
        if not quiet:
            print(f"thread send: the text is typed in the input of '{name}' but was not sent; look at it in its terminal (dock show {name})", file=sys.stderr)
        return 4

    # Typed as keys, in pieces with a short pause between them: Claude Code takes about 800
    # characters that arrive at once (and any tmux paste) as pasted text, and marks the message, or
    # the middle of it, as pasted from somewhere else. A short text is one piece, as it always was.
    # Several lines stay several lines: a line end goes in as a line feed (Ctrl+J, a new line in
    # Claude Code), never as a carriage return, which is Enter and would send the first half early.
    # Checked 2026-11-20 on a session of its own: 6000 characters and 81 lines arrive as typed.
    # The next piece, and Enter, go only once the screen shows the piece before: a text in pieces
    # takes a second, and a dialog that comes up in that time must not get the rest or the Enter.
    # -l: literal keys, --: a text starting with a dash is still text.
    paced = len(text) > PIECE or "\n" in text
    for n in range(0, len(text), PIECE):
        if n:
            time.sleep(0.03)
        if subprocess.run(["tmux", "send-keys", "-t", pane, "-l", "--", text[n:n + PIECE]]).returncode:
            return typed_not_sent() if n else 1
        if paced and not shows(pane, text[:n + PIECE]):
            return typed_not_sent()
    time.sleep(0.15)
    if subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"]).returncode:
        return typed_not_sent()
    return 0


def protocol(name, report="normal"):
    """How a thread works with the main chat (or, silent, without it): sent with the brief, and for a profile
    thread attached to its system prompt, so it survives compaction and restarts."""
    if report == "none":
        return (f"You are thread '{name}', a standing thread that works with the owner directly in its own "
                f"terminal window (tmux {SESSION}:{name}). Your state file is {path(name)}: keep its Goal (the "
                "current task), Now, Next, Decisions, Where things are and Open for the owner current, facts only; "
                "change those sections with Edit and leave the block between the --- lines at the top as it is "
                "(`thread` keeps it). "
                "You are silent: nothing you do reaches the main chat, and it must stay that way. Never message "
                "the main chat (no `thread send main`, no SendMessage) and never use `thread ask`; when you need "
                "a decision, ask the owner here with AskUserQuestion. When the owner has to do something, say it "
                "plainly in your answer and record it with `thread needs \"<what>\"` (`thread needs --clear` "
                "once done). When you stop, the owner gets a desktop notification that says only 'done' or "
                "'waiting for you'. Keep commands, code and findings in this conversation and in files in the "
                "task's folder, and say where they are. Steps are optional: for a longer task record them with "
                "`thread step <done>/<total> <next step>`, starting again at 0 for each new task.")
    return (f"You are thread '{name}', started by the main chat. Your state file is {path(name)}: keep its "
                  "Goal, Now, Next, Decisions, Where things are and Open for the owner current, facts only; change "
                  "those sections with Edit and leave the block between the --- lines at the top as it is (`thread` "
                  "keeps it). Split the work "
                  "into steps once you know them and record how far you are with `thread step <done>/<total> <next "
                  "step>` (e.g. `thread step 0/6 reading the repo`, then after each finished step; change the total "
                  "when the plan changes; <total>/<total> only when done and checked: that is the done signal, "
                  "anything less reaches the main chat as paused). When you stop, the main chat hears it by "
                  "itself and reads the first line of your answer, so start every final answer with a one-line "
                  "summary: that line is your report. SendMessage to \"main-chat\" is for questions to the main "
                  "chat during the work, not for the result. When you need a decision from the owner, do not "
                  "open AskUserQuestion: write the questions as JSON with `thread ask` (the shape AskUserQuestion "
                  "takes, at most 4; as the `decide` skill says: check first, each question standing alone, your "
                  "recommendation first), carry on with whatever does not depend on the answers, and end your "
                  "turn. The answers arrive as a message starting with \"Answers from the owner:\". When the "
                  "owner has to do something else (run a script, say promote), `thread needs \"<what>\"`, and "
                  "`thread needs --clear` once it is done.")


def parse_profile(file):
    """(fields, prompt, problems) of a profile file. A value may end in a `# comment`; the body is the
    standing prompt, with <!-- comments --> left out."""
    text = open(file, encoding="utf-8").read()
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    if not m:
        return {}, text.strip(), ["no front matter (a block between two --- lines at the top)"]
    fields, problems = {}, []
    for line in m.group(1).splitlines():
        line = re.sub(r"(^|\s)#.*$", "", line).strip()
        if not line:
            continue
        if ":" not in line:
            problems.append(f"not a 'field: value' line: {line}")
            continue
        k, v = (x.strip() for x in line.split(":", 1))
        fields[k] = v
    return fields, re.sub(r"<!--.*?-->", "", m.group(2), flags=re.S).strip(), problems


def load_profile(name):
    """The profile <name> (its file in PROFILES, defaults filled in, a list of problems), or None. Files whose
    name starts with _ (the template) are not profiles."""
    file = os.path.join(PROFILES, name + ".md")
    if not name or name.startswith("_") or name.lower() == "readme" or not os.path.isfile(file):
        return None
    f, prompt, problems = parse_profile(file)
    p = {"name": name, "file": file, "model": f.get("model") or "opus",
         "folder": os.path.abspath(os.path.expanduser(f.get("folder") or "~")),
         "report": f.get("report") or "normal", "archive": f.get("archive") or "never", "effort": f.get("effort") or "high",
         "advisor": f.get("advisor", ""),
         "description": f.get("description", ""), "start": f.get("start", ""), "prompt": prompt}
    problems += [f"unknown field '{k}' (known: {', '.join(PROFILE_FIELDS)})" for k in f if k not in PROFILE_FIELDS]
    if p["model"] not in MODELS:
        problems.append(f"model '{p['model']}' is not one of {', '.join(sorted(MODELS))}")
    if not os.path.isdir(p["folder"]):
        problems.append(f"folder {p['folder']} does not exist")
    if p["report"] not in REPORTS:
        problems.append(f"report '{p['report']}' is not one of {', '.join(REPORTS)}")
    if p["archive"] not in ARCHIVES:
        problems.append(f"archive '{p['archive']}' is not one of {', '.join(ARCHIVES)}")
    if p["advisor"] and p["advisor"] not in ADVISORS:
        problems.append(f"advisor '{p['advisor']}' is not one of {', '.join(ADVISORS)} (or left out)")
    if p["effort"] not in EFFORTS:
        problems.append(f"effort '{p['effort']}' is not one of {', '.join(EFFORTS)}")
    if not prompt:
        problems.append("no standing prompt (the text under the front matter)")
    if slug(name) != name or name == "main":
        problems.append(f"file name: lower case letters, digits and dashes only, not 'main' ({slug(name)}.md)")
    p["problems"] = problems
    return p


def silent(fm):
    """A thread whose profile says report: none. Nothing it does reaches the main chat (owner, 2026-11-26)."""
    return (fm or {}).get("report") == "none"


def profile_launch(name, p):
    """(claude arguments, environment) that make a session a profile thread: the standing prompt and the thread
    rules in the system prompt (passed on every start and resume: after a compaction Claude Code renders the
    system prompt again from the launch flags), for a silent thread no SendMessage and AGENTIC_SILENT, and the
    advisor: off sets Claude Code's own switch CLAUDE_CODE_DISABLE_ADVISOR_TOOL, so the session has no advisor
    tool at all (checked in its debug log: no "[AdvisorTool]" line; advisorModel "off" only works as an invalid
    name and "" falls back to the main model); a model name overrides advisorModel for this session."""
    args = ["--append-system-prompt", p["prompt"] + "\n\n" + protocol(name, p["report"])]
    env = {}
    if p.get("advisor") == "off":
        env["CLAUDE_CODE_DISABLE_ADVISOR_TOOL"] = "1"
    elif p.get("advisor"):
        args += ["--settings", json.dumps({"advisorModel": p["advisor"]})]
    if p["report"] == "none":
        args += ["--disallowedTools", "SendMessage"]
        env["AGENTIC_SILENT"] = "1"
    return args, env


def first_message(p, task=""):
    """The first message of a profile thread's session: its start task (the profile's `start:`, run on every
    start and resume), then the task given with `-- task`. Empty: it waits at its prompt."""
    start = p.get("start", "").strip()
    if start and task:
        return [f"First: {start.rstrip('.')}. Then: {task}"]
    return [start or task] if start or task else []


def add_where(body, line):
    """Add '- line' at the end of the state file's "Where things are"."""
    if "## Where things are" not in body:
        return body.rstrip("\n") + f"\n\n## Where things are\n- {line}\n"
    head, tail = body.split("## Where things are", 1)
    nxt = tail.find("\n## ")
    sec, rest = (tail, "") if nxt < 0 else (tail[:nxt], tail[nxt:])
    return head + "## Where things are" + sec.rstrip("\n") + f"\n- {line}\n" + rest


def start_profile(p, brief):
    """Start the profile thread p in a new session. Its state file stays across sessions: an existing one keeps
    its text, and the earlier session is noted under "Where things are"."""
    name = p["name"]
    if p["problems"]:
        sys.exit(f"Profile '{name}' ({p['file']}) has problems:\n- " + "\n- ".join(p["problems"]))
    ag, wins = agents(), windows()
    old, body = read(name)
    if old and live_state(old, ag, wins) not in ("stopped", "left open"):
        sys.exit(f"Thread '{name}' already runs (dock show {name}).")
    if name in wins:
        sys.exit(f"A tmux window called '{name}' already exists; close it first.")
    if name not in UNCOUNTED:
        make_room(ag, wins)
    if old:
        prev = old.get("session")
        if prev and transcript_of(prev):
            body = add_where(body, f"Earlier session: {prev} (started {old.get('started', '?')}, "
                                   f"`claude --resume {prev}` in {old.get('folder', '~').replace(HOME, '~', 1)})")
        clear_progress(name)
    else:
        body = body_template(p["description"] or p["prompt"].split("\n")[0][:300], p["folder"])
    sid = str(uuid.uuid4())
    fm = {"name": name, "folder": p["folder"], "model": p["model"], "status": "running", "profile": name,
          "report": p["report"], "archive": p["archive"], "session": sid,
          "started": datetime.now().strftime("%Y-%m-%d %H:%M")}
    write(name, fm, body)
    log_event(name, "start", fm, folder=p["folder"], profile=name)
    pargs, env = profile_launch(name, p)
    # The start task and the brief are the first message; without either the thread waits at its prompt.
    launch(name, p["folder"], first_message(p, brief) + pargs +
           ["-n", name, "--session-id", sid, "--model", p["model"], "--effort", p["effort"], "--autocompact", AUTOCOMPACT],
           env)
    print(f"Thread '{name}' started from its profile ({p['model']}{', silent' if p['report'] == 'none' else ''}) "
          f"in {p['folder']}: tmux window {SESSION}:{name}, `dock show {name}`.")


def cmd_profiles(args):
    """Every profile with its settings and state, and what is wrong with a file. Exit 1 when one has a problem."""
    names = sorted(os.path.basename(f)[:-3] for f in glob.glob(os.path.join(PROFILES, "*.md"))
                   if not os.path.basename(f).startswith("_") and os.path.basename(f).lower() != "readme.md")
    if not names:
        print(f"No profiles in {PROFILES}. Copy _template.md there to <name>.md and fill it in.")
        return
    ag, wins = agents(), windows()
    bad = 0
    for n in names:
        p = load_profile(n)
        fm, _ = read(n)
        state = live_state(fm, ag, wins) if fm and fm.get("profile") == n else "not started"
        print(f"{n:20} {p['model']:16} {p['folder'].replace(HOME, '~', 1):30} report {p['report']:7} "
              f"archive {p['archive']:6} effort {p['effort']:6} " + (f"advisor {p['advisor']} " if p["advisor"] else "") + state)
        if p["description"]:
            print(f"{'':20} {p['description'][:100]}")
        if p["start"]:
            print(f"{'':20} start: {p['start'][:100]}{'...' if len(p['start']) > 100 else ''}")
        for pr in p["problems"]:
            print(f"{'':20} problem: {pr}")
            bad += 1
    sys.exit(1 if bad else 0)


def cmd_start(args):
    brief = ""
    if "--" in args:
        i = args.index("--")
        brief, args = " ".join(args[i + 1:]), args[:i]
    prof = load_profile(slug(args[0])) if args else None
    if prof:
        if len(args) > 1:
            sys.exit(f"'{prof['name']}' is a profile ({prof['file']}): thread start {prof['name']} [-- first task]")
        return start_profile(prof, brief)
    if len(args) < 2:
        sys.exit("thread start <name> <folder> [model] [-- brief]   (or thread start <profile> [-- task]: thread profiles)")
    name, folder = slug(args[0]), os.path.abspath(os.path.expanduser(args[1]))
    model = args[2] if len(args) > 2 else "opus"
    if model not in MODELS:
        sys.exit(f"model: one of {', '.join(sorted(MODELS))}")
    if not os.path.isdir(folder):
        sys.exit(f"No folder {folder}")
    ag, wins = agents(), windows()
    old, _ = read(name)
    if old and live_state(old, ag, wins) not in ("stopped", "left open"):
        sys.exit(f"Thread '{name}' already runs (dock show {name}).")
    if name in wins or name == "main":
        sys.exit(f"A tmux window called '{name}' already exists; pick another name.")
    if name not in UNCOUNTED:
        make_room(ag, wins)
    sid = str(uuid.uuid4())
    fm = {"name": name, "folder": folder, "model": model, "status": "running", "session": sid,
          "started": datetime.now().strftime("%Y-%m-%d %H:%M")}
    write(name, fm, body_template(brief.split("\n")[0][:300], folder))
    log_event(name, "start", fm, folder=folder)
    prompt = []
    if brief:
        prompt = [brief + "\n\n(" + protocol(name) + ")"]
    # Effort high like my default; the advisor (advisorModel in settings) applies by itself.
    launch(name, folder, prompt + ["-n", name, "--session-id", sid, "--model", model, "--effort", "high",
                                   "--autocompact", AUTOCOMPACT])
    print(f"Thread '{name}' started ({model}) in {folder}: tmux window {SESSION}:{name}, `dock show {name}`.")


def cmd_resume(args):
    if args and args[0] == "--open":
        ag, wins = agents(), windows()
        left = [t["name"] for t in all_threads() if live_state(t, ag, wins) == "left open"]
        if not left:
            print("No threads were left open.")
        for n in left:
            cmd_resume([n])
        return
    if not args:
        sys.exit("thread resume <name> | --open")
    name = slug(args[0])
    fm, body = read(name)
    if fm is None:
        sys.exit(f"No thread '{name}' (thread list).")
    ag, wins = agents(), windows()
    if live_state(fm, ag, wins) not in ("stopped", "left open"):
        print(f"'{name}' is running: dock show {name}")
        return
    if name not in UNCOUNTED:
        make_room(ag, wins)
    folder = fm.get("folder") or HOME
    if not os.path.isdir(folder):
        folder = os.path.join(DATA, "..", "claude-hub")
    # Never written to (no transcript yet): start it fresh under the same session id.
    fresh = not glob.glob(os.path.join(HOME, ".claude/projects/*", fm.get("session", "x") + ".jsonl"))
    # Hub sessions had all of ~; through settings, because --add-dir asks for trust in every session.
    extra = ["--settings", json.dumps({"permissions": {"additionalDirectories": [HOME]}})] \
        if folder.rstrip("/").endswith("/claude-hub") else []
    pargs, env, first, effort = [], {}, [], "high"
    if fm.get("profile"):
        p = load_profile(fm["profile"])
        if p:
            fm["report"], fm["archive"] = p["report"], p["archive"]
            pargs, env = profile_launch(name, p)
            first = first_message(p)             # its start task, again on every resume
            effort = p["effort"]
        else:
            print(f"Profile '{fm['profile']}' is gone ({PROFILES}); resuming without its standing prompt.",
                  file=sys.stderr)
    launch(name, folder, first + ["--session-id" if fresh else "--resume", fm["session"], "-n", name,
                          "--model", fm.get("model", "opus"), "--effort", effort, "--autocompact", AUTOCOMPACT]
           + extra + pargs, env)
    fm["status"] = "running"
    write(name, fm, body)
    log_event(name, "resume", fm)
    print(f"Thread '{name}' resumed in {folder}: `dock show {name}`.")


def screen_turn(pane):
    """What a thread's screen says about its turn: 'running' (its footer offers "esc to interrupt"),
    'dialog', 'background' (turn over, shells or agents it started still run), 'interrupted' (the owner
    pressed Esc), 'ended', or None without a screen."""
    lines = sh(["tmux", "capture-pane", "-p", "-t", pane]).rstrip("\n").splitlines()
    if not lines:
        return None
    foot = "\n".join(lines[-8:])
    if "esc to interrupt" in foot:
        return "running"
    if any(re.match(r"\s*❯ \d+\.", l) or "Enter to confirm" in l or "Esc to cancel" in l for l in lines[-15:]):
        return "dialog"                          # a question or permission dialog: the hooks handle those
    if re.search(r"\d+ background agents?|\d+ shells?", foot):
        return "background"
    return "interrupted" if any("Interrupted" in l for l in lines[-25:]) else "ended"


def settle(ag, wins, now=None):
    """Turns that ended without their stop hook. Esc in a thread's terminal ends the turn and Claude Code runs
    no Stop hook then, so its progress file kept 'working' (and `claude agents` can stay busy) until something
    else wrote to it (2026-11-26). A thread whose progress says working, 20 s without news, while
    its screen shows no running turn and no background work, gets the stop the hook would have written: idle,
    paused N/M, done or needs you, with "interrupted" (or "ended") as its detail, and counts as idle in `ag`.
    No inbox line: the owner stopped it. Returns the names."""
    now = now or time.time()
    done = []
    for t in all_threads():
        name = t["name"]
        path = os.path.join(PROGRESS, name + ".json")
        try:
            p = json.load(open(path))
        except (OSError, ValueError):
            continue
        if p.get("state") != "working" or now - p.get("at", 0) < 20 or name not in wins:
            continue
        turn = screen_turn(wins[name][2])
        if turn not in ("interrupted", "ended"):
            continue
        label, detail = stop_label(name, t)
        p.update(state="needs you" if label in ("questions", "needs") else "idle",
                 detail="" if silent(t) else turn, at=int(now), since=int(now),
                 signal=f"paused {detail}".strip() if label == "paused" else label)
        with open(path + ".tmp", "w") as f:
            json.dump(p, f)
        os.replace(path + ".tmp", path)
        log_event(name, "stop", t, label=label, detail=detail, by=turn)
        a = ag.get(t.get("session", ""))
        if a:
            a["status"], a["state"] = "idle", None
        done.append(name)
    if done:
        rebuild_progress()
    return done


def list_row(t, ag, wins):
    """One thread for `thread list --json`: the state file's fields plus the live state, progress as numbers
    (step, total, next), the label of its last stop (signal) and the minutes since its transcript changed."""
    st = steps(t)
    row = dict(t, state=live_state(t, ag, wins), step=st[0] if st else None, total=st[1] if st else None,
               next=st[2] if st else "", signal=None, quiet_minutes=None)
    try:
        row["signal"] = json.load(open(os.path.join(PROGRESS, t["name"] + ".json"))).get("signal")
    except (OSError, ValueError, KeyError):
        pass
    if silent(t):               # name and state only, nothing of its work (owner, 2026-11-26)
        for k in ("progress", "needs"):
            row.pop(k, None)
        row.update(step=None, total=None, next="", signal=None)
        return row
    tpath = (glob.glob(os.path.join(HOME, ".claude/projects/*", t.get("session", "x") + ".jsonl")) or [""])[0]
    if tpath:
        try:
            row["quiet_minutes"] = int((time.time() - os.path.getmtime(tpath)) // 60)
        except OSError:
            pass
    return row


def cmd_list(args):
    ag, wins = agents(), windows()
    settle(ag, wins)
    ts = all_threads(archived="--all" in args)
    if "--json" in args:
        print(json.dumps([list_row(t, ag, wins) for t in ts]))
        return
    if not ts:
        print("No threads. Start one: thread start <name> <folder> [model] -- <brief>")
        return
    for t in ts:
        st = live_state(t, ag, wins)
        where = t.get("folder", "").replace(HOME, "~", 1)
        print(f"{t['name']:33} {st:10} {t.get('model', ''):7} {where:40} {t.get('updated', '')}")


def ago(t):
    d = int(time.time() - t)
    return f"{d // 60} min" if d < 3600 else f"{d // 3600} h {d % 3600 // 60} min"


def steps(fm):
    """(done, total, next step) from the state file's `progress: 4/7 next step`, or None."""
    m = re.match(r"(\d+)/(\d+)\s*(.*)", fm.get("progress", ""))
    if not m or not int(m.group(2)):
        return None
    return int(m.group(1)), int(m.group(2)), m.group(3)


def idle_between_jobs(name, st, fm=None):
    """An UNCOUNTED thread (misc) or a profile thread with no steps, or none done yet, waits for its next job:
    that is its normal state, never a pause or a stall. Stopped mid-job (2/5) it is paused like any thread."""
    return (name in UNCOUNTED or bool((fm or {}).get("profile"))) and (not st or st[0] == 0)


def cmd_step(args):
    name = slug(args[0]) if args and "/" not in args[0] else os.environ.get("AGENTIC_THREAD", "")
    rest = args[1:] if args and "/" not in args[0] else args
    m = re.fullmatch(r"(\d+)/(\d+)", rest[0]) if rest else None
    if not name or not m or not 0 <= int(m.group(1)) <= int(m.group(2)) or not 0 < int(m.group(2)) <= 50:
        sys.exit("thread step [<name>] <done>/<total> [next step]   (e.g. thread step 4/7 panel QML; total 1-50)")
    fm, body = read(name)
    if fm is None:
        sys.exit(f"No thread '{name}'.")
    fm["progress"] = " ".join([f"{int(m.group(1))}/{int(m.group(2))}"] + rest[1:])[:120]
    write(name, fm, body)
    log_event(name, "step", fm, done=int(m.group(1)), total=int(m.group(2)), next=" ".join(rest[1:])[:120])
    print(f"{name}: {fm['progress']}")


def usage_module():
    """claude-usage loaded as a module, for the per-session cost (None if it can't be loaded)."""
    try:
        from importlib.machinery import SourceFileLoader
        return SourceFileLoader("claude_usage", shutil.which("claude-usage")
                                or os.path.join(HOME, ".local/bin/claude-usage")).load_module()
    except Exception:
        return None


def cmd_progress(args):
    """What every running thread is doing, from the progress the session hook writes (code, no tokens)."""
    ag, wins = agents(), windows()
    settle(ag, wins)
    rows = []
    for t in all_threads():
        st = live_state(t, ag, wins)
        if st in ("stopped", "left open"):
            continue
        try:
            p = json.load(open(os.path.join(PROGRESS, t["name"] + ".json")))
        except (OSError, ValueError):
            p = {}
        state = p.get("state") or st
        if st == "waiting":
            state = "needs you"
        rows.append((p.get("at", 0), t["name"], state, p.get("since"), p.get("detail", ""), t.get("model", ""), t))
    if not rows:
        print("No thread is running." if "--brief" not in args else "")
        return
    rows.sort(reverse=True)
    if "--brief" in args:
        rows = [r for r in rows if r[2] != "idle" or (r[0] and time.time() - r[0] < 3600)]
        if not rows:
            return
        print("Threads right now (from code): " + "; ".join(
            f"{n} {s}" if silent(t) else
            f"{n} {s}" + (f" for {ago(since)}" if since else "")
            + (f", step {st[0]}/{st[1]}" if (st := steps(t)) else "") + (f", last: {d[:80]}" if d else "")
            for at, n, s, since, d, m, t in rows))
        return
    try:
        lim = json.load(open(os.path.join(HOME, ".cache/claude-usage.json")))
        fmt = lambda k, f: (f"{lim[k]['used']} % (resets {datetime.fromtimestamp(lim[k]['resets_at']).strftime(f)})"
                            if (lim.get(k) or {}).get("resets_at") else "0 % (new window)")
        print(f"Limits: 5 h {fmt('five_hour', '%H:%M')}, week {fmt('seven_day', '%a %H:%M')}\n")
    except (OSError, ValueError, KeyError, TypeError):
        pass
    cu = usage_module()
    for at, n, s, since, d, m, t in rows:
        if silent(t):           # name and state only
            print(f"{n:33} {s:10} {'':14} {m:6} (silent thread: dock show {n})")
            continue
        st = steps(t)
        if st:
            done, total, nxt = st
            pct = round(100 * done / total)
            bar = "█" * round(10 * done / total) + "░" * (10 - round(10 * done / total))
            how = f"{bar} {done}/{total} {pct:3} %" + (f"  next: {nxt}" if nxt and done < total else "")
        else:
            how = "no steps recorded yet"
        cost = ""
        if cu and t.get("session"):
            try:
                dollars, week = cu.session_cost(t["session"])
                cost = f"   {week:.1f} % of the week (${dollars:.0f})"
            except Exception:
                pass
        print(f"{n:33} {s:10} {('for ' + ago(since)) if since else '':14} {m:6} {how}{cost}")
        if d:
            print(f"{'':33} last: {d[:100]}")


def cmd_model(args):
    if len(args) < 2 or args[1] not in MODELS:
        sys.exit(f"thread model <name> <{'|'.join(sorted(MODELS))}>")
    name, model = slug(args[0]), args[1]
    fm, body = read(name)
    if fm is None:
        sys.exit(f"No thread '{name}'.")
    ag, wins = agents(), windows()
    st = live_state(fm, ag, wins)
    if st == "working":
        sys.exit(f"'{name}' is working; switch the model when it's idle.")
    # Stop and resume with --model instead of typing /model: /model can become the default of every session.
    was_running = name in wins
    if was_running and not stop(name):
        sys.exit(f"'{name}' has something open; switch the model when it's idle.")
    fm, body = read(name)
    fm["model"] = model
    fm["status"] = "stopped"
    write(name, fm, body)
    log_event(name, "model", fm)
    if was_running:
        cmd_resume([name])
    print(f"'{name}' now uses {model}" + ("" if was_running else " from its next resume") +
          ". The new model reads the whole context once without cache.")


def transcript_model(tpath):
    model = ""
    try:
        with open(tpath, encoding="utf-8", errors="ignore") as f:
            for line in f:
                if '"model":"claude-' in line:
                    m = re.search(r'"model":"claude-(fable|opus|sonnet|haiku)', line)
                    if m:
                        model = m.group(1)
    except OSError:
        pass
    return model or "opus"


def title_of(tpath):
    title = ""
    try:
        with open(tpath, encoding="utf-8", errors="ignore") as f:
            for line in f:
                if '"custom-title"' in line or '"ai-title"' in line:
                    try:
                        e = json.loads(line)
                        title = e.get("customTitle") or e.get("aiTitle") or title
                    except ValueError:
                        pass
    except OSError:
        pass
    return title


def cmd_adopt(args):
    known = {t.get("session") for t in all_threads(archived=True)}
    names = {t["name"] for t in all_threads(archived=True)}
    ag = agents()
    found = {}
    for f in glob.glob(os.path.join(RECORDS, "*.json")):
        try:
            r = json.load(open(f))
        except (OSError, ValueError):
            continue
        if r.get("role") == "main":
            continue
        found[r["id"]] = {"cwd": r.get("cwd", ""), "pane": r.get("pane", ""), "transcript": r.get("transcript", "")}
    for sid, a in ag.items():
        if a.get("kind") == "interactive" and sid and sid not in found:
            found[sid] = {"cwd": a.get("cwd", ""), "pane": "", "transcript": ""}
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    adopted = 0
    for sid, r in found.items():
        if sid in known or sid == me:
            continue
        cwd = r["cwd"]
        if "/claude-ask" in cwd or cwd.endswith("/agentic/main"):
            continue
        tp = r["transcript"] if os.path.exists(r["transcript"] or "") else \
            (glob.glob(os.path.join(HOME, ".claude/projects/*", sid + ".jsonl")) or [""])[0]
        if not tp:
            continue
        title = title_of(tp) or os.path.basename(cwd)
        name = slug(title)
        while name in names or name == "main":
            name = slug(title)[:28] + "-" + sid[:3]
        names.add(name)
        live = sid in ag
        if live and r["pane"]:
            # Name its tmux window after the thread, so `dock show <name>` finds it.
            sh(["tmux", "rename-window", "-t", r["pane"], name])
            sh(["tmux", "set-option", "-w", "-t", r["pane"], "automatic-rename", "off"])
        # Open when the record was written: either still running or left open by a shutdown.
        fm = {"name": name, "folder": cwd, "model": transcript_model(tp), "status": "running", "origin": "adopted",
              "session": sid, "started": datetime.fromtimestamp(os.path.getctime(tp)).strftime("%Y-%m-%d %H:%M")}
        write(name, fm, body_template(f"(adopted from an earlier session: {title})", cwd))
        adopted += 1
        print(f"adopted {name:30} {'running' if live else 'stopped'}  {cwd.replace(HOME, '~', 1)}")
    print(f"{adopted} sessions adopted." if adopted else "Nothing new to adopt.")


# ---- what a thread waits for: needs, questions, answers, and the label of a stop ----------------------

def own_name(args, min_rest=0):
    """(name, rest): the first argument when it names a thread and enough is left after it, else
    $AGENTIC_THREAD (inside a thread)."""
    if len(args) > min_rest and read(slug(args[0]))[0] is not None:
        return slug(args[0]), args[1:]
    return os.environ.get("AGENTIC_THREAD", ""), args


def set_needs(name, text):
    """Write or clear the `needs:` line, and the same sentence under "Open for the owner"."""
    fm, body = read(name)
    old = fm.get("needs", "")
    if old:
        body = body.replace(f"\n- {old}\n", "\n", 1) if f"\n- {old}\n" in body else body
    if text:
        fm["needs"] = text
        if "## Open for the owner" not in body:
            body = body.rstrip("\n") + "\n\n## Open for the owner\n"
        head, tail = body.split("## Open for the owner", 1)
        tail = tail.rstrip("\n")
        body = head + "## Open for the owner" + (tail + "\n" if tail.strip() else "\n") + f"- {text}\n"
    else:
        fm.pop("needs", None)
    write(name, fm, body)


def cmd_needs(args):
    name, rest = own_name(args, 1)
    if not name or not rest:
        sys.exit('thread needs [<name>] "<what the owner has to do>" | --clear')
    if read(name)[0] is None:
        sys.exit(f"No thread '{name}'.")
    if rest == ["--clear"]:
        set_needs(name, "")
        print(f"{name}: nothing open for the owner")
    else:
        text = " ".join(" ".join(rest).split())[:200]
        set_needs(name, text)
        print(f"{name} needs: {text}")


def qpath(name):
    return os.path.join(DIR, name + ".questions.json")


def load_round(name):
    try:
        return json.load(open(qpath(name), encoding="utf-8"))
    except (OSError, ValueError):
        return None


def open_round(name):
    r = load_round(name)
    return r if r and r.get("questions") and not r.get("answers") else None


def check_questions(data):
    """The AskUserQuestion shape, or exit with what is wrong."""
    qs = data.get("questions") if isinstance(data, dict) else data
    errs = []
    if not isinstance(qs, list) or not 1 <= len(qs) <= 4:
        sys.exit('thread ask: expected {"questions": [...]} with 1 to 4 questions')
    seen = set()
    for i, q in enumerate(qs, 1):
        if not isinstance(q, dict):
            errs.append(f"question {i} is not an object")
            continue
        if not isinstance(q.get("question"), str) or not q["question"].strip():
            errs.append(f"question {i}: 'question' text missing")
        elif q["question"] in seen:
            errs.append(f"question {i}: same text as an earlier one")
        else:
            seen.add(q["question"])
        if not isinstance(q.get("header"), str) or not q["header"].strip() or len(q["header"]) > 12:
            errs.append(f"question {i}: 'header' needs a short label, at most 12 characters")
        opts = q.get("options")
        if not isinstance(opts, list) or not 2 <= len(opts) <= 4:
            errs.append(f"question {i}: 2 to 4 'options'")
        else:
            for j, o in enumerate(opts, 1):
                if not isinstance(o, dict) or not isinstance(o.get("label"), str) or not o["label"].strip() \
                        or not isinstance(o.get("description"), str):
                    errs.append(f"question {i} option {j}: needs 'label' and 'description'")
                elif "preview" in o and not isinstance(o["preview"], str):
                    errs.append(f"question {i} option {j}: 'preview' must be text")
        if "multiSelect" in q and not isinstance(q["multiSelect"], bool):
            errs.append(f"question {i}: 'multiSelect' must be true or false")
        extra = set(q) - {"question", "header", "options", "multiSelect"}
        if extra:
            errs.append(f"question {i}: unknown fields {', '.join(sorted(extra))}")
    if errs:
        sys.exit("thread ask: " + "; ".join(errs))
    return [dict(q, multiSelect=bool(q.get("multiSelect"))) for q in qs]


def cmd_ask(args):
    name, rest = own_name(args, 0)
    if not name or read(name)[0] is None:
        sys.exit("thread ask [<name>] [file]   (JSON on stdin or in the file; inside a thread the name is known)")
    if silent(read(name)[0]):
        sys.exit(f"thread ask: '{name}' is a silent thread, nothing reaches the main chat. Ask the owner yourself "
                 "with AskUserQuestion.")
    raw = open(rest[0], encoding="utf-8").read() if rest else sys.stdin.read()
    try:
        data = json.loads(raw)
    except ValueError as e:
        sys.exit(f"thread ask: not valid JSON ({e})")
    qs = check_questions(data)
    if open_round(name):
        sys.exit(f"thread ask: '{name}' already has an open round; wait for its answers (thread questions {name}).")
    rnd = {"thread": name, "round": "r" + datetime.now().strftime("%m%d-%H%M%S"),
           "asked": datetime.now().isoformat(timespec="seconds"), "questions": qs}
    with open(qpath(name) + ".tmp", "w", encoding="utf-8") as f:
        json.dump(rnd, f, ensure_ascii=False, indent=1)
    os.replace(qpath(name) + ".tmp", qpath(name))
    set_needs(name, f"{len(qs)} question{'s' if len(qs) > 1 else ''}")
    # The main chat hears of the round now, not at the thread's next stop: a thread that keeps working after
    # asking may not stop for a long time. The stop then sends no second line for this round (cmd_signal).
    if announce_round(name, rnd):
        rnd["notified"] = datetime.now().isoformat(timespec="seconds")
        with open(qpath(name) + ".tmp", "w", encoding="utf-8") as f:
            json.dump(rnd, f, ensure_ascii=False, indent=1)
        os.replace(qpath(name) + ".tmp", qpath(name))
    print(f"{name}: {len(qs)} question(s) stored as round {rnd['round']}"
          + (" and the main chat is told" if rnd.get("notified") else "")
          + ". End your turn now; the main chat asks the owner and the answers arrive as a message.")


def announce_round(name, rnd):
    """One [questions] inbox line with a wake for a new round. False when there is no inbox or it failed."""
    inbox = os.path.join(HOME, ".local/bin/inbox")
    if not os.access(inbox, os.X_OK):
        return False
    qs = rnd["questions"]
    heads = ", ".join(q["header"] for q in qs)
    text = f"'{name}': {len(qs)} question{'s' if len(qs) > 1 else ''} ({heads}), round {rnd['round']}"
    try:
        r = subprocess.run([inbox, "add", "--wake", "questions", "thread", text[:240]],
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def cmd_questions(args):
    if not args:
        sys.exit("thread questions <name> [--json]")
    name = slug(args[0])
    r = open_round(name)
    if "--json" in args:
        print(json.dumps({"thread": name, "round": r["round"] if r else None, "asked": r.get("asked") if r else None,
                          "questions": r["questions"] if r else []}, ensure_ascii=False))
        return
    if not r:
        print(f"'{name}' has no open questions.")
        return
    print(f"'{name}', round {r['round']} ({r.get('asked', '')}):")
    for i, q in enumerate(r["questions"], 1):
        print(f"\n{i}. [{q['header']}] {q['question']}" + ("  (several allowed)" if q.get("multiSelect") else ""))
        for o in q["options"]:
            print(f"   - {o['label']}: {o['description']}")


def answer_text(r):
    parts = []
    for q in r["questions"]:
        a = r["answers"].get(q["question"])
        if a is None:
            a = "(not answered)"
        elif isinstance(a, list):
            a = ", ".join(map(str, a))
        parts.append(f"{q['question']} -> {a}")
    return "Answers from the owner: " + " | ".join(parts)


def cmd_answer(args):
    if not args:
        sys.exit("thread answer <name> [--resend]   (answers as JSON on stdin)")
    name = slug(args[0])
    r = load_round(name)
    if "--resend" in args:
        if not r or not r.get("answers"):
            sys.exit(f"'{name}' has no stored answers to send.")
    else:
        if not r or not r.get("questions"):
            print(f"thread answer: '{name}' has no question round.", file=sys.stderr)
            sys.exit(2)
        try:
            data = json.loads(sys.stdin.read())
        except ValueError as e:
            sys.exit(f"thread answer: not valid JSON ({e})")
        if isinstance(data, dict) and data.get("round") and data["round"] != r["round"]:
            print(f"thread answer: round {data['round']} is not the current one ({r['round']}).", file=sys.stderr)
            sys.exit(4)
        if r.get("answers"):
            print(f"thread answer: round {r['round']} of '{name}' was already answered at {r.get('answered')}; "
                  "a second answer is refused.", file=sys.stderr)
            sys.exit(4)
        ans = data.get("answers", data) if isinstance(data, dict) else None
        if isinstance(ans, dict):
            ans = {k: v for k, v in ans.items() if k != "round"}
        texts = {q["question"] for q in r["questions"]}
        if not isinstance(ans, dict) or not ans or not set(ans) <= texts or \
                not all(isinstance(v, str) or (isinstance(v, list) and all(isinstance(x, str) for x in v)) for v in ans.values()):
            sys.exit('thread answer: expected {"answers": {"<question text>": "<label or free text>" | ["<label>", ...]}} '
                     "with the exact question texts")
        r["answers"] = ans
        r["answered"] = datetime.now().isoformat(timespec="seconds")
        with open(qpath(name) + ".tmp", "w", encoding="utf-8") as f:
            json.dump(r, f, ensure_ascii=False, indent=1)
        os.replace(qpath(name) + ".tmp", qpath(name))
        fm, _ = read(name)
        if fm and re.fullmatch(r"\d+ questions?", fm.get("needs", "")):
            set_needs(name, "")
    code = send_text(name, answer_text(r))
    r["delivered"] = code == 0
    with open(qpath(name) + ".tmp", "w", encoding="utf-8") as f:
        json.dump(r, f, ensure_ascii=False, indent=1)
    os.replace(qpath(name) + ".tmp", qpath(name))
    if code:
        why = {2: "it isn't running (thread resume, then thread answer --resend)",
               3: "it has a dialog or typed text open (thread answer --resend later)",
               4: f"the text is typed in its input but was not sent (look at it with dock show {name}, clear it, "
                  "then thread answer --resend)"}.get(code, "tmux failed")
        print(f"Answers for '{name}' stored, not delivered: {why}.", file=sys.stderr)
        sys.exit(3)
    print(f"Answers sent to '{name}' (round {r['round']}).")


def sent_to_main(tpath):
    """The thread's last turn (since the last real prompt or delivered message) sent SendMessage to main-chat."""
    try:
        with open(tpath, encoding="utf-8", errors="ignore") as f:
            lines = f.readlines()[-400:]
    except OSError:
        return False
    sent = False
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "user" and not e.get("isMeta") and "toolUseResult" not in e:
            c = (e.get("message") or {}).get("content")
            if isinstance(c, str) or (isinstance(c, list) and not any(b.get("type") == "tool_result" for b in c)):
                sent = False
        elif e.get("type") == "assistant":
            for b in (e.get("message") or {}).get("content") or []:
                if b.get("type") == "tool_use" and b.get("name") == "SendMessage" \
                        and str((b.get("input") or {}).get("to", "")).startswith("main-chat"):
                    sent = True
    return sent


def stop_label(name, fm):
    """(label, detail) of a thread whose turn ended: questions, needs, done, idle or paused."""
    r = open_round(name)
    st = steps(fm)
    if r:
        n = len(r["questions"])
        return "questions", f"{n} question{'s' if n > 1 else ''}"
    if fm.get("needs"):
        return "needs", fm["needs"]
    if st and st[0] == st[1]:
        return "done", f"{st[0]}/{st[1]}"
    if idle_between_jobs(name, st, fm):
        return "idle", ""
    return "paused", f"{st[0]}/{st[1]}" if st else ""


def cmd_signal(args):
    """The label of a thread's stop, decided in code (the session hook calls this)."""
    if not args:
        sys.exit("thread signal <name> [--transcript <file>]")
    name = slug(args[0])
    fm, _ = read(name)
    if fm is None:
        sys.exit(f"No thread '{name}'.")
    tpath = args[args.index("--transcript") + 1] if "--transcript" in args[:-1] else ""
    sent = "sent" if tpath and sent_to_main(tpath) else ""
    if silent(fm):
        sent = "silent"         # the stop hook sends nothing to the main chat, only a desktop notification
    r = open_round(name)
    if r and r.get("notified"):
        sent = "notified"               # `thread ask` already told the main chat: the stop hook sends no line
    label, detail = stop_label(name, fm)
    # Only the stop hook passes --transcript: a look by hand is not a stop.
    if tpath:
        log_event(name, "stop", fm, label=label, detail=detail)
    print(f"{label}\t{detail}\t{sent}", flush=True)
    # A done stop leaves its result card in the vault. The hook reads the line above; nothing else is printed.
    if tpath and label == "done" and not silent(fm):
        try:
            write_card(name, fm, tpath)
        except Exception as e:
            print(f"thread signal: no result card for '{name}': {e}", file=sys.stderr)


# ---- result cards: what a thread produced, in one place in the vault ----------------------------------

VAULT = os.path.join(HOME, "Notes")
RESULTS = os.path.join(VAULT, "Results")
RESULT_DATA = os.path.join(DATA, "results")       # one JSON per thread session: every result it gave
COPY_MAX = 20 * 1024 * 1024                       # LiveSync takes 50 MB per file; keep the vault light
# Places that don't last: session scratchpads, /tmp, ~/temp, and ~/Downloads (an inbox for a couple of weeks).
SHORT_LIVED = ("/tmp/", "/var/tmp/", "/dev/shm/", os.path.join(HOME, "temp") + "/", os.path.join(HOME, "Downloads") + "/")
PATH_RE = re.compile(r"(?<![\w/.:~-])(~?/[^\s`'\"()\[\]<>,;|*]+)")
VAULT_REL_RE = re.compile(r"(?<![\w/.:~-])([A-Z][\w.-]*/[^\s`'\"()\[\]<>,;|*]*\.md)\b")


def answers(tpath, until=None):
    """The thread's answers in its transcript: [(unix time, text)], one per assistant message id with text, in
    order. Text blocks of one message id are joined, like the stop hook does. until: only those before it."""
    out, idx = [], {}
    with open(tpath, encoding="utf-8", errors="ignore") as f:
        for n, line in enumerate(f):
            if '"assistant"' not in line or '"text"' not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("type") != "assistant" or e.get("isSidechain"):
                continue
            m = e.get("message") or {}
            texts = [b.get("text", "") for b in m.get("content") or [] if isinstance(b, dict) and b.get("type") == "text"]
            texts = [t for t in texts if t.strip()]
            ts = iso_ts(e.get("timestamp", "")) or 0
            if not texts or (until and ts > until):
                continue
            mid = m.get("id") or e.get("uuid") or f"line {n}"
            if mid in idx:
                out[idx[mid]] = (out[idx[mid]][0], out[idx[mid]][1] + "\n" + "\n".join(texts))
            else:
                idx[mid] = len(out)
                out.append((ts, "\n".join(texts)))
    return out


FILE_TOOLS = ("Write", "Edit", "MultiEdit", "NotebookEdit")


def written_files(tpath):
    """Files the session wrote or edited with its file tools, in order."""
    seen = []
    with open(tpath, encoding="utf-8", errors="ignore") as f:
        for line in f:
            if '"tool_use"' not in line or not re.search(r'"name":\s*"(Write|Edit|MultiEdit|NotebookEdit)"', line):
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            for b in (e.get("message") or {}).get("content") or []:
                if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") in FILE_TOOLS:
                    p = (b.get("input") or {}).get("file_path") or (b.get("input") or {}).get("notebook_path")
                    if p and p not in seen:
                        seen.append(p)
    return seen


def mentioned_paths(text):
    """Paths in a text as written there (absolute, ~/..., or vault-relative like Marketplace/X.md), each with
    the file it means. Only existing regular files."""
    out = []
    for m in PATH_RE.finditer(text):
        raw = m.group(1).rstrip(".:!?")
        real = os.path.expanduser(raw)
        if raw.startswith("//") or not os.path.isfile(real):
            continue
        out.append((raw, os.path.abspath(real)))
    for m in VAULT_REL_RE.finditer(text):
        real = os.path.join(VAULT, m.group(1))
        if os.path.isfile(real):
            out.append((m.group(1), real))
    return out


def where_section(body):
    m = re.search(r"^## Where things are\n(.*?)(?=^## |\Z)", body, re.S | re.M)
    return m.group(1) if m else ""


def short_lived(p):
    return any(os.path.realpath(p).startswith(s) or p.startswith(s) for s in SHORT_LIVED)


def in_vault(p):
    return os.path.realpath(p).startswith(os.path.realpath(VAULT) + "/")


def area_of(folder):
    """A short name for where the thread worked: the project, the school subject or the vault area."""
    rel = os.path.relpath(os.path.realpath(folder), os.path.realpath(HOME)) if folder else "."
    if rel.startswith(".."):
        return os.path.basename(folder.rstrip("/")) or folder
    parts = [] if rel == "." else rel.split(os.sep)
    if parts[:1] == ["Projects"] and len(parts) > 1:
        return parts[1]
    if parts[:2] == ["Documents", "Schule"] and len(parts) > 2:
        return "School " + parts[2]
    if parts[:1] == ["Notes"]:
        return parts[1] if len(parts) > 1 else "Notes"
    if parts[:2] == ["Documents", "Diplomarbeit"]:
        return "Diplomarbeit"
    if not parts or parts[:3] == [".local", "share", "claude-hub"]:
        return "home"
    return parts[-1]


def first_line(text):
    """The answer's first line as plain text: the thread's one-line report."""
    for l in text.splitlines():
        if re.fullmatch(r"\s*(\[\[[^\]]*\]\]|`?~?/\S+`?)\s*", l):     # a link or path on its own line
            continue
        l = re.sub(r"\[\[(?:[^\]|]*\|)?([^\]]*)\]\]", r"\1", l)
        l = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", l)
        l = " ".join(re.sub(r"[*`#>]", "", l).split()).strip(" -")
        if l:
            return l[:200]
    return ""


NOTE_EXT = (".md", ".canvas", ".base")


def result_file(real):
    """Not a result: the cards themselves, CLAUDE.md files, code in the vault, agentic's own state and logs."""
    r = os.path.realpath(real)
    rel = os.path.relpath(r, os.path.realpath(HOME))
    return not (r.startswith(os.path.realpath(RESULTS) + "/") or os.path.basename(r) == "CLAUDE.md"
                or "/deploy/" in r or "/.git/" in r
                or rel.startswith((".local/share/agentic/", ".local/state/", ".cache/", ".claude/")))


def vault_link(real):
    rel = os.path.relpath(os.path.realpath(real), os.path.realpath(VAULT))
    if rel.endswith(".md"):
        rel = rel[:-3]
    return f"[[{rel}|{os.path.basename(rel)}]]" if "/" in rel else f"[[{rel}]]"


def copy_into(src, folder):
    """Copy a file into folder (made on demand); a different file with the same name gets -2, -3, ..."""
    os.makedirs(folder, exist_ok=True)
    base, ext = os.path.splitext(os.path.basename(src))
    dest, n = os.path.join(folder, base + ext), 2
    while os.path.exists(dest):
        if open(dest, "rb").read() == open(src, "rb").read():
            return dest
        dest, n = os.path.join(folder, f"{base}-{n}{ext}"), n + 1
    shutil.copy2(src, dest)
    return dest


def collect_files(text, body, tpath, stem):
    """What the result points to: files named in the answer or under "Where things are", and vault notes the
    session wrote. Short-lived files are copied next to the card (Results/files/<card>/). Returns (rewrites
    {path as written: link}, lines for the Files section)."""
    # The state file names code and logs too: from there only vault files and short-lived ones count. Of the
    # files the session wrote, only vault notes (code in the vault, like Homelab/deploy, is not a result).
    found = mentioned_paths(text)
    found += [(r, p) for r, p in mentioned_paths(where_section(body)) if in_vault(p) or short_lived(p)]
    found += [(p, p) for p in written_files(tpath) if in_vault(p) and os.path.isfile(p)
              and os.path.splitext(p)[1].lower() in NOTE_EXT]
    rewrites, entries, done = {}, [], {}
    for raw, real in found:
        if not result_file(real):
            continue
        if real in done:
            if done[real]:
                rewrites.setdefault(raw, done[real])
            continue
        link = ""
        if in_vault(real):
            link = vault_link(real)
            entries.append(f"- {link}")
        elif short_lived(real):
            size = os.path.getsize(real)
            if size > COPY_MAX:
                entries.append(f"- `{os.path.basename(real)}` not copied ({size // 1048576} MB, over "
                               f"{COPY_MAX // 1048576} MB), still at `{real}` for now")
            else:
                link = vault_link(copy_into(real, os.path.join(RESULTS, "files", stem)))
                entries.append(f"- {link} (copied from `{real}`)")
        else:
            entries.append(f"- [{os.path.basename(real)}](file://{real.replace(' ', '%20')}) `{real.replace(HOME, '~', 1)}`")
        done[real] = link
        if link:
            rewrites[raw] = link
    return rewrites, entries


def relink(text, rewrites):
    """Paths in the answer that have a place in the vault point there: a markdown link target gets the vault
    path, a path in backticks or on its own becomes a wikilink."""
    for raw in sorted(rewrites, key=len, reverse=True):
        link = rewrites[raw]
        target = link[2:-2].split("|")[0]
        target += "" if os.path.splitext(target)[1] else ".md"
        text = text.replace(f"]({raw})", "](" + target.replace(" ", "%20") + ")")
        text = text.replace(f"`{raw}`", link)
        text = re.sub(r"(?<![\w/.\[(~-])" + re.escape(raw) + r"(?![\w/|\]])", lambda _: link, text)
    return text


def find_card(session):
    """The card of a thread session, by its `session:` property (it may have been renamed in Obsidian)."""
    for f in glob.glob(os.path.join(RESULTS, "*.md")):
        try:
            head = open(f, encoding="utf-8").read(4000)
        except OSError:
            continue
        if re.search(rf"^session: ['\"]?{re.escape(session)}['\"]?\s*$", head, re.M):
            return f
    return None


def card_is_read(card):
    try:
        head = open(card, encoding="utf-8").read(4000)
    except OSError:
        return False
    m = re.search(r"^read:\s*(\S+)", head, re.M)
    return bool(m) and m.group(1).lower() in ("true", "yes")


def write_card(name, fm, tpath, until=None, read_flag=None):
    """The thread's result card in ~/Notes/Results: one per thread session, its newest answer on top, earlier
    ones below. Called at every done stop; an answer it already has changes nothing, and a card the owner
    marked read stays read. read_flag: read or not for a new answer (backfill); default unread.
    Returns the card's path, or None when there is no answer."""
    session = fm.get("session") or ""
    got = answers(tpath, until)
    if not got or not session:
        return None
    ts, text = got[-1]
    rec_path = os.path.join(RESULT_DATA, session + ".json")
    try:
        rec = json.load(open(rec_path, encoding="utf-8"))
    except (OSError, ValueError):
        rec = {"thread": name, "session": session, "results": []}
    h = hashlib.sha1(text.encode()).hexdigest()
    card = find_card(session)
    fresh = not rec["results"] or rec["results"][-1]["hash"] != h
    if not fresh and card:
        return card
    when = datetime.fromtimestamp(ts or time.time())
    if not card:
        stem, n = f"{when:%Y-%m-%d}-{name}", 2
        while os.path.exists(os.path.join(RESULTS, stem + ".md")):
            stem, n = f"{when:%Y-%m-%d}-{name}-{n}", n + 1
        card = os.path.join(RESULTS, stem + ".md")
    stem = os.path.basename(card)[:-3]
    body = read(name)[1] or ""
    rewrites, entries = collect_files(text, body, tpath, stem)
    entry = {"at": when.isoformat(timespec="minutes"), "hash": h, "text": relink(text, rewrites), "files": entries}
    if fresh:
        rec["results"].append(entry)
        unread = True if read_flag is None else not read_flag
    else:                       # the card was deleted: write it again as it was
        rec["results"][-1] = entry
        unread = read_flag is not True
    rec["card"] = os.path.basename(card)
    newest = rec["results"][-1]
    folder = fm.get("folder", "")
    q = lambda s: json.dumps(s, ensure_ascii=False)
    props = [("type", "result"), ("thread", name), ("date", newest["at"]), ("updated", newest["at"][:10]),
             ("area", q(area_of(folder))), ("status", "done"), ("read", "false" if unread else "true"),
             ("summary", q(first_line(newest["text"]))), ("folder", q(folder.replace(HOME, "~", 1))),
             ("session", session)]
    files = []
    for r in reversed(rec["results"]):
        files += [f for f in r["files"] if f not in files]
    out = ["---"] + [f"{k}: {v}" for k, v in props] + ["---", "", "## Result", "",
                                                         f"*{newest['at'].replace('T', ' ')}, thread `{name}`*", "",
                                                         newest["text"].rstrip(), ""]
    if files:
        out += ["## Files", ""] + files + [""]
    if len(rec["results"]) > 1:
        out += ["## Earlier results", ""]
        for r in reversed(rec["results"][:-1]):
            out += [f"> [!quote]- {r['at'].replace('T', ' ')}"] + \
                   [("> " + l).rstrip() for l in r["text"].rstrip().splitlines()] + [""]
    out += ["## Thread", "", f"- State: `{path(name).replace(HOME, '~', 1)}` (`thread show {name}`)",
            f"- Folder: `{folder.replace(HOME, '~', 1)}`", f"- Go on with it: `thread resume {name}`", ""]
    os.makedirs(RESULTS, exist_ok=True)
    with open(card + ".tmp", "w", encoding="utf-8") as f:
        f.write("\n".join(out))
    os.replace(card + ".tmp", card)
    os.makedirs(RESULT_DATA, exist_ok=True)
    with open(rec_path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(rec, f, ensure_ascii=False, indent=1)
    os.replace(rec_path + ".tmp", rec_path)
    return card


def cmd_result(args):
    if "--backfill" in args:
        since = args[args.index("--since") + 1] if "--since" in args[:-1] else \
            datetime.fromtimestamp(time.time() - 14 * 86400).strftime("%Y-%m-%d")
        cut = datetime.fromisoformat(since).timestamp()
        last = {}
        for e in load_events():
            if e.get("event") == "stop" and e.get("label") == "done" and e["ts"] >= cut and e.get("session"):
                last[(e["thread"], e["session"])] = e
        today = datetime.now().strftime("%Y-%m-%d")
        for (name, session), e in sorted(last.items(), key=lambda kv: kv[1]["ts"]):
            tp = transcript_of(session)
            have = find_card(session)
            print(f"{e['at'][:16]}  {name:28} {'has a card' if have else 'no transcript' if not tp else 'new card'}")
            if have or not tp or "--dry-run" in args:
                continue
            fm = dict(read(name)[0] or {}, session=session)
            card = write_card(name, fm, tp, until=e["ts"] + 5, read_flag=not e["at"].startswith(today))
            print(f"{'':18}-> {card.replace(HOME, '~', 1) if card else 'no answer found'}")
        return
    if not args:
        sys.exit("thread result <name> [--transcript <file>] | --backfill [--since YYYY-MM-DD] [--dry-run]")
    name = slug(args[0])
    fm, _ = read(name)
    if fm is None:
        sys.exit(f"No thread '{name}'.")
    tp = args[args.index("--transcript") + 1] if "--transcript" in args[:-1] else transcript_of(fm.get("session", ""))
    if not tp:
        sys.exit(f"No transcript for '{name}'.")
    card = write_card(name, fm, tp)
    print(card.replace(HOME, "~", 1) if card else f"'{name}' has no answer yet.")



# ---- thread watch: a stuck thread is not silent ----------------------------------------------------------

WATCH = os.path.join(os.path.dirname(PROGRESS), "watch")
QUIET = 600


def last_tool(tpath):
    """The last tool call in a transcript, short ("Bash: npm test")."""
    try:
        with open(tpath, "rb") as f:
            f.seek(max(0, os.path.getsize(tpath) - 200_000))
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") != "assistant":
            continue
        for b in reversed((e.get("message") or {}).get("content") or []):
            if isinstance(b, dict) and b.get("type") == "tool_use":
                i = b.get("input") or {}
                what = i.get("description") or i.get("command") or i.get("file_path") or i.get("prompt") or ""
                return f"{b.get('name')}: {' '.join(str(what).split())[:80]}"
    return ""


def last_entry_ts(tpath, tail=262144):
    """The time of the transcript's newest entry that has a timestamp (from its last 256 KB), else 0."""
    try:
        with open(tpath, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - tail))
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return 0.0
    for line in reversed(lines):
        m = re.search(r'"timestamp":\s*"([^"]+)"', line)
        if m:
            ts = iso_ts(m.group(1))
            if ts:
                return ts
    return 0.0


def newest_mtime(path):
    """The newest change of a file, or of anything below a folder (a session's subagents and tool output)."""
    best = 0.0
    try:
        best = os.path.getmtime(path)
    except OSError:
        return 0.0
    if os.path.isdir(path):
        for root, dirs, files in os.walk(path):
            for n in files:
                try:
                    best = max(best, os.path.getmtime(os.path.join(root, n)))
                except OSError:
                    pass
    return best


# The footer counter Claude Code shows while background work runs (same pattern as the stop hook).
BACKGROUND = re.compile(r"[0-9]+ background agents?|[0-9]+ shells?")


def in_background(screen, p):
    """Background work runs for the thread (a shell or agent in its pane's footer), or its stop said it waits on
    some (the stop hook's progress "in the background: ..."). It continues by itself when that work reports."""
    return bool(BACKGROUND.search("\n".join(screen.splitlines()[-8:]))) \
        or str(p.get("detail", "")).startswith("in the background")


def retire_finished(ag, wins, now=None):
    """Stop and archive threads that are finished: idle (or left open, its session gone) at total/total,
    nothing open for the owner, their last
    event a done stop whose result card exists, and nothing new in the transcript for RETIRE_AFTER. Never
    KEEP_OPEN or adopted sessions, never a thread the owner has on screen (a tmux client shows its pane) or one
    with a dialog or typed text (stop() checks). One quiet inbox line each, no wake. Returns the names."""
    now = now or time.time()
    last = {}
    for e in load_events():
        last[(e["thread"], e.get("session", ""))] = e
    shown = set(sh(["tmux", "list-clients", "-F", "#{pane_id}"]).split())
    done = []
    for t in all_threads():
        name, session = t["name"], t.get("session", "")
        st = steps(t)
        state = live_state(t, ag, wins)
        keep = t.get("profile") and t.get("archive") != "auto"      # profile threads stay unless archive: auto
        if name in KEEP_OPEN or keep or t.get("origin") == "adopted" or not st or st[0] != st[1] or t.get("needs") \
                or open_round(name) or not (state == "idle" and name in wins or state == "left open"):
            continue
        e = last.get((name, session))
        if not e or e.get("event") != "stop" or e.get("label") != "done" or not (find_card(session) or silent(t)):
            continue
        tpath = transcript_of(session)
        if now - max(e["ts"], newest_mtime(tpath) if tpath else 0.0) < RETIRE_AFTER \
                or name in wins and wins[name][2] in shown:
            continue
        try:
            if state == "left open":             # its session is gone already (a reboot): nothing to stop
                clear_progress(name)
            elif not stop(name):
                continue
        except Exception as ex:                  # one thread that can't be stopped never stops the watch
            print(f"thread watch: could not stop '{name}': {ex}", file=sys.stderr)
            continue
        fm, body = read(name)
        fm["status"] = "archived"
        write(name, fm, body)
        if not silent(fm):                       # a silent thread leaves no inbox line, not even this one
          subprocess.run([os.path.join(HOME, ".local/bin/inbox"), "add", "archived", "thread",
                        f"'{name}': finished and idle for {RETIRE_AFTER // 60} min, stopped and archived "
                        f"(result in `results`, `thread resume {name}` brings it back)"],
                       stdin=subprocess.DEVNULL, capture_output=True)
        done.append(name)
    return done


def cmd_watch(args):
    """Run by a user timer every 5 minutes (started by `agentic on`). A thread still in its turn is quiet when
    its pane (digits and spinners aside), its transcript entries and its session folder (subagents) all stayed
    the same for 10 minutes. Each quiet spell gives one inbox line with a wake. A thread idle at its prompt is
    never quiet: its turn ended, and its stop already told the main chat. A thread waiting on its background work (a render queue, a watcher) waits like
    one waiting for the owner, and is never quiet. Code only, no Claude call."""
    if os.path.exists(os.path.join(os.path.dirname(PROGRESS), "off")):
        return
    os.makedirs(WATCH, exist_ok=True)
    ag, wins = agents(), windows()
    now = time.time()
    settle(ag, wins, now)
    if retire_finished(ag, wins, now):
        wins = windows()
    seen = set()
    for t in all_threads():
        name = t["name"]
        st = live_state(t, ag, wins)
        wf = os.path.join(WATCH, name + ".json")
        if st in ("stopped", "left open") or name not in wins or silent(t):
            continue
        try:
            p = json.load(open(os.path.join(PROGRESS, name + ".json")))
        except (OSError, ValueError):
            p = {}
        # Only a turn that is still running can stall. A thread idle at its prompt ended its turn on purpose
        # (done, paused, waiting for something): its stop already reached the main chat (owner, 2026-11-21).
        working = st == "working" or p.get("state") == "working"
        waits = bool(t.get("needs")) or bool(open_round(name)) or st == "waiting" or p.get("state") == "needs you"
        if waits or not working:
            try:
                os.remove(wf)
            except OSError:
                pass
            continue
        screen = subprocess.run(["tmux", "capture-pane", "-p", "-t", wins[name][2]], capture_output=True,
                                text=True).stdout
        if in_background(screen, p):
            try:
                os.remove(wf)
            except OSError:
                pass
            continue
        seen.add(name)
        # The spinner and its timer change while nothing happens; leave them out of the fingerprint.
        norm = re.sub(r"[0-9]+|[✻✽✶✳✢·*●◐◑◒◓⏺]", "", screen)
        fp = hashlib.sha1(norm.encode()).hexdigest()
        tpath = (glob.glob(os.path.join(HOME, ".claude/projects/*", t.get("session", "x") + ".jsonl")) or [""])[0]
        # Progress is a new transcript entry or a change in its subagents, not the file's time: Claude Code also
        # appends bookkeeping records without a timestamp (17:19 on 2026-11-21 that started a second report).
        act = max(last_entry_ts(tpath), newest_mtime(tpath[:-6])) if tpath else 0.0
        try:
            w = json.load(open(wf))
        except (OSError, ValueError):
            w = {"fp": fp, "fp_at": now}
        if w.get("fp") != fp:
            w["fp"], w["fp_at"] = fp, now
        last = max(w.get("fp_at", now), act)
        quiet = now - last
        # One line per quiet period: it ends only with new transcript or subagent progress, never with a
        # changed screen alone, so a screen that flickers can't report the same stall again.
        if quiet >= QUIET and w.get("reported") != act:
            lt = last_tool(tpath) if tpath else ""
            text = (f"'{name}': quiet for {int(quiet // 60)} min mid-turn (nothing changed on screen, in the "
                    f"transcript or its subagents)" + (f"; last tool call: {lt}" if lt else ""))
            subprocess.run([os.path.join(HOME, ".local/bin/inbox"), "add", "--wake", "stalled", "thread", text],
                           stdin=subprocess.DEVNULL, capture_output=True)
            w["reported"] = act
        with open(wf + ".tmp", "w") as f:
            json.dump(w, f)
        os.replace(wf + ".tmp", wf)
    for f in glob.glob(os.path.join(WATCH, "*.json")):
        if os.path.basename(f)[:-5] not in seen:
            os.remove(f)

# ---- thread durations: how long thread work takes, from durations.jsonl and the transcripts ------------

def iso_ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def load_events(path=None):
    out = []
    try:
        with open(path or DURATIONS, encoding="utf-8") as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if isinstance(e, dict) and e.get("thread") and isinstance(e.get("ts"), (int, float)):
                    out.append(e)
    except OSError:
        pass
    out.sort(key=lambda e: e["ts"])
    return out


def transcript_of(session):
    return (glob.glob(os.path.join(HOME, ".claude/projects/*", session + ".jsonl")) or [""])[0] if session else ""


def is_notification(text):
    """A background task (subagent, shell) reporting back: the session was working, not waiting."""
    return text.lstrip().startswith("<task-notification>") and "artifact-auto-react" not in text


def entry_text(c):
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(str(b.get("text", "")) for b in c if isinstance(b, dict))
    return ""


def activity(tpath):
    """A session's timeline from its transcript: (gaps, prompts). gaps: [(end, seconds)], the time between two
    entries that the session spent working, i.e. the later entry is the model's answer, a tool result, the
    end of a compaction or its summary, or a background task reporting back. A gap that ends in a message from outside (the
    owner, the main chat, an answer round) was waiting and is left out, and so is every gap ending in other
    bookkeeping entries (a resume writes some). prompts: the times of the outside messages."""
    gaps, prompts, prev = [], [], None
    try:
        f = open(tpath, encoding="utf-8", errors="ignore")
    except OSError:
        return gaps, prompts
    with f:
        for line in f:
            if '"timestamp"' not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            t = iso_ts(e.get("timestamp") or "")
            typ, work, prompt = e.get("type"), False, False
            # Only the conversation itself: bookkeeping lines (api-request, queue-operation) can be written in
            # a block ahead of the messages they belong to and would push the timeline forward.
            if t is None or typ not in ("user", "assistant", "system", "attachment"):
                continue
            if typ == "assistant" or (typ == "system" and e.get("subtype") == "compact_boundary"):
                work = True
            elif typ == "user":
                c = (e.get("message") or {}).get("content")
                if e.get("isCompactSummary") or (isinstance(c, list) and any(
                        isinstance(b, dict) and b.get("type") == "tool_result" for b in c)):
                    work = True
                elif not e.get("isMeta"):
                    work = is_notification(entry_text(c))
                    prompt = not work
            elif typ == "attachment" and (e.get("attachment") or {}).get("type") == "queued_command":
                work = is_notification(str(e["attachment"].get("prompt") or ""))
                prompt = not work
            if work and prev is not None and t > prev:
                gaps.append((t, t - prev))
            if prompt:
                prompts.append(t)
            prev = t if prev is None else max(prev, t)
    return gaps, prompts


def work_between(gaps, a, b):
    """Seconds of work between a and b (a gap that started before a counts from a)."""
    return sum(min(g, end - a) for end, g in gaps if a < end <= b)


def new_run(name, e, **kw):
    return dict({"thread": name, "session": e.get("session", ""), "model": e.get("model", ""), "start": e["ts"],
                 "partial": False, "follow_up": False, "after": None, "base": 0, "steps": [], "done_at": None,
                 "finished": False}, **kw)


def build_runs(events):
    """Runs of work per thread. A run begins at `start` (or, after a finished run, at the next step below its
    total: new work in the same thread) and finishes at done: the stop labelled done after the step
    total/total, else (no such stop, or the thread was ended) that step. A run whose start was never logged
    is partial and stays out of the medians."""
    by = {}
    for e in events:
        by.setdefault(e["thread"], []).append(e)
    runs = []
    for name, evs in by.items():
        cur = None
        for e in evs:
            ev = e.get("event")
            if ev == "start":
                if cur and not cur["finished"] and cur["done_at"]:
                    cur["finished"] = True
                cur = new_run(name, e)
                runs.append(cur)
                continue
            if cur is None and ev != "step":
                continue
            if ev in ("model", "resume") and not cur["finished"] and e.get("model"):
                cur["model"] = e["model"]
            elif ev == "step":
                d, t = e.get("done"), e.get("total")
                if not isinstance(d, int) or not isinstance(t, int) or t <= 0:
                    continue
                if cur is None:
                    cur = new_run(name, e, partial=True)
                    runs.append(cur)
                elif cur["done_at"] and not cur["finished"] and d < t:
                    cur["finished"] = True       # reached total/total, then new work without a done stop
                if cur["finished"]:
                    if d >= t:
                        continue                 # total/total again after done
                    prev = cur
                    prev_total = prev["steps"][-1]["total"] if prev["steps"] else 0
                    cur = new_run(name, e, follow_up=True, after=prev["done_at"],
                                  base=prev_total if d >= prev_total else 0, model=e.get("model") or prev["model"])
                    runs.append(cur)
                cur["steps"].append(e)
                cur["done_at"] = e["ts"] if d == t else None
            elif ev == "stop" and cur["done_at"] and not cur["finished"]:
                if e.get("label") == "done":
                    cur["done_at"], cur["finished"] = e["ts"], True
            elif ev == "end" and cur["done_at"]:
                cur["finished"] = True
        if cur and cur["done_at"]:
            cur["finished"] = True               # at total/total; its done stop may still come
    return runs


def dur(sec):
    if sec is None:
        return "?"
    m = int(round(sec / 60))
    return f"{m} min" if m < 60 else f"{m // 60} h {m % 60:02d}"


def median(xs):
    xs = sorted(x for x in xs if x is not None)
    if not xs:
        return None
    n = len(xs)
    return xs[n // 2] if n % 2 else (xs[n // 2 - 1] + xs[n // 2]) / 2


def measure(runs, now=None):
    """Fill each run with its times: start (a follow-up begins at the first outside message after the done
    before it), end, wall (start to done, waiting included), work (only the time the session was working,
    from its transcript), steps and its step list with times."""
    now = now or time.time()
    cache = {}
    for r in runs:
        sid = r["session"]
        if sid not in cache:
            tp = transcript_of(sid)
            cache[sid] = activity(tp) if tp else None
        act = cache[sid]
        if r["follow_up"] and act:
            first_step = r["steps"][0]["ts"]
            p = [t for t in act[1] if r["after"] < t <= first_step]
            r["start"] = p[0] if p else r["start"]
        r["end"] = r["done_at"] if r["finished"] else now
        r["wall"] = r["end"] - r["start"]
        r["work"] = work_between(act[0], r["start"], r["end"]) if act else None
        last = r["steps"][-1] if r["steps"] else None
        r["total"] = last["total"] if last else 0
        r["n_steps"] = max(r["total"] - r["base"], 1) if last else 0
        r["done"] = last["done"] if last else 0
        r["per_step"] = r["work"] / r["n_steps"] / 60 if r["work"] is not None and r["n_steps"] else None
        prev = r["start"]
        r["step_list"] = []
        for s in r["steps"]:
            r["step_list"].append({"at": s["ts"], "done": s["done"], "total": s["total"], "next": s.get("next", ""),
                                   "wall": s["ts"] - prev,
                                   "work": work_between(act[0], prev, s["ts"]) if act else None})
            prev = max(prev, s["ts"])
    return runs


def backfill_thread(name, fm, tpath):
    """Events for one thread from its transcript: start at its first message, every `thread step` the thread
    ran itself (only when its output line "<name>: d/t" is in the tool result, so a failed or quoted command
    doesn't count), and a stop labelled done where the turn with a step total/total ended."""
    pending, seen, steps, first = {}, set(), [], None
    out_re = re.compile(rf"^{re.escape(name)}: (\d+)/(\d+) ?(.*)$", re.M)
    try:
        f = open(tpath, encoding="utf-8", errors="ignore")
    except OSError:
        return []
    with f:
        for line in f:
            if '"timestamp"' not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            t = iso_ts(e.get("timestamp") or "")
            if t is None or e.get("type") not in ("user", "assistant"):
                continue
            if first is None:
                first = t
            content = (e.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for b in content:
                if not isinstance(b, dict):
                    continue
                if e["type"] == "assistant" and b.get("type") == "tool_use" and b.get("name") == "Bash" \
                        and b.get("id") not in seen \
                        and re.search(r"(^|[;&|(\s])thread\s+step\s+([\w.-]+\s+)?\d+/\d+", str((b.get("input") or {}).get("command", ""))):
                    seen.add(b.get("id"))
                    pending[b.get("id")] = t
                elif e["type"] == "user" and b.get("type") == "tool_result" and b.get("tool_use_id") in pending:
                    m = out_re.search(entry_text(b.get("content")))
                    at = pending.pop(b["tool_use_id"])
                    if m and 0 < int(m.group(2)) and int(m.group(1)) <= int(m.group(2)):
                        steps.append((at, int(m.group(1)), int(m.group(2)), m.group(3).strip()))
    if not steps or first is None:
        return []
    base = {"thread": name, "session": fm.get("session", ""), "model": fm.get("model", ""), "src": "backfill"}
    mk = lambda ts, ev, **kw: dict(base, ts=round(ts, 1), at=datetime.fromtimestamp(ts).astimezone()
                                   .isoformat(timespec="seconds"), event=ev, **kw)
    events = [mk(first, "start", folder=fm.get("folder", ""))]
    gaps, prompts = activity(tpath)
    for at, d, tot, nxt in steps:
        events.append(mk(at, "step", done=d, total=tot, next=nxt[:120]))
        if d == tot:
            nxt_prompt = min([p for p in prompts if p > at] or [float("inf")])
            ends = [end for end, _ in gaps if at <= end < nxt_prompt]
            if ends:
                events.append(mk(max(ends), "stop", label="done", detail=f"{d}/{tot}"))
    return events


def cmd_backfill(dry):
    """Once, idempotent: events from the transcripts of threads that recorded steps before the log existed.
    Skips adopted sessions and sessions already backfilled; for a session with live events, only what came
    before its first live event."""
    have = load_events()
    done_sessions = {e.get("session") for e in have if e.get("src") == "backfill"}
    first_live = {}
    for e in have:
        if e.get("src") != "backfill":
            first_live.setdefault(e.get("session"), e["ts"])
    add = []
    for t in all_threads(archived=True):
        sid = t.get("session", "")
        if t.get("origin") == "adopted" or not sid or sid in done_sessions:
            continue
        tp = transcript_of(sid)
        evs = [e for e in backfill_thread(t["name"], t, tp) if e["ts"] < first_live.get(sid, float("inf"))] if tp else []
        if evs:
            add += evs
            print(f"{t['name']:33} {len(evs):3} events from {os.path.basename(tp)}")
    if dry or not add:
        print(("Would add" if dry else "Added") + f" {len(add)} events.")
        return
    add.sort(key=lambda e: e["ts"])
    os.makedirs(DATA, exist_ok=True)
    fd = os.open(DURATIONS, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, "".join(json.dumps(e, ensure_ascii=False) + "\n" for e in add).encode())
    finally:
        os.close(fd)
    print(f"Added {len(add)} events to {DURATIONS}.")


def run_json(r):
    keys = ["thread", "session", "model", "start", "end", "finished", "partial", "follow_up", "wall", "work",
            "n_steps", "done", "total", "per_step", "step_list"]
    return {k: r.get(k) for k in keys}


def cmd_durations(args):
    if "--backfill" in args:
        cmd_backfill("--dry-run" in args)
        return
    names = [slug(a) for a in args if not a.startswith("--")]
    runs = build_runs(load_events())
    if names:
        runs = [r for r in runs if r["thread"] in names]
    measure(runs)
    status = {t["name"]: t.get("status") for t in all_threads(archived=True)}
    done = [r for r in runs if r["finished"]]
    full = [r for r in done if not r["partial"]]
    open_runs = [r for r in runs if not r["finished"] and (names or status.get(r["thread"]) == "running")]
    med = {"runs": len(full), "wall": median(r["wall"] for r in full), "work": median(r["work"] for r in full),
           "steps": median(r["n_steps"] for r in full), "per_step": median(r["per_step"] for r in full)}
    if "--json" in args:
        print(json.dumps({"finished": [run_json(r) for r in done], "open": [run_json(r) for r in open_runs],
                          "median": med}, ensure_ascii=False))
        return
    if not runs:
        print(f"No thread events{' for ' + ', '.join(names) if names else ''} yet ({DURATIONS}).")
        return
    hhmm = lambda ts: datetime.fromtimestamp(ts).strftime("%m-%d %H:%M")
    print("work: time the thread was working (waiting for the owner or the main chat left out); "
          "wall: start to done.")
    head = f"{'thread':33} {'model':6} {'started':11}  {'work':>8} {'wall':>8} {'steps':>5} {'min/step':>8}"
    if done:
        print("\nFinished\n" + head)
        for r in done:
            mark = " (partial: start not logged)" if r["partial"] else " (follow-up)" if r["follow_up"] else ""
            ps = f"{r['per_step']:.1f}" if r["per_step"] is not None else "?"
            print(f"{r['thread']:33} {r['model']:6} {hhmm(r['start'])}  {dur(r['work']):>8} {dur(r['wall']):>8} "
                  f"{r['n_steps']:>5} {ps:>8}{mark}")
    if open_runs:
        print("\nIn progress (so far)\n" + head.replace("steps", " step"))
        for r in open_runs:
            mark = " (partial: start not logged)" if r["partial"] else " (follow-up)" if r["follow_up"] else ""
            st = f"{r['done']}/{r['total']}" if r["steps"] else "-"
            print(f"{r['thread']:33} {r['model']:6} {hhmm(r['start'])}  {dur(r['work']):>8} {dur(r['wall']):>8} "
                  f"{st:>5} {'':>8}{mark}")
    if full:
        print(f"\nMedians over {med['runs']} finished run{'s' if med['runs'] > 1 else ''}: work {dur(med['work'])}, "
              f"wall {dur(med['wall'])}, {med['steps']:g} steps, "
              + (f"{med['per_step']:.1f} min of work per step" if med["per_step"] is not None else "? min per step"))
    elif done:
        print("\nNo finished run with a logged start yet, so no medians.")
    if names:
        for r in done + open_runs:
            print(f"\n{r['thread']} ({r['model']}), from {hhmm(r['start'])}"
                  + (f" to {hhmm(r['end'])}" if r["finished"] else ", still open") + ":")
            print("  each line: when the step was recorded, and the time since the line before it")
            for s in r["step_list"]:
                print(f"  {hhmm(s['at'])}  {s['done']:>2}/{s['total']:<2} work {dur(s['work']):>8}  wall "
                      f"{dur(s['wall']):>8}  {s['next'][:70]}")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, rest = a[0], a[1:]
    if cmd == "list":
        cmd_list(rest)
    elif cmd == "start":
        cmd_start(rest)
    elif cmd == "profiles":
        cmd_profiles(rest)
    elif cmd == "show":
        fm, body = read(slug(rest[0]) if rest else "")
        if fm is None:
            sys.exit("thread show <name>")
        print(open(path(slug(rest[0]))).read())
    elif cmd == "stop":
        if rest and rest[0] == "--all":
            # Only threads started by `thread`; adopted sessions are mine and stay.
            ag, wins = agents(), windows()
            for t in running(ag, wins, include_adopted=True):
                if t.get("origin") != "adopted":
                    stop(t["name"])
        elif rest:
            stop(slug(rest[0]))
        else:
            sys.exit("thread stop <name> | --all")
    elif cmd == "resume":
        cmd_resume(rest)
    elif cmd == "model":
        cmd_model(rest)
    elif cmd == "step":
        cmd_step(rest)
    elif cmd == "progress":
        cmd_progress(rest)
    elif cmd == "send":
        cmd_send(rest)
    elif cmd == "adopt":
        cmd_adopt(rest)
    elif cmd == "needs":
        cmd_needs(rest)
    elif cmd == "ask":
        cmd_ask(rest)
    elif cmd == "questions":
        cmd_questions(rest)
    elif cmd == "answer":
        cmd_answer(rest)
    elif cmd == "signal":
        cmd_signal(rest)
    elif cmd == "result":
        cmd_result(rest)
    elif cmd == "watch":
        cmd_watch(rest)
    elif cmd == "durations":
        cmd_durations(rest)
    elif cmd == "archive":
        if not rest:
            sys.exit("thread archive <name>...")
        ag, wins = agents(), windows()
        for n in map(slug, rest):
            fm, body = read(n)
            if not fm:
                print(f"No thread '{n}'.")
            elif live_state(fm, ag, wins) not in ("stopped", "left open"):
                print(f"'{n}' is running; stop it first.")
            else:
                fm["status"] = "archived"
                write(n, fm, body)
                print(f"Archived '{n}'; `thread resume {n}` brings it back.")
    elif cmd == "rm":
        if rest and os.path.exists(path(slug(rest[0]))):
            os.remove(path(slug(rest[0])))
            try:
                os.remove(keep_path(slug(rest[0])))
            except OSError:
                pass
            print(f"Forgot '{slug(rest[0])}'; its transcript stays.")
        else:
            sys.exit("thread rm <name>")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
