#!/usr/bin/env bash
# The lock screen of theme root-agentic: its own Quickshell config (~/.config/quickshell/lock), run as its
# own process like hyprlock, with hyprlock as the fallback. idle.sh keeps hyprlock until the owner has
# unlocked this one with their own password once.
#   agentic-lock               lock now; hyprlock when the Quickshell lock can't lock or dies
#   agentic-lock --trial [N]   the first try: the lock unlocks by itself after N seconds (default 90)
# Under the clock it shows `agentic brief`: "lock_brief" in the rendered agentic.json, full, counts (only
# the lines that say how many, never task names or subjects) or off; default counts.
# The last run's log: ~/.cache/agentic/lock.log.

set -u
# idle.sh runs with Hyprland's environment, which has no ~/.local/bin: the brief needs atlas, thread, inbox.
[[ :$PATH: == *":$HOME/.local/bin:"* ]] || export PATH="$HOME/.local/bin:$PATH"
dir="${AGENTIC_LOCK_DIR:-$HOME/.config/quickshell/lock}"
conf="${QS_AGENTIC_CONF:-$HOME/dotfiles/theme/current/agentic.json}"
log="${XDG_CACHE_HOME:-$HOME/.cache}/agentic/lock.log"
trial=0
case ${1:-} in
    "") ;;
    --trial) trial=${2:-90} ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: agentic-lock [--trial [seconds]]" >&2; exit 2 ;;
esac
[[ $trial =~ ^[0-9]+$ ]] || { echo "agentic-lock: --trial takes a number of seconds" >&2; exit 2; }

# Locked already, by either lock.
pidof hyprlock >/dev/null && exit 0
pgrep -u "$UID" -f "^qs -p $dir\$" >/dev/null && exit 0
[[ -f $dir/shell.qml ]] || exec hyprlock

brief=$(jq -r '.lock_brief // "counts"' "$conf" 2>/dev/null)
[[ $brief == full || $brief == counts || $brief == off ]] || brief=counts
mkdir -p "${log%/*}"
AGENTIC_LOCK_TRIAL=$trial AGENTIC_LOCK_BRIEF=$brief qs -p "$dir" >"$log" 2>&1
rc=$?
# 0: unlocked. 3: the compositor didn't confirm the lock (another lock, no support). Anything else: it
# died, maybe with the session still locked; misc.allow_session_lock_restore lets hyprlock take over.
((rc == 0)) && exit 0
echo "agentic-lock: the Quickshell lock ended with $rc, starting hyprlock" >>"$log"
exec hyprlock
