#!/usr/bin/env python3
"""theme: switch the whole desktop between the themes in ~/dotfiles/theme/themes/.

    theme                    the current theme and the ones there are
    theme set NAME           render NAME and switch everything to it
    theme apply              render the current theme again (after editing a palette
                             or a template), keeps the wallpaper you picked
    theme render NAME DIR    only render NAME into DIR, change nothing (to diff or check)
    theme preview NAME OUT.png   draw a mock desktop in NAME's real colours, fonts and
                             wallpaper (what the launcher's Theme mode shows); previews
                             are cached in ~/.cache/theme-previews by 
    theme hook enter|leave   run the current theme's hook (Hyprland runs `enter` at login)

How it fits together (details in the README, "Themes"):

  theme/themes/<name>/theme.toml   one palette, fonts, shape and assets per theme
  theme/templates/                 one file per app, with {{ ... }} where colours go
  theme/themes/<name>/templates/   optional: a theme's own version of a template
  theme/themes/<name>/append/      optional: added to the end of a shared template
  theme/themes/<name>/hooks/       optional: `enter` and `leave`, run on a real switch
                                   (never on apply or render) and `enter` at login
  base = "<other>" in theme.toml   optional: build on another theme. Its palette, templates,
                                   appends and hooks apply first, and this theme only
                                   holds what it adds or changes (root-agentic on root)
  theme/generators/                files built in code (the GTK theme from Adwaita)
  theme/current -> build/<name>-…  what the apps read (git-ignored, rendered here)

The apps never see the templates. Each config in the repo points at theme/current,
either with an include line (foot, tmux, zathura, mpv, hyprlock, nvim, Hyprland)
or because the config file itself is a symlink into it (btop, cava, yazi, …).
Switching renders everything once and swaps one symlink, so nothing runs between
switches and tracked files never change.
"""

import importlib.util
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from types import SimpleNamespace

sys.dont_write_bytecode = True  # no __pycache__ in theme/generators/

REPO = Path(__file__).resolve().parents[3]
ROOT = REPO / "theme"
THEMES = ROOT / "themes"
TEMPLATES = ROOT / "templates"
GENERATORS = ROOT / "generators"
BUILD = ROOT / "build"
CURRENT = ROOT / "current"
HOME = Path.home()

QUIET = False


def say(msg):
    if not QUIET:
        print(msg)


# --- Colours ------------------------------------------------------------------


class Color:
    """An sRGB colour with an 8-bit alpha. str() gives #rrggbb (#rrggbbaa if translucent)."""

    def __init__(self, r, g, b, a=255):
        self.r, self.g, self.b, self.a8 = (max(0, min(255, round(v))) for v in (r, g, b, a))

    @classmethod
    def parse(cls, text):
        h = text.strip().lstrip("#")
        if not re.fullmatch(r"[0-9a-fA-F]{6}([0-9a-fA-F]{2})?", h):
            raise ValueError(f"not a colour: {text!r} (use #rrggbb or #rrggbbaa)")
        v = [int(h[i:i + 2], 16) for i in range(0, len(h), 2)]
        return cls(*v)

    def __str__(self):
        return "#" + (self.hex if self.a8 == 255 else self.hexa)

    def __repr__(self):
        return f"Color({self})"

    # Formats, for the different config syntaxes.
    @property
    def hex(self):            # rrggbb       (foot, imv, spicetify)
        return f"{self.r:02x}{self.g:02x}{self.b:02x}"

    @property
    def hexa(self):           # rrggbbaa     (Hyprland rgba(...))
        return self.hex + f"{self.a8:02x}"

    @property
    def argb(self):           # #aarrggbb    (Qt)
        return f"#{self.a8:02x}{self.hex}"

    @property
    def dec(self):            # r, g, b      (hyprlock rgb(...), kdeglobals)
        return f"{self.r}, {self.g}, {self.b}"

    @property
    def csv(self):            # r,g,b        (CSS-ish rgba(...) without spaces)
        return f"{self.r},{self.g},{self.b}"

    @property
    def luma(self):
        return 0.2126 * self.r + 0.7152 * self.g + 0.0722 * self.b

    def a(self, byte):
        """The same colour with alpha as a byte, 0x00-0xff (exact, for Hyprland's rgba(rrggbbaa))."""
        return Color(self.r, self.g, self.b, byte)

    def alpha(self, f):
        """The same colour with alpha as a fraction, 0-1."""
        return Color(self.r, self.g, self.b, f * 255)

    def mix(self, other, t):
        """t of the way from this colour to other (0 = this, 1 = other)."""
        return Color(*(s + (o - s) * t for s, o in
                       zip((self.r, self.g, self.b, self.a8), (other.r, other.g, other.b, other.a8))))


# --- Themes -------------------------------------------------------------------


def theme_names():
    return sorted(p.parent.name for p in THEMES.glob("*/theme.toml"))


def current_name():
    try:
        return Path(os.readlink(CURRENT)).name.rsplit("-", 1)[0]
    except OSError:
        return None


def expand(value):
    return str(Path(value).expanduser()) if isinstance(value, str) and value.startswith("~") else value


def read_toml(name):
    path = THEMES / name / "theme.toml"
    if not path.is_file():
        sys.exit(f"theme: no theme {name!r} (there are: {', '.join(theme_names()) or 'none'})")
    with path.open("rb") as f:
        return tomllib.load(f)


def chain(name):
    """NAME and the themes it builds on, the base first. A theme with `base = "root"` in its
    theme.toml takes everything from root and only holds what it adds or changes."""
    names = [name]
    while base := read_toml(names[0]).get("base"):
        if base in names:
            sys.exit(f"theme: {name}: base goes in a circle ({' -> '.join(reversed(names))} -> {base})")
        names.insert(0, base)
    return names


def load(name):
    path = THEMES / name / "theme.toml"
    data = {}
    for n in chain(name):
        for key, value in read_toml(n).items():
            # Tables ([colors], [look], ...) are merged key by key, plain values replaced.
            data[key] = {**data.get(key, {}), **value} if isinstance(value, dict) else value

    def colours(table, where):
        out = {}
        for key, value in table.items():
            try:
                out[key] = Color.parse(value)
            except ValueError as e:
                sys.exit(f"theme: {path}: [{where}] {key}: {e}")
        return out

    colors = colours(data.get("colors", {}), "colors")
    for key in ("bg", "fg", "text", "accent", "on_accent", "love", "gold", "iris"):
        if key not in colors:
            sys.exit(f"theme: {path}: [colors] needs {key}")
    bg, fg = colors["bg"], colors["fg"]

    def tone(level):
        """A step from bg (0x00) to fg (0xff). In root, tone(0x55) is #555555."""
        return bg.mix(fg, level / 255)

    def ns(table):
        return SimpleNamespace(**{k: expand(v) for k, v in table.items()})

    mode = data.get("mode", "dark")
    return {
        **colors,
        "theme": name,
        "description": data.get("description", ""),
        "mode": mode,
        "dark": mode == "dark",
        "term": SimpleNamespace(**colours(data.get("terminal", {}), "terminal")),
        "font": ns(data.get("fonts", {})),
        "look": ns(data.get("look", {})),
        "asset": ns(data.get("assets", {})),
        "home": str(HOME),
        "tone": tone,
        "mix": lambda a, b, t: a.mix(b, t),
        "Color": Color.parse,
        "lua": lambda v: "true" if v is True else "false" if v is False else repr(v).replace("'", '"'),
    }


# --- Rendering ----------------------------------------------------------------

EXPR = re.compile(r"\{\{(.*?)\}\}")


def render_text(text, ctx, where):
    def sub(m):
        try:
            return str(eval(m.group(1), {"__builtins__": {}}, ctx))  # noqa: S307 -- our own templates
        except Exception as e:  # noqa: BLE001
            line = text.count("\n", 0, m.start()) + 1
            sys.exit(f"theme: {where}:{line}: {{{{{m.group(1)}}}}}: {type(e).__name__}: {e}")
    return EXPR.sub(sub, text)


def templates(name):
    """Relative path -> source file, the theme's own templates winning over its base's and
    those over the shared ones."""
    found = {}
    for base in (TEMPLATES, *(THEMES / n / "templates" for n in chain(name))):
        for p in sorted(base.rglob("*")):
            if p.is_file():
                found[p.relative_to(base)] = p
    return found


def generator(stem):
    spec = importlib.util.spec_from_file_location(f"theme_gen_{stem}", GENERATORS / f"{stem}.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def render(name, out):
    ctx = load(name)
    out = Path(out)
    appends = [THEMES / n / "append" for n in chain(name)]
    for rel, src in templates(name).items():
        dest = out / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        text = render_text(src.read_text(), ctx, src.relative_to(REPO))
        # themes/<name>/append/<rel>: added to the end of the shared template's output,
        # for a theme that only adds to a long file (CSS) instead of copying it.
        for extra in (a / rel for a in appends):
            if extra.is_file():
                text += render_text(extra.read_text(), ctx, extra.relative_to(REPO))
        dest.write_text(text)
        shutil.copymode(src, dest)
    # The GTK theme is built from the installed GTK's own Adwaita, unless the theme
    # names an installed GTK theme instead.
    if not getattr(ctx["asset"], "gtk_theme", ""):
        generator("gtk").build(ctx, out / "gtk")
    return ctx


def switch(name):
    """Render NAME into a fresh build dir and point theme/current at it in one rename."""
    BUILD.mkdir(exist_ok=True)
    dest = BUILD / f"{name}-{time.strftime('%Y%m%d%H%M%S')}{time.time_ns() % 1000:03d}"
    tmp = dest.with_name(dest.name + ".tmp")
    shutil.rmtree(tmp, ignore_errors=True)
    try:
        ctx = render(name, tmp)
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    tmp.rename(dest)
    link = CURRENT.with_name(".current.tmp")
    link.unlink(missing_ok=True)
    link.symlink_to(dest.relative_to(ROOT))
    link.replace(CURRENT)
    for old in BUILD.iterdir():
        if old != dest:
            shutil.rmtree(old, ignore_errors=True)
    return ctx


# --- Telling the running programs ---------------------------------------------


def run(*cmd, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=30, **kw).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def have(cmd):
    return shutil.which(cmd) is not None


def running(proc):
    return run("pgrep", "-x", proc)


def reload(ctx, changed, wallpaper=True):
    """Make running programs pick up theme/current. Every step is best effort."""
    done, later = [], []
    a = ctx["asset"]
    gtk_theme = getattr(a, "gtk_theme", "") or "Current"

    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and have("hyprctl"):
        if run("hyprctl", "reload"):
            done.append("Hyprland")
        cursor = getattr(a, "cursor_theme", "")
        if cursor:
            run("hyprctl", "setcursor", cursor, str(getattr(a, "cursor_size", 24)))
        picture = getattr(a, "wallpaper", "")
        if changed and wallpaper and picture and Path(picture).is_file():
            # A new theme brings its wallpaper. `theme apply` keeps the one you picked, and
            # so does a switch between themes that share one (root and root-agentic).
            if run("hyprctl", "-q", "hyprpaper", "wallpaper", f",{picture}"):
                (HOME / ".cache/wallpaper").mkdir(parents=True, exist_ok=True)
                (HOME / ".cache/wallpaper/last").write_text(picture + "\n")
                done.append("wallpaper")

    if have("qs") and run("qs", "ipc", "call", "theme", "reload"):
        done.append("shell")

    if have("gsettings"):
        iface = "org.gnome.desktop.interface"
        # Setting a different name first makes running GTK apps load the new CSS.
        run("gsettings", "set", iface, "gtk-theme", "Adwaita")
        run("gsettings", "set", iface, "gtk-theme", gtk_theme)
        run("gsettings", "set", iface, "color-scheme", "prefer-dark" if ctx["dark"] else "prefer-light")
        for key, value in (("icon-theme", getattr(a, "icon_theme", "")),
                           ("cursor-theme", getattr(a, "cursor_theme", "")),
                           ("cursor-size", str(getattr(a, "cursor_size", ""))),
                           ("font-name", f"{getattr(ctx['font'], 'sans', '')} 11"),
                           ("monospace-font-name", f"{getattr(ctx['font'], 'mono', '')} 11")):
            if value.strip():
                run("gsettings", "set", iface, key, value)
        done.append("GTK")

    if have("tmux") and run("tmux", "source-file", str(HOME / ".tmux.conf")):
        done.append("tmux")

    if changed and have("spicetify"):
        cfg = subprocess.run(["spicetify", "-c"], capture_output=True, text=True).stdout.strip()
        text = Path(cfg).read_text() if cfg and Path(cfg).is_file() else ""
        # -n: spicetify would restart Spotify without the adblocker (spotify-adblock).
        if re.search(r"^current_theme\s*=\s*Ziro\s*$", text, re.M) and run("spicetify", "refresh", "-n", "-q"):
            later.append("Spotify")

    for proc, label in (("vesktop", "Discord"), ("foot", "open terminals"), ("btop", "btop"),
                        ("zathura", "zathura"), ("yazi", "yazi"), ("nvim", "nvim")):
        if running(proc):
            later.append(label)
    later.append("Firefox (its chrome, userChrome.css)")
    return done, later


# --- Commands -----------------------------------------------------------------


def hook(name, which):
    """Run themes/NAME/hooks/WHICH if it exists, and the same hook of the themes NAME builds
    on: on enter the base first, on leave the base last. A failing hook never stops a switch."""
    if not (name and (THEMES / name / "theme.toml").is_file()):
        return
    names = chain(name)
    for n in names if which == "enter" else reversed(names):
        path = THEMES / n / "hooks" / which
        if not os.access(path, os.X_OK):
            continue
        env = {**os.environ, "THEME": name, "THEME_DIR": str(THEMES / n), "THEME_CURRENT": str(CURRENT)}
        try:
            r = subprocess.run([str(path)], env=env, capture_output=True, text=True, timeout=30)
            if r.returncode != 0:
                say(f"  {n} {which} hook failed ({r.returncode}): {(r.stderr or r.stdout).strip()[-300:]}")
            else:
                say(f"  {n} {which} hook ran")
        except (OSError, subprocess.TimeoutExpired) as e:
            say(f"  {n} {which} hook failed: {e}")


def cmd_list():
    cur = current_name()
    print(f"current: {cur or 'none rendered yet (run: theme set root)'}")
    for n in theme_names():
        with (THEMES / n / "theme.toml").open("rb") as f:
            desc = tomllib.load(f).get("description", "")
        print(f"  {'*' if n == cur else ' '} {n:<14} {desc}")


def cmd_set(name, changed=True):
    old = current_name()
    keep_wallpaper = False
    if changed and old and old != name and (THEMES / name / "theme.toml").is_file():
        if (THEMES / old / "theme.toml").is_file():
            keep_wallpaper = getattr(load(old)["asset"], "wallpaper", "") == getattr(load(name)["asset"], "wallpaper", None)
        hook(old, "leave")
    ctx = switch(name)
    say(f"theme: {name} rendered into {os.readlink(CURRENT)}")
    done, later = reload(ctx, changed, wallpaper=not keep_wallpaper)
    if done:
        say("  reloaded: " + ", ".join(done))
    if later:
        say("  next start: " + ", ".join(later))
    if changed:
        hook(name, "enter")


# --- Previews -----------------------------------------------------------------
# `theme preview NAME OUT.png` composes a mock desktop from a theme's real, rendered
# values (quickshell.json, hypr.lua, foot.ini and its wallpaper) as SVG and turns it
# into a PNG with resvg. Nothing on the real screen is ever captured.

PREVIEW_DIR = HOME / ".cache" / "theme-previews"
PREVIEW_W, PREVIEW_H = 1440, 900   # the logical screen the mock desktop is drawn on
PREVIEW_PX = 960                   # width of the PNG


def esc(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def rgba(text):
    """'rgba(rrggbbaa)' or 'rrggbb' -> ('#rrggbb', opacity)."""
    h = re.sub(r"^rgba\(|\)$", "", text.strip().lstrip("#"))
    return "#" + h[:6], (int(h[6:8], 16) / 255 if len(h) >= 8 else 1.0)


def preview_values(d):
    """Read what the preview needs out of a rendered theme directory."""
    d = Path(d)
    q = __import__("json").loads((d / "quickshell.json").read_text())
    lua = (d / "hypr.lua").read_text()
    foot = (d / "foot.ini").read_text()

    def lua_num(key):
        return float(re.search(rf"^\s*{key}\s*=\s*([\d.]+)", lua, re.M).group(1))

    def lua_cols(key):
        m = re.search(rf"^\s*{key}\s*=\s*(\{{[^}}]*\}}|\"[^\"]*\")", lua, re.M)
        return re.findall(r"rgba\([0-9a-fA-F]+\)", m.group(1)) if m else []

    def ini(key):
        m = re.search(rf"^{key}=(.*)$", foot, re.M)
        return m.group(1).strip() if m else ""

    font = re.match(r"(.*?):size=([\d.]+)", ini("font"))
    wp = re.search(r'^\s*wallpaper\s*=\s*"([^"]*)"', lua, re.M)
    return {
        "q": q,
        "active": lua_cols("active_border"), "inactive": lua_cols("inactive_border"),
        "glow": lua_cols("glow"), "shadow": lua_cols("shadow"),
        "rounding": lua_num("rounding"), "gaps_in": lua_num("gaps_in"), "gaps_out": lua_num("gaps_out"),
        "border": lua_num("border_size"), "active_opacity": lua_num("active_opacity"),
        "inactive_opacity": lua_num("inactive_opacity"),
        "wallpaper": wp.group(1) if wp else "",
        "mono": font.group(1) if font else "monospace", "mono_size": float(font.group(2)) if font else 12,
        "alpha": float(ini("alpha") or 1), "tbg": "#" + ini("background"), "tfg": "#" + ini("foreground"),
        "pal": ["#" + ini(f"regular{i}") for i in range(8)] + ["#" + ini(f"bright{i}") for i in range(8)],
    }


def preview_svg(name, desc, v):
    q = v["q"]
    W, H = PREVIEW_W, PREVIEW_H
    out = []
    add = out.append
    defs = []
    bar_h, gap, side = q["barHeight"], q["gap"], 15
    r, rs = q["radius"], q["radiusSmall"]
    bg, fg, accent, inverse = q["bg"], q["fg"], q["accent"], q["inverse"]
    font = esc(q["font"])

    add(f'<rect width="{W}" height="{H}" fill="{bg}"/>')
    if v["wallpaper"] and Path(v["wallpaper"]).is_file():
        add(f'<image href="{esc(v["wallpaper"])}" x="0" y="0" width="{W}" height="{H}" preserveAspectRatio="xMidYMid slice"/>')

    # Bar: three islands (workspaces, clock, status), translucent bg, fg-tinted border.
    def island(x, w, content):
        add(f'<rect x="{x}" y="{gap}" width="{w}" height="{bar_h}" rx="{r}" fill="{bg}" fill-opacity="0.85" '
            f'stroke="{fg}" stroke-opacity="0.18"/>')
        add(content)

    cy = gap + bar_h / 2
    chip = bar_h - 14
    ws = []
    for i in range(5):
        x = side + 8 + i * (chip + 6)
        if i == 1:
            ws.append(f'<rect x="{x}" y="{cy - chip / 2}" width="{chip}" height="{chip}" rx="{rs}" fill="{accent}"/>'
                      f'<rect x="{x + chip * .28}" y="{cy - chip * .22}" width="{chip * .44}" height="{chip * .44}" rx="2" fill="{inverse}"/>')
        elif i < 4:
            ws.append(f'<rect x="{x + chip * .28}" y="{cy - chip * .22}" width="{chip * .44}" height="{chip * .44}" rx="2" fill="{fg}" fill-opacity="0.45"/>')
        else:
            ws.append(f'<circle cx="{x + chip / 2}" cy="{cy}" r="2.5" fill="{fg}" fill-opacity="0.3"/>')
    island(side, 5 * (chip + 6) + 10, "".join(ws))

    fs = q["fontSize"]
    cw = 190
    island((W - cw) / 2, cw,
           f'<text x="{W / 2}" y="{cy}" dominant-baseline="central" text-anchor="middle" font-family="{font}" font-size="{fs * 1.25}" fill="{fg}">'
           f'12:34<tspan dx="14" fill="{fg}" fill-opacity="0.55" font-size="{fs}">Wed 18</tspan></text>')

    tray_w = 120
    status_w = 250
    x_tray = W - side - tray_w
    x_status = x_tray - 8 - status_w
    st = [f'<text x="{x_status + 16}" y="{cy}" dominant-baseline="central" font-family="{font}" font-size="{fs}" fill="{fg}">87%</text>',
          f'<text x="{x_status + 62}" y="{cy}" dominant-baseline="central" font-family="{font}" font-size="{fs}" fill="{fg}" fill-opacity="0.55">vol 60</text>']
    bx = x_status + 140
    st.append(f'<rect x="{bx}" y="{cy - 3}" width="90" height="6" rx="3" fill="{fg}" fill-opacity="0.16"/>'
              f'<rect x="{bx}" y="{cy - 3}" width="52" height="6" rx="3" fill="{accent}"/>')
    island(x_status, status_w, "".join(st))
    tr = "".join(f'<circle cx="{x_tray + 24 + i * 24}" cy="{cy}" r="7" fill="{fg}" fill-opacity="{0.55 - i * 0.1}"/>' for i in range(4))
    island(x_tray, tray_w, tr)

    # Windows: tiled under the bar with gaps_out at the edges and 2 * gaps_in between.
    go, gi, bw = v["gaps_out"], v["gaps_in"], v["border"]
    top = gap + bar_h + go
    x0, x1, y1 = go, W - go, H - go
    split = x0 + (x1 - x0 - 2 * gi) * 0.56
    tiles = [(x0, top, split - x0, y1 - top, True), (split + 2 * gi, top, x1 - split - 2 * gi, y1 - top, False)]

    fpx = v["mono_size"] * 1.33
    lh = fpx * 1.3
    pal, tfg = v["pal"], v["tfg"]

    def colour_stops(cols):
        return "".join(f'<stop offset="{i / max(1, len(cols) - 1)}" stop-color="{rgba(c)[0]}" stop-opacity="{rgba(c)[1]}"/>'
                       for i, c in enumerate(cols))

    if v["active"]:
        defs.append(f'<linearGradient id="act" gradientUnits="objectBoundingBox" x1="0" y1="0" x2="1" y2="1">{colour_stops(v["active"])}</linearGradient>')
    defs.append('<filter id="blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="14"/></filter>')

    def term(x, y, w, h, active, lines):
        n = f"w{int(x)}"
        defs.append(f'<clipPath id="{n}"><rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{v["rounding"]}"/></clipPath>')
        if active and v["glow"]:
            c, o = rgba(v["glow"][0])
            if o > 0:
                add(f'<rect x="{x - 4}" y="{y - 4}" width="{w + 8}" height="{h + 8}" rx="{v["rounding"] + 4}" fill="{c}" fill-opacity="{min(1, o * 2)}" filter="url(#blur)"/>')
        if v["shadow"]:
            c, o = rgba(v["shadow"][0])
            add(f'<rect x="{x}" y="{y + 6}" width="{w}" height="{h}" rx="{v["rounding"]}" fill="{c}" fill-opacity="{o * 0.8}" filter="url(#blur)"/>')
        op = v["active_opacity"] if active else v["inactive_opacity"]
        add(f'<g opacity="{op}"><rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{v["rounding"]}" fill="{v["tbg"]}" fill-opacity="{v["alpha"]}"/>'
            f'<g clip-path="url(#{n})">')
        ty = y + 22 + fpx
        for line in lines:
            add(f'<text x="{x + 20}" y="{ty}" xml:space="preserve" font-family="{esc(v["mono"])}" font-size="{fpx}" fill="{tfg}">{line}</text>')
            ty += lh
        add('</g></g>')
        if active and v["active"]:
            stroke = 'url(#act)'
            add(f'<rect x="{x - bw / 2}" y="{y - bw / 2}" width="{w + bw}" height="{h + bw}" rx="{v["rounding"] + bw / 2}" '
                f'fill="none" stroke="{stroke}" stroke-width="{bw}"/>')
        elif v["inactive"]:
            c, o = rgba(v["inactive"][0])
            add(f'<rect x="{x - bw / 2}" y="{y - bw / 2}" width="{w + bw}" height="{h + bw}" rx="{v["rounding"] + bw / 2}" '
                f'fill="none" stroke="{c}" stroke-opacity="{o}" stroke-width="{bw}"/>')

    def c(i, text):
        return f'<tspan fill="{pal[i]}">{esc(text)}</tspan>'

    def prompt(cmd):
        return c(2, "user@host") + c(4, " ~") + c(5, " $ ") + esc(cmd)

    term(*tiles[0][:4], True, [
        prompt("ls"),
        c(4, "Documents  Projects  ") + c(12, "notes.md  ") + c(2, "run.sh"),
        "",
        prompt("git status -s"),
        c(1, " M ") + "src/main.rs",
        c(2, "A  ") + "README.md",
        c(3, "?? ") + "todo.txt",
        "",
        prompt("make test"),
        c(8, "running 12 tests"),
        c(2, "ok") + " parse, render, save",
        c(3, "warn") + " slow test: sync",
        c(1, "error") + " 1 failed: login",
        "",
        prompt("") + f'<tspan fill="{pal[5]}">█</tspan>',
    ])
    t2 = tiles[1]
    sw = 26
    px, py = t2[0] + 20, t2[1] + t2[3] - 22 - 2 * sw
    term(*t2[:4], False, [
        c(5, "user") + "@" + c(5, "host"),
        "-" * 14,
        c(5, "OS    ") + "Arch Linux",
        c(5, "WM    ") + "Hyprland",
        c(5, "Shell ") + "zsh",
        c(5, "Theme ") + esc(name),
    ])
    for row in range(2):
        for i in range(8):
            add(f'<rect x="{px + i * sw}" y="{py + row * sw}" width="{sw}" height="{sw}" fill="{pal[row * 8 + i]}" '
                f'opacity="{v["inactive_opacity"]}"/>')

    svg = (f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">'
           f'<defs>{"".join(defs)}</defs>{"".join(out)}</svg>')
    return svg


def preview_key(name):
    """Changes whenever the theme, a template, its wallpaper or the preview code changes."""
    import hashlib
    h = hashlib.sha256()
    for n in reversed(chain(name)):
        h.update((THEMES / n / "theme.toml").read_bytes())
    for rel, src in sorted(templates(name).items()):
        h.update(str(rel).encode())
        h.update(src.read_bytes())
    try:
        wp = Path(load(name)["asset"].wallpaper)
        st = wp.stat()
        h.update(f"{wp}{st.st_size}{st.st_mtime_ns}".encode())
    except (OSError, AttributeError):
        h.update(b"no wallpaper")
    import inspect
    for fn in (preview_svg, preview_values, esc, rgba):
        h.update(inspect.getsource(fn).encode())
    h.update(f"{PREVIEW_W}{PREVIEW_H}{PREVIEW_PX}".encode())
    return h.hexdigest()[:12]


def preview_path(name):
    return PREVIEW_DIR / f"{name}-{preview_key(name)}.png"


def make_preview(name, out):
    """Render NAME into a temp dir, compose the mock desktop and write it to OUT (a PNG)."""
    import tempfile
    if not have("resvg"):
        sys.exit("theme: preview needs resvg (pacman: resvg)")
    out = Path(out)
    out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="theme-preview-") as tmp:
        ctx = render(name, Path(tmp) / "r")
        svg = Path(tmp) / "preview.svg"
        svg.write_text(preview_svg(name, ctx["description"], preview_values(Path(tmp) / "r")))
        part = out.with_name(out.name + ".part")
        r = subprocess.run(["resvg", "--resources-dir", "/", "-w", str(PREVIEW_PX), str(svg), str(part)],
                           capture_output=True, text=True)
        if r.returncode != 0:
            part.unlink(missing_ok=True)
            sys.exit(f"theme: resvg failed: {r.stderr.strip()[-300:]}")
        part.replace(out)


def cmd_previews(info):
    """`theme previews`: make every missing cached preview. `theme previews --info`: JSON
    for the launcher (name, description, current, preview path, whether it exists)."""
    import json
    cur = current_name()
    items = []
    for n in theme_names():
        with (THEMES / n / "theme.toml").open("rb") as f:
            desc = tomllib.load(f).get("description", "")
        p = preview_path(n)
        if not info and not p.is_file():
            make_preview(n, p)
            for old in PREVIEW_DIR.glob(f"{n}-*.png"):
                if old != p:
                    old.unlink(missing_ok=True)
        items.append({"name": n, "description": desc, "current": n == cur, "preview": str(p), "ready": p.is_file()})
    if info:
        print(json.dumps(items))


def main(argv):
    global QUIET
    if "--quiet" in argv or "-q" in argv:
        QUIET = True
        argv = [a for a in argv if a not in ("--quiet", "-q")]
    if not argv or argv[0] in ("list", "ls"):
        return cmd_list()
    cmd, args = argv[0], argv[1:]
    if cmd == "set" and len(args) == 1:
        return cmd_set(args[0], changed=args[0] != current_name())
    if cmd == "apply" and not args:
        return cmd_set(current_name() or "root", changed=current_name() is None)
    if cmd == "hook" and len(args) == 1 and args[0] in ("enter", "leave"):
        return hook(current_name(), args[0])
    if cmd == "render" and len(args) == 2:
        out = Path(args[1])
        if out.exists() and any(out.iterdir()):
            sys.exit(f"theme: {out} is not empty")
        render(args[0], out)
        return say(f"theme: {args[0]} rendered into {out}")
    if cmd == "preview" and len(args) == 2:
        make_preview(args[0], args[1])
        return say(f"theme: preview of {args[0]} written to {args[1]}")
    if cmd == "previews" and args in ([], ["--info"]):
        return cmd_previews(bool(args))
    if cmd in ("-h", "--help", "help"):
        return print(__doc__.strip())
    sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
