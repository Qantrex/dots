#!/usr/bin/env bash
# The side panel for the main Claude chat and its threads (`agentic`, `thread`).
#   dock toggle          SUPER+SHIFT+A: show the panel with the main chat; from a thread back to the main
#                        chat; from the main chat hide it
#   dock show [--focus] [target]
#                        switch tmux session "main" (the terminal I work in, main:1) to the main chat ("main",
#                        the default), a thread by name, a tmux pane (%12) or --first (the session that has
#                        waited longest), and say how to get back (Alt+1). --focus also brings that terminal to
#                        the front (clicks on notifications and the bar). No terminal shows "main": the panel.
#   dock panel [target]  show it in the side panel instead (what `dock show` did before 2026-11-23)
#   dock term [target]   the same, but always as the real Claude Code terminal (theme root-agentic: Ctrl+T
#                        in the shell's panel)
#   dock hide            hide it
#   dock ensure          start the panel window hidden, so it opens instantly later
#   dock close           close the panel window (agentic off)
#   dock status          one line: shown, hidden or closed, and what it shows
# The panel is a terminal on the special workspace "agentic" (right edge, full height, about 40 % wide;
# window rule "agentic-panel" in rules.lua). It shows tmux session "panel", grouped with session "main":
# the same windows, but its own current window, so the terminals on your workspaces keep what they show.
# tmux sizes a window to the client used last, and Claude Code redraws cleanly at the new width.
#
# In the theme root-agentic the Quickshell shell has its own panel in the same place (agentic/Panel.qml,
# services/Agentic.qml). While it is on, toggle and panel open that one for the main chat and the threads,
# and the terminal stays one `dock term` away. Every other theme and the desktop PC work as described above.

set -u
session=main
panel=panel
# The desktop docks the chat on the side screen's workspace 14 (rules.lua, workspaces.lua) instead of
# a special workspace: there, "shown" means focused, and hiding goes back to where you were.
docked=""; [[ $(cat /etc/hostname 2>/dev/null) == bauarch-pc ]] && docked=14

window_open() { hyprctl clients -j | jq -e 'any(.[]; .class == "agentic-panel")' >/dev/null; }
if [[ -n $docked ]]; then
    shown() { [[ $(hyprctl activewindow -j | jq -r .class) == agentic-panel ]]; }
    toggle() { if shown; then hyprctl dispatch 'hl.dsp.focus({ workspace = "previous" })' >/dev/null; fi; }
else
    shown() { hyprctl monitors -j | jq -e 'any(.[]; .specialWorkspace.name == "special:agentic")' >/dev/null; }
    toggle() { hyprctl dispatch 'hl.dsp.workspace.toggle_special("agentic")' >/dev/null; }
fi
focus() { hyprctl dispatch 'hl.dsp.focus({ window = "class:^(agentic-panel)$" })' >/dev/null; }

# The shell's own panel: "hidden" or "shown <tab>" while the theme has one, else empty (also when no
# shell runs, or an older one that doesn't know the call).
native=$(qs ipc call agentic status 2>/dev/null)
[[ $native == hidden || $native == "shown "* ]] || native=""
panel_call() { qs ipc call agentic "$@" >/dev/null 2>&1; }

ensure() {
    tmux has-session -t "=$session" 2>/dev/null || { echo "No tmux session '$session' (agentic on)." >&2; return 1; }
    if window_open && tmux has-session -t "=$panel" 2>/dev/null; then status_line; return 0; fi
    hyprctl clients -j | jq -r '.[] | select(.class == "agentic-panel") | .pid' | xargs -r kill
    tmux kill-session -t "=$panel" 2>/dev/null
    # destroy-unattached: the grouped session goes away with the window, and new terminals attach to
    # "main" by name (.zshrc), never to this one.
    setsid -f foot --app-id=agentic-panel --title="claude main" \
        tmux new-session -s "$panel" -t "$session" \; set-option destroy-unattached on \; \
        select-window -t "$panel:$(window_of main)" >/dev/null 2>&1
    for _ in $(seq 1 50); do window_open && tmux has-session -t "=$panel" 2>/dev/null && { status_line; return 0; }; sleep 0.1; done
    return 1
}

# A second status line in the panel: every thread, its state, since when and its last action, written by the
# session hook (code only); tmux redraws it with its normal status interval.
status_line() {
    tmux set-option -t "$panel" status 2
    tmux set-option -t "$panel" 'status-format[1]' \
        "#[align=left,fg=colour245] #(cat \"${XDG_CACHE_HOME:-$HOME/.cache}/agentic-threads.line\" 2>/dev/null || echo 'no threads')"
}

# The window called NAME in the main session. tmux names a plain shell after its folder (automatic-rename),
# so a second window can carry the same name: the one named on purpose wins.
window_of() {
    tmux list-windows -t "=$session" -F '#{window_name} #{automatic-rename} #{window_id}' 2>/dev/null |
        awk -v n="$1" '$1 == n { if ($2 == "0") { print $3; found = 1; exit } if (!first) first = $3 }
                       END { if (!found && first) print first }'
}

# --first: the session that has waited longest (bar flag, session-track.sh in claude-config).
first_waiting() {
    local pane
    pane=$(jq -r '.[0].pane // empty' "${XDG_CACHE_HOME:-$HOME/.cache}/claude-waiting.json" 2>/dev/null)
    echo "${pane:-main}"
}

# What the shell's panel can show: the main chat and the threads (a window in tmux "main" with a state
# file). Prints that name for main, a thread, a pane (%12) or --first; nothing for any other session.
native_target() {
    local name=${1:-main}
    [[ $name == --first ]] && name=$(first_waiting)
    if [[ $name == %* ]]; then
        name=$(tmux list-panes -s -t "=$session" -F '#{pane_id} #{window_name}' 2>/dev/null |
            awk -v pane="$name" '$1 == pane { print $2; exit }')
    fi
    [[ $name == main || ( -n $name && -f "${XDG_DATA_HOME:-$HOME/.local/share}/agentic/threads/$name.md" ) ]] || return 1
    tmux list-windows -t "=$session" -F '#{window_name}' 2>/dev/null | grep -qxF -- "$name" && echo "$name"
}

select_target() {
    local name=${1:-main} win
    [[ $name == --first ]] && name=$(first_waiting)
    if [[ $name == %* ]]; then
        # A tmux pane: show its window if it belongs to the main session's group.
        win=$(tmux display -p -t "$name" '#{window_id}' 2>/dev/null)
        [[ -n $win ]] && tmux select-window -t "$panel:$win" 2>/dev/null && { tmux select-pane -t "$name"; return 0; }
        notify-send -a Claude "Claude" "That session isn't in the main tmux session."; return 1
    fi
    win=$(window_of "$name")
    [[ -n $win ]] && tmux select-window -t "$panel:$win" 2>/dev/null || {
        notify-send -a Claude "Claude" "No thread called '$name' is running."; return 1; }
}

# The terminal panel with that session, in front of the shell's panel if there is one.
show_terminal() {
    [[ -n $native ]] && panel_call hide
    ensure || return 1
    select_target "${1:-main}" || return 1
    shown || toggle
    focus
}

case ${1:-toggle} in
toggle)
    # Showing a thread: back to the main chat. Showing the main chat: hide. Hidden: show it again (in the
    # shell's panel: the workspace's own thread first).
    if [[ -n $native ]]; then
        # The same three steps in the shell's panel; a terminal panel that is up only goes away.
        if shown; then toggle
        # Hidden: the thread of the workspace I'm on (a pin, else its folders), else the main chat.
        elif [[ $native == hidden ]]; then panel_call openHere
        elif [[ $native == "shown main" ]]; then panel_call hide
        else panel_call open main
        fi
        exit 0
    fi
    if shown; then
        if [[ $(tmux display -p -t "$panel:" '#{window_name}' 2>/dev/null) != main ]]; then
            select_target main; focus
        else
            toggle
        fi
        exit 0
    fi
    ensure || exit 1
    # Opening always shows the main chat; threads are shown on purpose (dock show <name>).
    select_target main
    toggle; focus ;;
show)
    # The owner works in tmux session "main" in a terminal, not in the panel (2026-11-23): switch that
    # session's window. The panel's own session ("panel") keeps its window; nothing opens by itself.
    shift
    focus_term=""; [[ ${1:-} == --focus ]] && { focus_term=1; shift; }
    name=${1:-main}
    [[ $name == --first ]] && name=$(first_waiting)
    sess=$session
    if [[ $name == %* ]]; then
        # A pane: its window in tmux "main" (the panel's grouped session counts as main), or in whatever
        # other tmux session it runs in (a plain `claude` in a terminal of its own).
        win=$(tmux display -p -t "$name" '#{window_id}' 2>/dev/null)
        sess=$(tmux display -p -t "$name" '#{session_name}' 2>/dev/null)
        [[ $sess == "$panel" ]] && sess=$session
    else
        win=$(window_of "$name")
    fi
    if [[ -z $win ]]; then
        echo "No window '$name' in tmux session '$session' (thread list, thread resume $name)." >&2
        [[ -n $focus_term ]] && notify-send -a Claude "Claude" "No thread called '$name' is running."
        exit 1
    fi
    client=$(tmux list-clients -t "=$sess" -F '#{client_pid}' 2>/dev/null | head -1)
    if [[ -z $client ]]; then
        if [[ $sess == "$session" ]]; then
            echo "No terminal shows tmux session '$session'; showing it in the side panel (or: tmux attach -t $session)."
            exec "$0" panel "${1:-main}"
        fi
        echo "No terminal shows tmux session '$sess' (tmux attach -t $sess)." >&2
        [[ -n $focus_term ]] && notify-send -a Claude "Claude" "That session has no terminal open (tmux attach -t $sess)."
        exit 1
    fi
    # Named with its session: "panel" shares these windows, and a bare id could switch that one instead.
    tmux select-window -t "=$sess:$win"
    [[ $name == %* ]] && tmux select-pane -t "$name"
    label=$sess:$(tmux display -p -t "=$sess:$win" '#{window_index} #{window_name}')
    main_idx=$(tmux display -p -t "$(window_of main)" '#{window_index}' 2>/dev/null)
    if [[ $sess != "$session" ]]; then
        echo "tmux $label is on screen in its own terminal."
    elif [[ $(tmux display -p -t "=$sess:$win" '#{window_name}') == main ]]; then
        echo "tmux $label (the main chat) is on screen."
    else
        echo "tmux $label is on screen in your terminal. Back to the main chat: Alt+${main_idx:-1}" \
             "(or Ctrl+A l for the last window, or dock show main)."
    fi
    if [[ -n $focus_term ]]; then
        p=$client
        while [[ -n $p && $p != 1 && $p != 0 ]]; do
            [[ $(cat /proc/"$p"/comm 2>/dev/null) == foot ]] && break
            p=$(awk '/^PPid:/{print $2}' /proc/"$p"/status 2>/dev/null)
        done
        [[ -n $p && $p != 1 && $p != 0 ]] && hyprctl dispatch "hl.dsp.focus({ window = \"pid:$p\" })" >/dev/null
    fi
    exit 0 ;;
panel)
    if [[ -n $native ]] && name=$(native_target "${2:-main}"); then
        shown && toggle
        panel_call open "$name"
        exit 0
    fi
    show_terminal "${2:-main}" || exit 1 ;;
term)
    show_terminal "${2:-main}" || exit 1 ;;
hide)
    [[ -n $native ]] && panel_call hide
    shown && toggle ;;
ensure)
    ensure ;;
close)
    [[ -n $native ]] && panel_call hide
    shown && toggle
    hyprctl clients -j | jq -r '.[] | select(.class == "agentic-panel") | .pid' | xargs -r kill
    tmux kill-session -t "=$panel" 2>/dev/null ;;
status)
    if [[ -n $native ]]; then
        term="not started"; window_open && { shown && term=shown || term=hidden; }
        echo "panel: ${native/ /, showing } (the shell's panel); its terminal: $term"
        exit 0
    fi
    if ! window_open; then echo "panel: closed"; exit 0; fi
    w=$(tmux display -p -t "$panel:" '#{window_name}' 2>/dev/null)
    echo "panel: $(shown && echo shown || echo hidden), showing ${w:-?}" ;;
*)
    sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
    exit 1 ;;
esac
