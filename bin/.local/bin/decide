#!/usr/bin/env python3
"""
decide — let a coin choose between two things.

    decide <option 1> <option 2>
    decide "watch x movie" "watch y movie"

A pixel-rendered metal coin (sixel or kitty graphics, half-blocks otherwise) on
a table in the dark. One face stands for each option. You hold space to pick the
coin up and let go to throw. It flies, it is caught under a cover, and you lift
the cover yourself. Whatever it shows is what you do.

The pacing borrows from published casino software standards, as design
references only (nothing here is tested or approved by anyone):
  fair draw     one bit from the OS CSPRNG, before anything moves (GLI-19 3.3)
  no turbo      nothing shortens the toss (UKGC RTS 14E); lifting the cover
                faster is allowed, it is a reveal-all
  fresh press   holding a key never starts a toss (UKGC RTS 14D)
  no staging    the flight is the same film for either result (GLI-19 4.5.2),
                and the hold and throw change nothing (GLI-19 4.6.1)
  no flashing   at most 3 flashes a second (WCAG 2.3.1), checked by the selftest

Game logic is standard library only. numpy and PIL are optional: without numpy
the coin is drawn coarser with half-blocks. Piped, it just prints an option.
"""

import atexit
import contextlib
import fcntl
import glob
import json
import math
import mmap
import multiprocessing
import os
import re
import secrets
import select
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import time
import tty
import unicodedata

__version__ = "2.0"
SOUND_REV = 2                # bump when the sounds change: they are cached on disk

np = None                       # numpy, loaded only when a coin is drawn


def load_numpy():
    global np
    try:
        import numpy
        np = numpy
    except ImportError:
        np = None
    return np


def _worker_signals():
    """Render and audio children leave signals and the terminal to the parent."""
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTSTP, signal.SIG_IGN)
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGWINCH, signal.SIGCONT):
        signal.signal(s, signal.SIG_DFL)


# ═══ the coin renderer ═════════════════════════════════════════════════════
# The renderer decides nothing: the caller passes angle, height and reveal
# state. Sealed pixels can't depend on the face, the emblems or the winner.
ROSE = (234, 154, 151)
TILT_Y = 0.34                # same idea as the ASCII coin's constant lean
LEAN_X = -0.20               # seen slightly from above, so edge-on keeps depth
THICK = 0.13                 # half thickness, coin radius 1
CAM = 7.0                    # camera distance, mild perspective
LIGHT = (-0.38, 0.72, 0.58)
N_ANGLES = 90                # cached angles, 4 degree step, blended between
NGREY = 56                   # grey registers
NROSE = 16                   # letter registers used during the reveal
MAX_SUB_DEG = 8.0            # motion blur sub-frame spacing
SPIN_FLOOR = 0.075           # tone of a spinning coin, in linear light: darkest...
SPIN_CEIL = 0.74             # ...brightest...
SPIN_GAMMA = 0.9             # ...and the curve between
PULSE_MAX = 5.0              # selftest: brightest/dimmest spin frame. 6.0 before the
                             # spin tone. What's left is the coin going thin edge-on
SHUTTER = 0.0                # motion blur, fraction of the frame interval; off:
                             # it raised the flash count and costs the most
HEADROOM = 1.14              # canvas margin so the coin can zoom without cropping

# Per-frame effect inputs, all cheap (applied to cached sprites, no re-shading).
# To add one: give it a default here and read it in Coin.frame(). Stage passes
# them through, so callers just add a keyword.
FX = dict(
    zoom=1.0,        # camera scale about the canvas centre
    impact_y=0.0,    # downward jolt of coin and floor, in coin radii
    shadow_h=None,   # height driving the floor pool; None follows toss_y
    light=1.0,       # overall lighting intensity
    seal=0.0,        # fraction of the coin's height still covered, lifts top-down
    tone=1.0,        # uncovered face: 0 neutral engraved (squeeze), 1 true silver/black
    shutter=SHUTTER, # motion blur, fraction of the frame interval; 0 is sharp
    floor=1.0,       # brightness of the pool of light on the table
    floor_r=1.0,     # width of that pool
    spin=0.0,        # 0 true metal, 1 evened out so a spinning coin doesn't pulse
)


def edge_on_angle():
    """Angle where the coin's face is exactly edge-on to the viewer. With the
    constant lean that is about 102 degrees, not 90."""
    return math.atan2(math.cos(LEAN_X) * math.cos(TILT_Y), math.sin(LEAN_X)) % math.pi


def flight_angle(p, flight, hi=2.0, lo=0.5):
    """Spin falling linearly from hi to lo turns/s, p = t/flight in 0..1, scaled
    down slightly so it lands exactly edge-on. Never depends on the winner."""
    total = flight * (hi + lo) / 2
    edge = edge_on_angle() / (2 * math.pi)
    target = total - ((total - edge) % 0.5)
    return 2 * math.pi * flight * (hi * p - (hi - lo) / 2 * p * p) * (target / total)


