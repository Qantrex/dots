# btop: true-black monochrome. Greys and white; Rose Pine love only for the
# "hot" end of meters, so a maxed core still stands out.
theme[main_bg]="#000000"
theme[main_fg]="#d0d0d0"
theme[title]="#ffffff"
theme[hi_fg]="#ffffff"
theme[selected_bg]="#262626"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#4a4a4a"
theme[graph_text]="#888888"
theme[meter_bg]="#262626"
theme[proc_misc]="#a0a0a0"
theme[cpu_box]="#444444"
theme[mem_box]="#444444"
theme[net_box]="#444444"
theme[proc_box]="#444444"
theme[div_line]="#262626"
theme[temp_start]="#555555"
theme[temp_mid]="#a0a0a0"
theme[temp_end]="#eb6f92"
theme[cpu_start]="#555555"
theme[cpu_mid]="#a0a0a0"
theme[cpu_end]="#ffffff"
theme[free_start]="#333333"
theme[free_mid]="#666666"
theme[free_end]="#999999"
theme[cached_start]="#444444"
theme[cached_mid]="#777777"
theme[cached_end]="#aaaaaa"
theme[available_start]="#444444"
theme[available_mid]="#888888"
theme[available_end]="#cccccc"
theme[used_start]="#555555"
theme[used_mid]="#a0a0a0"
theme[used_end]="#ffffff"
theme[download_start]="#444444"
theme[download_mid]="#888888"
theme[download_end]="#ffffff"
theme[upload_start]="#444444"
theme[upload_mid]="#888888"
theme[upload_end]="#d0d0d0"
theme[process_start]="#555555"
theme[process_mid]="#a0a0a0"
theme[process_end]="#ffffff"
