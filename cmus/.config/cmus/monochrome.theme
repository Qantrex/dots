# Monochrome cmus theme: grey text on the terminal's black, selection in inverse video.
set color_cmdline_bg=default
set color_cmdline_fg=default
set color_error=lightred
set color_info=gray
set color_separator=darkgray
set color_statusline_bg=default
set color_statusline_fg=gray
set color_statusline_progress_bg=white
set color_statusline_progress_fg=black
set color_titleline_bg=default
set color_titleline_fg=white
set color_titleline_attr=bold
set color_win_bg=default
set color_win_fg=gray
set color_win_cur=white
set color_win_dir=white
set color_win_sel_bg=white
set color_win_sel_fg=black
set color_win_cur_sel_bg=white
set color_win_cur_sel_fg=black
set color_win_inactive_sel_bg=darkgray
set color_win_inactive_sel_fg=white
set color_win_inactive_cur_sel_bg=darkgray
set color_win_inactive_cur_sel_fg=white
set color_win_title_bg=default
set color_win_title_fg=white
set color_win_title_attr=bold
